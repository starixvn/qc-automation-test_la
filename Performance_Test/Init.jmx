          <stringProp name="script">var d = new Date();
var localTime = d.getTime();
var localOffset = d.getTimezoneOffset() * 60000;
var utc = localTime + localOffset;
var now = new Date(utc + (3600000*-4)); //get now via GMT -4
var prevMonthLastDate = new Date(now.getFullYear(), now.getMonth(), 0);
var prevMonthFirstDate = new Date(now.getFullYear() - (now.getMonth() &gt; 0 ? 0 : 1), (now.getMonth() - 1 + 12) % 12, 1);
var yesterday = new Date(now.setDate(now.getDate() - 1));
var Before10Day = new Date(now.setDate(now.getDate() - 10));


var formatDateComponent = function(dateComponent) {
  return (dateComponent &lt; 10 ? &apos;0&apos; : &apos;&apos;) + dateComponent;
};

var formatDate = function(date) {
  return formatDateComponent(date.getMonth() + 1) + &apos;/&apos; + formatDateComponent(date.getDate()) + &apos;/&apos; + date.getFullYear();
};

//var aaa = &quot;bc&quot;+&quot;${BaseCurrency}&quot;;
//document.write(formatDate(prevMonthFirstDate) + &apos; - &apos; + formatDate(prevMonthLastDate));
vars.put(&quot;glb_FirstDateofPrevMonth&quot;,prevMonthFirstDate.toString().substring(0, 15)); //Wed Nov 01 2017
vars.put(&quot;glb_FirstDateofPrevMonth_2&quot;,formatDate(prevMonthFirstDate)); //10/01/2017  (Reports_Licensee WIn Loss_Submit; Reports_Win Loss By Products_Submit; Reports_Turnover_Submit; Customer Reports_Customer Balance_Submit; Customer Reports_Customer Turnover_Submit)

vars.put(&quot;glb_LastDateofPrevMonth&quot;,prevMonthLastDate.toString().substring(0, 15)); //Thu Nov 30 2017
vars.put(&quot;glb_LastDateofPrevMonth_2&quot;,formatDate(prevMonthLastDate)); // (Reports_Win Loss By Products_Submit; Reports_Turnover_Submit; Customer Reports_Customer Turnover_Submit)

vars.put(&quot;glb_Yesterday&quot;,formatDate(yesterday)); //11/29/2017 (Reports_Licensee WIn Loss_Submit; Customer Reports_Customer Balance_Submit)

vars.put(&quot;glb_DateRange&quot;,formatDate(prevMonthFirstDate) + &apos; - &apos; + formatDate(yesterday)); //10/01/2017 - 11/29/2017 (Reports_Licensee WIn Loss_Submit)
vars.put(&quot;glb_DateRange_2&quot;,formatDate(prevMonthFirstDate) + &apos; - &apos; + formatDate(prevMonthLastDate));//10/01/2017 - 10/31/2017 (Reports_Win Loss By Products_Submit; Reports_Turnover_Submit; Customer Reports_Customer Balance_Submit; Customer Reports_Customer Turnover_Submit)

vars.put(&quot;glb_Before10Day&quot;,formatDate(Before10Day));//11/20/2017 (Reports_Win Loss By Bet Type_Submit)

//vars.put(&quot;LastDateofPrevMonth&quot;,prevMonthLastDate.toString().substring(0, 15));
//var i = 0;
//vars.put(&quot;ProductOptions[&quot;+i+&quot;].Status&quot;,&quot;False&quot;);
//document.write(prevMonthLastDate);

/////////////////////////////////////////////////////////////////////////////////////
//Test
var glb_PrevMonth = prevMonthFirstDate.toString().substring(4, 7)
//vars.put(&quot;glb_PrevMonth&quot;,prevMonthFirstDate.toString().substring(4, 7));
vars.put(&quot;glb_PrevMonth&quot;,glb_PrevMonth);
vars.put(&quot;glb_PrevMonthYear&quot;,glb_PrevMonth.toString() + &apos; &apos; + now.getFullYear()); 
vars.put(&quot;glb_PrevMonthYear_LicenseeWL&quot;,glb_PrevMonth.toString() + &apos;+&apos; + now.getFullYear()); 
//////////////////////
//var glb_reportDate = prevMonthFirstDate.toString().substring(4, 7)
vars.put(&quot;glb_FirstDateofCurrMonth&quot;,now.getFullYear() + &apos;.&apos; + (now.getMonth()+1) + &apos;.&apos;+ 1); 
//

var first = new Date(formatDate(prevMonthFirstDate));
var last = new Date(formatDate(prevMonthLastDate));
var FDay = first.getDate();
var FMonth = first.getMonth() + 1;
var YDay = last.getDate();
var YMonth = last.getMonth() + 1;
var Year = first.getFullYear();

//var aaa = &quot;bc&quot;+&quot;${BaseCurrency}&quot;;
//document.write(formatDate(prevMonthFirstDate) + &apos; - &apos; + formatDate(prevMonthLastDate));
vars.put(&quot;FDay&quot;,FDay); //1
vars.put(&quot;FMonth&quot;,FMonth); //1

vars.put(&quot;YDay&quot;,YDay); //31
vars.put(&quot;YMonth&quot;,YMonth); //1

vars.put(&quot;Year&quot;,Year); //2018


var Base64={_keyStr:&quot;ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/=&quot;,encode:function(e){var t=&quot;&quot;;var n,r,i,s,o,u,a;var f=0;e=Base64._utf8_encode(e);while(f&lt;e.length){n=e.charCodeAt(f++);r=e.charCodeAt(f++);i=e.charCodeAt(f++);s=n&gt;&gt;2;o=(n&amp;3)&lt;&lt;4|r&gt;&gt;4;u=(r&amp;15)&lt;&lt;2|i&gt;&gt;6;a=i&amp;63;if(isNaN(r)){u=a=64}else if(isNaN(i)){a=64}t=t+this._keyStr.charAt(s)+this._keyStr.charAt(o)+this._keyStr.charAt(u)+this._keyStr.charAt(a)}return t},decode:function(e){var t=&quot;&quot;;var n,r,i;var s,o,u,a;var f=0;e=e.replace(/[^A-Za-z0-9\+\/\=]/g,&quot;&quot;);while(f&lt;e.length){s=this._keyStr.indexOf(e.charAt(f++));o=this._keyStr.indexOf(e.charAt(f++));u=this._keyStr.indexOf(e.charAt(f++));a=this._keyStr.indexOf(e.charAt(f++));n=s&lt;&lt;2|o&gt;&gt;4;r=(o&amp;15)&lt;&lt;4|u&gt;&gt;2;i=(u&amp;3)&lt;&lt;6|a;t=t+String.fromCharCode(n);if(u!=64){t=t+String.fromCharCode(r)}if(a!=64){t=t+String.fromCharCode(i)}}t=Base64._utf8_decode(t);return t},_utf8_encode:function(e){e=e.replace(/\r\n/g,&quot;\n&quot;);var t=&quot;&quot;;for(var n=0;n&lt;e.length;n++){var r=e.charCodeAt(n);if(r&lt;128){t+=String.fromCharCode(r)}else if(r&gt;127&amp;&amp;r&lt;2048){t+=String.fromCharCode(r&gt;&gt;6|192);t+=String.fromCharCode(r&amp;63|128)}else{t+=String.fromCharCode(r&gt;&gt;12|224);t+=String.fromCharCode(r&gt;&gt;6&amp;63|128);t+=String.fromCharCode(r&amp;63|128)}}return t},_utf8_decode:function(e){var t=&quot;&quot;;var n=0;var r=c1=c2=0;while(n&lt;e.length){r=e.charCodeAt(n);if(r&lt;128){t+=String.fromCharCode(r);n++}else if(r&gt;191&amp;&amp;r&lt;224){c2=e.charCodeAt(n+1);t+=String.fromCharCode((r&amp;31)&lt;&lt;6|c2&amp;63);n+=2}else{c2=e.charCodeAt(n+1);c3=e.charCodeAt(n+2);t+=String.fromCharCode((r&amp;15)&lt;&lt;12|(c2&amp;63)&lt;&lt;6|c3&amp;63);n+=3}}return t}}



var password = vars.get(&quot;glb_Password&quot;);
var password_LRF = vars.get(&quot;glb_Password_LRF&quot;);
var password_CreateInvoice = vars.get(&quot;glb_Password_CreateInvoice&quot;);
var decode = Base64.decode(password);
var decode_LRF = Base64.decode(password_LRF);
var decode_CreateInvoice = Base64.decode(password_CreateInvoice);
vars.put(&quot;glb_Password&quot;,decode);
vars.put(&quot;glb_Password_LRF&quot;,decode_LRF);
vars.put(&quot;glb_Password_CreateInvoice&quot;,decode_CreateInvoice);</stringProp>
