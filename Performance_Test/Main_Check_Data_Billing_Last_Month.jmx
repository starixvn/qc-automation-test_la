        <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="Flag Failed For Telegram" enabled="false">
          <stringProp name="scriptLanguage">groovy</stringProp>
          <stringProp name="parameters"></stringProp>
          <stringProp name="filename"></stringProp>
          <stringProp name="cacheKey"></stringProp>
          <stringProp name="script">if(prev!=null){
	if(prev.getErrorCount() != 0){
		vars.put(&quot;glb_flagFailed&quot;,&quot;1&quot;)
	}
	for(def result in prev.getAssertionResults()) {
		if(result.isFailure()) {
			vars.put(&quot;glb_flagFailed&quot;,&quot;1&quot;)
		}
	}
}</stringProp>
        </JSR223PreProcessor>
