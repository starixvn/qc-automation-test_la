            <hashTree>
              <JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="Save Data LAP-Colossus Bets Win Loss To GSpreadSheet And Compare Data with Settlement Report vs LA - Colossus Bet Win Loss" enabled="true">
                <stringProp name="cacheKey"></stringProp>
                <stringProp name="filename"></stringProp>
                <stringProp name="parameters"></stringProp>
                <stringProp name="script">import com.google.api.services.sheets.v4.model.ValueRange;
import com.google.api.services.sheets.v4.model.BatchUpdateValuesRequest;
import java.util.regex.Matcher;
import java.util.regex.Pattern;
import java.nio.file.Files;
import java.nio.file.Paths;
import org.apache.jmeter.services.FileServer;
import groovy.json.JsonSlurper

def path = FileServer.getFileServer().getBaseDir();
/*Load Common Functions - Start*/
ClassLoader parent = getClass().getClassLoader();
GroovyClassLoader loader = new GroovyClassLoader(parent);
Class groovyClass = loader.parseClass(new File(path + &quot;/&quot;+&quot;Functions.groovy&quot;));
GroovyObject Functions  = (GroovyObject) groovyClass.newInstance();
/*Load Common Functions - End*/

int i = Integer.parseInt(vars.get(&quot;counter&quot;));

List&lt;List&lt;Object&gt;&gt; sheet = vars.getObject(&quot;spreadsheets&quot;).values().get(&quot;${glb_LABillingLicensees_GoogleSpreadSheetID}&quot;, &quot;Licensees&quot;).setMajorDimension(&quot;ROWS&quot;).setValueRenderOption(&quot;UNFORMATTED_VALUE&quot;).setDateTimeRenderOption(&quot;FORMATTED_STRING&quot;).execute().getValues();                                     
vars.putObject(&quot;sheet&quot;, sheet);

if (vars.getObject(&quot;sheet&quot;).get(i).size() != 0) {
	def jsonSlurper = new JsonSlurper();
	def response = jsonSlurper.parseText(prev.getResponseDataAsString());
		
	String MemberWinning = response.SummaryTotal[&quot;${BaseCurrencyName}&quot;].MemberWinning.toString();
	String Turnover = response.SummaryTotal[&quot;${BaseCurrencyName}&quot;].TurnOver.toString();
	String TotalTrans = response.SummaryTotal[&quot;${BaseCurrencyName}&quot;].TotalTransaction.toString();
	String CashoutAmt = response.SummaryTotal[&quot;${BaseCurrencyName}&quot;].CashOut.toString();
	String CashoutShare = response.SummaryTotal[&quot;${BaseCurrencyName}&quot;].CashOutShare.toString();
	String CommissionShare = response.SummaryTotal[&quot;${BaseCurrencyName}&quot;].CommissionShare.toString();
	String AmountDueToColossusBets = response.SummaryTotal[&quot;${BaseCurrencyName}&quot;].AmountDueToCB.toString();

	List&lt;ValueRange&gt; list = Arrays.asList(
      new ValueRange().setRange(&quot;Licensees!I&quot; + (i + 1) + &quot;:J&quot; + (i + 1)).setValues(Arrays.asList(Arrays.asList(Turnover,TotalTrans))),
      new ValueRange().setRange(&quot;Licensees!M&quot; + (i + 1) + &quot;:P&quot; + (i + 1)).setValues(Arrays.asList(Arrays.asList(MemberWinning,CashoutAmt,CashoutShare,CommissionShare))),
      new ValueRange().setRange(&quot;Licensees!AM&quot; + (i + 1) + &quot;:AM&quot; + (i + 1)).setValues(Arrays.asList(Arrays.asList(AmountDueToColossusBets)))
      );     

	vars.getObject(&quot;spreadsheets&quot;).values().batchUpdate(&quot;${glb_LABillingLicensees_GoogleSpreadSheetID}&quot;,
                    new BatchUpdateValuesRequest().setData(list).setValueInputOption(&quot;RAW&quot;))
                    .execute();
	/* CHECK DATA WITH SETTLEMENT REPORT
	 * Turnover &lt;=&gt; Turnover, Total Trans &lt;=&gt; Total Trans, Customer&apos;s Winnings &lt;=&gt; Member Winning, Cash-out Amt &lt;=&gt; Cash-out Amt, Cash-out Share &lt;=&gt; Cash-out Share, Commission Share &lt;=&gt; Commission Share, Amount Due To Colossus Bets &lt;=&gt; Equivalent
	 * 
	 */
	//Get Index of Settlement Data Row that LAP-Colossus Bets Win Loss report need to compare with
	int SettlementDataRowIndex = 0;
	String strCompareDataWithReport = &quot;Settlement Report, ${Licensee}, ${PartyId}, ${ProductName}&quot;;
	for(int j = 0;j&lt;vars.getObject(&quot;sheet&quot;).size();j++) {
		String RowData = vars.getObject(&quot;sheet&quot;).get(j).toString();
		if(RowData.indexOf(strCompareDataWithReport)&gt;=1){
			log.info(strCompareDataWithReport+&quot;: -&gt; &quot;+j.toString());
			SettlementDataRowIndex = j;
			break;
		}
      }

	
	//Get Data from Settlement Data Row
      if(SettlementDataRowIndex&gt;0){
      	
		String Settlement_Turnover = vars.getObject(&quot;sheet&quot;).get(SettlementDataRowIndex).get(8).toString();
		String Settlement_TotalTrans = vars.getObject(&quot;sheet&quot;).get(SettlementDataRowIndex).get(9).toString();
		String Settlement_MemberWinning = vars.getObject(&quot;sheet&quot;).get(SettlementDataRowIndex).get(12).toString();
		String Settlement_CashoutAmt = vars.getObject(&quot;sheet&quot;).get(SettlementDataRowIndex).get(13).toString();
		String Settlement_CashoutShare = vars.getObject(&quot;sheet&quot;).get(SettlementDataRowIndex).get(14).toString();
		String Settlement_CommissionShare = vars.getObject(&quot;sheet&quot;).get(SettlementDataRowIndex).get(15).toString();
		String Settlement_Equivalent = vars.getObject(&quot;sheet&quot;).get(SettlementDataRowIndex).get(11).toString();
	
		String FlagTurnOver = Functions.returnStatusFormat(&quot;Fail&quot;);
		String FlagTotalTrans = Functions.returnStatusFormat(&quot;Fail&quot;);
		String FlagMemberWinning = Functions.returnStatusFormat(&quot;Fail&quot;);
		String FlagCashoutAmt = Functions.returnStatusFormat(&quot;Fail&quot;);
		String FlagCashoutShare = Functions.returnStatusFormat(&quot;Fail&quot;);
		String FlagCommissionShare = Functions.returnStatusFormat(&quot;Fail&quot;);
		String FlagEquivalent = Functions.returnStatusFormat(&quot;Fail&quot;);

		if(Math.abs(Functions.ConvertStringToFloat(Settlement_Turnover) - Functions.ConvertStringToFloat(Turnover))&lt;0.2){
			FlagTurnOver = Functions.returnStatusFormat(&quot;Pass&quot;);
		}else{
			AssertionResult.setFailure(true);
		}
		if(Math.abs(Functions.ConvertStringToFloat(Settlement_TotalTrans) - Functions.ConvertStringToFloat(TotalTrans))&lt;0.2){
			FlagTotalTrans = Functions.returnStatusFormat(&quot;Pass&quot;);
		}else{
			AssertionResult.setFailure(true);
		}
		if(Math.abs(Functions.ConvertStringToFloat(Settlement_MemberWinning) - Functions.ConvertStringToFloat(MemberWinning))&lt;0.2){
			FlagMemberWinning = Functions.returnStatusFormat(&quot;Pass&quot;);
		}else{
			AssertionResult.setFailure(true);
		}
		if(Math.abs(Functions.ConvertStringToFloat(Settlement_CashoutAmt) - Functions.ConvertStringToFloat(CashoutAmt))&lt;0.2){
			FlagCashoutAmt = Functions.returnStatusFormat(&quot;Pass&quot;);
		}else{
			AssertionResult.setFailure(true);
		}
		if(Math.abs(Functions.ConvertStringToFloat(Settlement_CashoutShare) - Functions.ConvertStringToFloat(CashoutShare))&lt;0.2){
			FlagCashoutShare = Functions.returnStatusFormat(&quot;Pass&quot;);
		}else{
			AssertionResult.setFailure(true);
		}
		if(Math.abs(Functions.ConvertStringToFloat(Settlement_CommissionShare) - Functions.ConvertStringToFloat(CommissionShare))&lt;0.2){
			FlagCommissionShare = Functions.returnStatusFormat(&quot;Pass&quot;);
		}else{
			AssertionResult.setFailure(true);
		}
		if(Math.abs(Functions.ConvertStringToFloat(Settlement_Equivalent) - Functions.ConvertStringToFloat(AmountDueToColossusBets))&lt;0.2){
			FlagEquivalent = Functions.returnStatusFormat(&quot;Pass&quot;);
		}else{
			AssertionResult.setFailure(true);
		}
		
		File file = new File(path + &quot;/&quot;+&quot;${glb_Report_CheckMonthlyBilling_File}&quot;);
		
		Functions.WriteHeaderToReport(file,&quot;${Licensee}&quot;, &quot;${Report}&quot;, &quot;Settlement Report&quot;);

		Functions.WriteResultToReport(file,&quot;TotalTrans&quot;,TotalTrans,Settlement_TotalTrans,FlagTotalTrans);
		Functions.WriteResultToReport(file,&quot;Turnover&quot;,Turnover,Settlement_Turnover,FlagTurnOver);
		Functions.WriteResultToReport(file,&quot;Customer&apos;s Winnings&quot;,MemberWinning,Settlement_MemberWinning,FlagMemberWinning);
		Functions.WriteResultToReport(file,&quot;Cash-out Amt&quot;,CashoutAmt,Settlement_CashoutAmt,FlagCashoutAmt);
		Functions.WriteResultToReport(file,&quot;Cash-out Share&quot;,CashoutShare,Settlement_CashoutShare,FlagCashoutShare);
		Functions.WriteResultToReport(file,&quot;Commission Share&quot;,CommissionShare,Settlement_CommissionShare,FlagCommissionShare);
		Functions.WriteResultToReport(file,&quot;Amt Due To CB vs Equivalent&quot;,AmountDueToColossusBets,Settlement_Equivalent,FlagEquivalent);
		
      }

      /* CHECK DATA WITH LA - Colossus Bet Win Loss
	 * Turnover &lt;=&gt; Turnover, Total Trans &lt;=&gt; Total Trans, Customer&apos;s Winnings &lt;=&gt; Member Winning, Cash-out Amt &lt;=&gt; Cash-out Amt, Cash-out Share &lt;=&gt; Cash-out Share, Commission Share &lt;=&gt; Commission Share, Amount Due To Colossus Bets &lt;=&gt; Equivalent
	 * 
	 */
	//Get Index of Colossus Bet Win Loss Data Row that LAP-Colossus Bets Win Loss report need to compare with
	int LACBWLDataRowIndex = 0;
	strCompareDataWithReport = &quot;Colossus Bet Win Loss, ${Licensee}, ${PartyId}, ${ProductName}&quot;;
	for(int j = 0;j&lt;vars.getObject(&quot;sheet&quot;).size();j++) {
		String RowData = vars.getObject(&quot;sheet&quot;).get(j).toString();
		if(RowData.indexOf(strCompareDataWithReport)&gt;=1){
			log.info(strCompareDataWithReport+&quot;: -&gt; &quot;+j.toString());
			LACBWLDataRowIndex = j;
			break;
		}
      }

	
	//Get Data from Colossus Bet Win Loss Data Row
      if(LACBWLDataRowIndex&gt;0){
      	
		String LACBWL_Turnover = vars.getObject(&quot;sheet&quot;).get(LACBWLDataRowIndex).get(8).toString();
		String LACBWL_TotalTrans = vars.getObject(&quot;sheet&quot;).get(LACBWLDataRowIndex).get(9).toString();
		String LACBWL_MemberWinAmountPrize = vars.getObject(&quot;sheet&quot;).get(LACBWLDataRowIndex).get(29).toString();
		String LACBWL_MemberWinAmountCashOut = vars.getObject(&quot;sheet&quot;).get(LACBWLDataRowIndex).get(30).toString();
	
		String FlagTurnOver = Functions.returnStatusFormat(&quot;Fail&quot;);
		String FlagTotalTrans = Functions.returnStatusFormat(&quot;Fail&quot;);
		String FlagMemberWinning = Functions.returnStatusFormat(&quot;Fail&quot;);
		String FlagCashoutAmt = Functions.returnStatusFormat(&quot;Fail&quot;);

		if(Math.abs(Functions.ConvertStringToFloat(LACBWL_Turnover) - Functions.ConvertStringToFloat(Turnover))&lt;0.2){
			FlagTurnOver = Functions.returnStatusFormat(&quot;Pass&quot;);
		}else{
			AssertionResult.setFailure(true);
		}
		if(Math.abs(Functions.ConvertStringToFloat(LACBWL_TotalTrans) - Functions.ConvertStringToFloat(TotalTrans))&lt;0.2){
			FlagTotalTrans = Functions.returnStatusFormat(&quot;Pass&quot;);
		}else{
			AssertionResult.setFailure(true);
		}
		if(Math.abs(Functions.ConvertStringToFloat(LACBWL_MemberWinAmountPrize) - Functions.ConvertStringToFloat(MemberWinning))&lt;0.2){
			FlagMemberWinning = Functions.returnStatusFormat(&quot;Pass&quot;);
		}else{
			AssertionResult.setFailure(true);
		}
		if(Math.abs(Functions.ConvertStringToFloat(LACBWL_MemberWinAmountCashOut) - Functions.ConvertStringToFloat(CashoutAmt))&lt;0.2){
			FlagCashoutAmt = Functions.returnStatusFormat(&quot;Pass&quot;);
		}else{
			AssertionResult.setFailure(true);
		}
		
		File file = new File(path + &quot;/&quot;+&quot;${glb_Report_CheckMonthlyBilling_File}&quot;);
		
		Functions.WriteHeaderToReport(file,&quot;${Licensee}&quot;, &quot;${Report}&quot;, &quot;Colossus Bet Win Loss&quot;);

		Functions.WriteResultToReport(file,&quot;TotalTrans&quot;,TotalTrans,LACBWL_TotalTrans,FlagTotalTrans);
		Functions.WriteResultToReport(file,&quot;Turnover&quot;,Turnover,LACBWL_Turnover,FlagTurnOver);
		Functions.WriteResultToReport(file,&quot;Customer&apos;s Winnings&quot;,MemberWinning,LACBWL_MemberWinAmountPrize,FlagMemberWinning);
		Functions.WriteResultToReport(file,&quot;Cash-out Amt&quot;,CashoutAmt,LACBWL_MemberWinAmountCashOut,FlagCashoutAmt);
		
      }
}
</stringProp>
                <stringProp name="scriptLanguage">groovy</stringProp>
              </JSR223Assertion>
