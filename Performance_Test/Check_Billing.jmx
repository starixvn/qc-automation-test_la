              <JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="Save Data LAP-Exchange Win Loss To Google SpreadSheet And Compare Data with Settlement Report vs LA - Exchange Win Loss" enabled="true">
                <stringProp name="cacheKey"></stringProp>
                <stringProp name="filename"></stringProp>
                <stringProp name="parameters"></stringProp>
                <stringProp name="script">import com.google.api.services.sheets.v4.model.ValueRange;
import com.google.api.services.sheets.v4.model.BatchUpdateValuesRequest;
import java.util.regex.Matcher;
import java.util.regex.Pattern;
import java.nio.file.Files;
import java.nio.file.Paths;
import org.apache.jmeter.services.FileServer;
import groovy.json.JsonSlurper

def path = FileServer.getFileServer().getBaseDir();
/*Load Common Functions - Start*/
ClassLoader parent = getClass().getClassLoader();
GroovyClassLoader loader = new GroovyClassLoader(parent);
Class groovyClass = loader.parseClass(new File(path + &quot;/&quot;+&quot;Functions.groovy&quot;));
GroovyObject Functions  = (GroovyObject) groovyClass.newInstance();
/*Load Common Functions - End*/

int i = Integer.parseInt(vars.get(&quot;counter&quot;));

List&lt;List&lt;Object&gt;&gt; sheet = vars.getObject(&quot;spreadsheets&quot;).values().get(&quot;${glb_LABillingLicensees_GoogleSpreadSheetID}&quot;, &quot;Licensees&quot;).setMajorDimension(&quot;ROWS&quot;).setValueRenderOption(&quot;UNFORMATTED_VALUE&quot;).setDateTimeRenderOption(&quot;FORMATTED_STRING&quot;).execute().getValues();                                     
vars.putObject(&quot;sheet&quot;, sheet);

if (vars.getObject(&quot;sheet&quot;).get(i).size() != 0) {
	def jsonSlurper = new JsonSlurper();
	def response = jsonSlurper.parseText(prev.getResponseDataAsString());
		
	String CustomerWinLoss = response.SummaryTotal[&quot;${BaseCurrencyName}&quot;].CustomerWL.toString();
	String Turnover = response.SummaryTotal[&quot;${BaseCurrencyName}&quot;].Turnover.toString();
	String TotalTrans = response.SummaryTotal[&quot;${BaseCurrencyName}&quot;].TotalTransaction.toString();
	String CustomerComm = response.SummaryTotal[&quot;${BaseCurrencyName}&quot;].CustomerComm.toString();
	String CustomerTotal = response.SummaryTotal[&quot;${BaseCurrencyName}&quot;].CustomerWLTotal.toString();
	String LicenseeWinLoss = response.SummaryTotal[&quot;${BaseCurrencyName}&quot;].LicenseeWL.toString();
	String AmountDueTo = response.SummaryTotal[&quot;${BaseCurrencyName}&quot;].AmountDueTo.toString();
	String LicenseeComm = response.SummaryTotal[&quot;${BaseCurrencyName}&quot;].LicenseeComm.toString();

	List&lt;ValueRange&gt; list = Arrays.asList(
      new ValueRange().setRange(&quot;Licensees!I&quot; + (i + 1) + &quot;:K&quot; + (i + 1)).setValues(Arrays.asList(Arrays.asList(Turnover,TotalTrans,CustomerWinLoss))),
      new ValueRange().setRange(&quot;Licensees!AA&quot; + (i + 1) + &quot;:AA&quot; + (i + 1)).setValues(Arrays.asList(Arrays.asList(LicenseeWinLoss))),
      new ValueRange().setRange(&quot;Licensees!AN&quot; + (i + 1) + &quot;:AQ&quot; + (i + 1)).setValues(Arrays.asList(Arrays.asList(CustomerComm,CustomerTotal,AmountDueTo,LicenseeComm)))
      );     

	vars.getObject(&quot;spreadsheets&quot;).values().batchUpdate(&quot;${glb_LABillingLicensees_GoogleSpreadSheetID}&quot;,
                    new BatchUpdateValuesRequest().setData(list).setValueInputOption(&quot;RAW&quot;))
                    .execute();
	/* CHECK DATA WITH SETTLEMENT REPORT
	 * Turnover &lt;=&gt; Turnover, Total Trans &lt;=&gt; Total Trans, Customer Win Loss + Customer Comm &lt;=&gt; Customer Win Loss, Amount Due To &lt;=&gt; Equivalent
	 * 
	 */
	//Get Index of Settlement Data Row that LAP-Exchange Win Loss report need to compare with
	int SettlementDataRowIndex = 0;
	String strCompareDataWithReport = &quot;Settlement Report, ${Licensee}, ${PartyId}, ${ProductName}&quot;;
	for(int j = 0;j&lt;vars.getObject(&quot;sheet&quot;).size();j++) {
		String RowData = vars.getObject(&quot;sheet&quot;).get(j).toString();
		if(RowData.indexOf(strCompareDataWithReport)&gt;=1){
			log.info(strCompareDataWithReport+&quot;: -&gt; &quot;+j.toString());
			SettlementDataRowIndex = j;
			break;
		}
      }

	
	//Get Data from Settlement Data Row
      if(SettlementDataRowIndex&gt;0){
      	
		String Settlement_Turnover = vars.getObject(&quot;sheet&quot;).get(SettlementDataRowIndex).get(8).toString();
		String Settlement_TotalTrans = vars.getObject(&quot;sheet&quot;).get(SettlementDataRowIndex).get(9).toString();
		String Settlement_CustomerWinLoss = vars.getObject(&quot;sheet&quot;).get(SettlementDataRowIndex).get(10).toString();
		String Settlement_Equivalent = vars.getObject(&quot;sheet&quot;).get(SettlementDataRowIndex).get(11).toString();
	
		String FlagTurnOver = Functions.returnStatusFormat(&quot;Fail&quot;);
		String FlagTotalTrans = Functions.returnStatusFormat(&quot;Fail&quot;);
		String FlagCustomerWinLoss = Functions.returnStatusFormat(&quot;Fail&quot;);
		String FlagEquivalent = Functions.returnStatusFormat(&quot;Fail&quot;);

		if(Math.abs(Functions.ConvertStringToFloat(Settlement_Turnover) - Functions.ConvertStringToFloat(Turnover))&lt;0.2){
			FlagTurnOver = Functions.returnStatusFormat(&quot;Pass&quot;);
		}else{
			AssertionResult.setFailure(true);
		}
		if(Math.abs(Functions.ConvertStringToFloat(Settlement_TotalTrans) - Functions.ConvertStringToFloat(TotalTrans))&lt;0.2){
			FlagTotalTrans = Functions.returnStatusFormat(&quot;Pass&quot;);
		}else{
			AssertionResult.setFailure(true);
		}
		if(Math.abs(Functions.ConvertStringToFloat(Settlement_CustomerWinLoss) - (Functions.ConvertStringToFloat(CustomerWinLoss)+Functions.ConvertStringToFloat(CustomerComm)))&lt;0.2){
			FlagCustomerWinLoss = Functions.returnStatusFormat(&quot;Pass&quot;);
		}else{
			AssertionResult.setFailure(true);
		}
		
		if(Math.abs(Functions.ConvertStringToFloat(Settlement_Equivalent) - Functions.ConvertStringToFloat(AmountDueTo))&lt;0.2){
			FlagEquivalent = Functions.returnStatusFormat(&quot;Pass&quot;);
		}else{
			AssertionResult.setFailure(true);
		}
		
		File file = new File(path + &quot;/&quot;+&quot;${glb_Report_CheckMonthlyBilling_File}&quot;);
		
		Functions.WriteHeaderToReport(file,&quot;${Licensee}&quot;, &quot;${Report}&quot;, &quot;Settlement Report&quot;);

		Functions.WriteResultToReport(file,&quot;TotalTrans&quot;,TotalTrans,Settlement_TotalTrans,FlagTotalTrans);
		Functions.WriteResultToReport(file,&quot;Turnover&quot;,Turnover,Settlement_Turnover,FlagTurnOver);
		Functions.WriteResultToReport(file,&quot;Cust WL+Cust Comm=Cust WL&quot;,(Functions.ConvertStringToFloat(CustomerWinLoss)+Functions.ConvertStringToFloat(CustomerComm)).toString(),Settlement_CustomerWinLoss,FlagCustomerWinLoss);
		Functions.WriteResultToReport(file,&quot;Amt Due To=Equivalent&quot;,AmountDueTo,Settlement_Equivalent,FlagEquivalent);
		
      }

	/* CHECK DATA WITH Exchange Win Loss
	 * Turnover &lt;=&gt; Turnover, Total Trans &lt;=&gt; Total Trans, Customer Win Loss &lt;=&gt; Customer Win Loss, Customer Comm &lt;=&gt; Customer Charge Comm, Licensee Comm &lt;=&gt; Licensee Charge Comm, Amount Due To &lt;=&gt; Licensing fee
	 * 
	 */
	//Get Index of Exchange Win Loss Data Row that LAP-Exchange Win Loss report need to compare with
	int ExWLDataRowIndex = 0;
	strCompareDataWithReport = &quot;Exchange Win Loss, ${Licensee}, ${PartyId}, ${ProductName}&quot;;
	for(int j = 0;j&lt;vars.getObject(&quot;sheet&quot;).size();j++) {
		String RowData = vars.getObject(&quot;sheet&quot;).get(j).toString();
		if(RowData.indexOf(strCompareDataWithReport)&gt;=1){
			log.info(strCompareDataWithReport+&quot;: -&gt; &quot;+j.toString());
			ExWLDataRowIndex = j;
			break;
		}
      }

	
	//Get Data from Settlement Data Row
      if(ExWLDataRowIndex&gt;0){
      	String Settlement_Turnover = vars.getObject(&quot;sheet&quot;).get(ExWLDataRowIndex).get(8).toString();
		String Settlement_TotalTrans = vars.getObject(&quot;sheet&quot;).get(ExWLDataRowIndex).get(9).toString();
		String Settlement_CustomerWinLoss = vars.getObject(&quot;sheet&quot;).get(ExWLDataRowIndex).get(10).toString();
		String Settlement_CustomerChargeComm = vars.getObject(&quot;sheet&quot;).get(ExWLDataRowIndex).get(27).toString();
		String Settlement_LicenseeChargeComm = vars.getObject(&quot;sheet&quot;).get(ExWLDataRowIndex).get(28).toString();
		String Settlement_Licensingfee = vars.getObject(&quot;sheet&quot;).get(ExWLDataRowIndex).get(24).toString();
	
		String FlagTurnOver = Functions.returnStatusFormat(&quot;Fail&quot;);
		String FlagTotalTrans = Functions.returnStatusFormat(&quot;Fail&quot;);
		String FlagCustomerWinLoss = Functions.returnStatusFormat(&quot;Fail&quot;);
		String FlagCustomerComm = Functions.returnStatusFormat(&quot;Fail&quot;);
		String FlagLicenseeComm = Functions.returnStatusFormat(&quot;Fail&quot;);
		String FlagAmountDueTo = Functions.returnStatusFormat(&quot;Fail&quot;);

		if(Math.abs(Functions.ConvertStringToFloat(Settlement_Turnover) - Functions.ConvertStringToFloat(Turnover))&lt;0.2){
			FlagTurnOver = Functions.returnStatusFormat(&quot;Pass&quot;);
		}else{
			AssertionResult.setFailure(true);
		}
		if(Math.abs(Functions.ConvertStringToFloat(Settlement_TotalTrans) - Functions.ConvertStringToFloat(TotalTrans))&lt;0.2){
			FlagTotalTrans = Functions.returnStatusFormat(&quot;Pass&quot;);
		}else{
			AssertionResult.setFailure(true);
		}
		if(Math.abs(Functions.ConvertStringToFloat(Settlement_CustomerWinLoss) - Functions.ConvertStringToFloat(CustomerWinLoss))&lt;0.2){
			FlagCustomerWinLoss = Functions.returnStatusFormat(&quot;Pass&quot;);
		}else{
			AssertionResult.setFailure(true);
		}
		
		if(Math.abs(Functions.ConvertStringToFloat(Settlement_CustomerChargeComm) - Functions.ConvertStringToFloat(CustomerComm))&lt;0.2){
			FlagCustomerComm = Functions.returnStatusFormat(&quot;Pass&quot;);
		}else{
			AssertionResult.setFailure(true);
		}
		if(Math.abs(Functions.ConvertStringToFloat(Settlement_LicenseeChargeComm) - Functions.ConvertStringToFloat(LicenseeComm))&lt;0.2){
			FlagLicenseeComm = Functions.returnStatusFormat(&quot;Pass&quot;);
		}else{
			AssertionResult.setFailure(true);
		}
		if(Math.abs(Functions.ConvertStringToFloat(Settlement_Licensingfee) - Functions.ConvertStringToFloat(AmountDueTo))&lt;0.2){
			FlagAmountDueTo = Functions.returnStatusFormat(&quot;Pass&quot;);
		}else{
			AssertionResult.setFailure(true);
		}
		
		File file = new File(path + &quot;/&quot;+&quot;${glb_Report_CheckMonthlyBilling_File}&quot;);
		
		Functions.WriteHeaderToReport(file,&quot;${Licensee}&quot;, &quot;${Report}&quot;, &quot;Exchange Win Loss&quot;);

		Functions.WriteResultToReport(file,&quot;TotalTrans&quot;,TotalTrans,Settlement_TotalTrans,FlagTotalTrans);
		Functions.WriteResultToReport(file,&quot;Turnover&quot;,Turnover,Settlement_Turnover,FlagTurnOver);
		Functions.WriteResultToReport(file,&quot;Cust WL&quot;,CustomerWinLoss,Settlement_CustomerWinLoss,FlagCustomerWinLoss);
		Functions.WriteResultToReport(file,&quot;Cust Comm=Cust Charge Comm&quot;,CustomerComm,Settlement_CustomerChargeComm,FlagCustomerComm);
		Functions.WriteResultToReport(file,&quot;Lic Comm=Lic Charge Comm&quot;,LicenseeComm,Settlement_LicenseeChargeComm,FlagLicenseeComm);
		Functions.WriteResultToReport(file,&quot;Amt Due To=Lic fee&quot;,AmountDueTo,Settlement_Licensingfee,FlagAmountDueTo);
		
      }
      
}

</stringProp>
