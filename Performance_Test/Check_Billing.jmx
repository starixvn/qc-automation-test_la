            <hashTree>
              <JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="Save Data LAP-Licensee Win Loss To Google SpreadSheet And Compare Data with Settlement Report" enabled="true">
                <stringProp name="cacheKey"></stringProp>
                <stringProp name="filename"></stringProp>
                <stringProp name="parameters"></stringProp>
                <stringProp name="script">import com.google.api.services.sheets.v4.model.ValueRange;
import com.google.api.services.sheets.v4.model.BatchUpdateValuesRequest;
import java.util.regex.Matcher;
import java.util.regex.Pattern;
import java.nio.file.Files;
import java.nio.file.Paths;
import org.apache.jmeter.services.FileServer;
import groovy.json.JsonSlurper

def path = FileServer.getFileServer().getBaseDir();
/*Load Common Functions - Start*/
ClassLoader parent = getClass().getClassLoader();
GroovyClassLoader loader = new GroovyClassLoader(parent);
Class groovyClass = loader.parseClass(new File(path + &quot;/&quot;+&quot;Functions.groovy&quot;));
GroovyObject Functions  = (GroovyObject) groovyClass.newInstance();
/*Load Common Functions - End*/

int i = Integer.parseInt(vars.get(&quot;counter&quot;));

List&lt;List&lt;Object&gt;&gt; sheet = vars.getObject(&quot;spreadsheets&quot;).values().get(&quot;${glb_LABillingLicensees_GoogleSpreadSheetID}&quot;, &quot;Licensees&quot;).setMajorDimension(&quot;ROWS&quot;).setValueRenderOption(&quot;UNFORMATTED_VALUE&quot;).setDateTimeRenderOption(&quot;FORMATTED_STRING&quot;).execute().getValues();                                     
vars.putObject(&quot;sheet&quot;, sheet);

if (vars.getObject(&quot;sheet&quot;).get(i).size() != 0) {
	def jsonSlurper = new JsonSlurper();
	def response = jsonSlurper.parseText(prev.getResponseDataAsString());
		
	String CustomerWinLoss = &quot;Not_Found&quot;;
	String Turnover = &quot;Not_Found&quot;;
	String TotalTrans = &quot;Not_Found&quot;;
	String BACommission = &quot;Not_Found&quot;;
	String AmtDueToBA = &quot;Not_Found&quot;;
	String CashOutCommission = &quot;Not_Found&quot;;

	if(response.SummaryTotal[&quot;${BaseCurrencyName}&quot;]!=null){
		CustomerWinLoss = response.SummaryTotal[&quot;${BaseCurrencyName}&quot;].CustomerTotal.toString();
		Turnover = response.SummaryTotal[&quot;${BaseCurrencyName}&quot;].TotalTurnOver.toString();
		TotalTrans = response.SummaryTotal[&quot;${BaseCurrencyName}&quot;].TotalTransaction.toString();
		BACommission = response.SummaryTotal[&quot;${BaseCurrencyName}&quot;].BACommission.toString();
		AmtDueToBA = response.SummaryTotal[&quot;${BaseCurrencyName}&quot;].AmtDueToBA.toString();
		CashOutCommission = response.SummaryTotal[&quot;${BaseCurrencyName}&quot;].CashOutCommission.toString();
	}

	
	List&lt;ValueRange&gt; list = Arrays.asList(
      new ValueRange().setRange(&quot;Licensees!I&quot; + (i + 1) + &quot;:K&quot; + (i + 1)).setValues(Arrays.asList(Arrays.asList(Turnover,TotalTrans,CustomerWinLoss))),
      new ValueRange().setRange(&quot;Licensees!V&quot; + (i + 1) + &quot;:V&quot; + (i + 1)).setValues(Arrays.asList(Arrays.asList(CashOutCommission))),
      new ValueRange().setRange(&quot;Licensees!AJ&quot; + (i + 1) + &quot;:AK&quot; + (i + 1)).setValues(Arrays.asList(Arrays.asList(BACommission,AmtDueToBA)))
      );     

	vars.getObject(&quot;spreadsheets&quot;).values().batchUpdate(&quot;${glb_LABillingLicensees_GoogleSpreadSheetID}&quot;,
                    new BatchUpdateValuesRequest().setData(list).setValueInputOption(&quot;RAW&quot;))
                    .execute();
	/* CHECK DATA WITH SETTLEMENT REPORT
	 * Turnover &lt;=&gt; Turnover, Total Trans &lt;=&gt; Total Trans, Customer Win Loss &lt;=&gt; Customer Win Loss
	 * 
	 */
	//Get Index of Settlement Data Row that report need to compare with
	int SettlementDataRowIndex = 0;
	String strCompareDataWithReport = &quot;Settlement Report, ${Licensee}, ${PartyId}, ${ProductName}&quot;;
	for(int j = 0;j&lt;vars.getObject(&quot;sheet&quot;).size();j++) {
		String RowData = vars.getObject(&quot;sheet&quot;).get(j).toString();
		if(RowData.indexOf(strCompareDataWithReport)&gt;=1){
			log.info(strCompareDataWithReport+&quot;: -&gt; &quot;+j.toString());
			SettlementDataRowIndex = j;
			break;
		}
      }

	
	//Get Data from Settlement Data Row
      if(SettlementDataRowIndex&gt;0){
      	
      	String Settlement_CustomerWinLoss = vars.getObject(&quot;sheet&quot;).get(SettlementDataRowIndex).get(10).toString();
		String Settlement_Turnover = vars.getObject(&quot;sheet&quot;).get(SettlementDataRowIndex).get(8).toString();
		String Settlement_TotalTrans = vars.getObject(&quot;sheet&quot;).get(SettlementDataRowIndex).get(9).toString();

		String Settlement_CashOutTimes = &quot;&quot;;
		String Settlement_CashOutCommission = &quot;&quot;;	

		String Settlement_BACommission = &quot;&quot;;
		String Settlement_AmtDueToBA = &quot;&quot;;

		
		if(&quot;${ProductName}&quot;==&quot;Cash Out&quot;){
			Settlement_CashOutTimes = vars.getObject(&quot;sheet&quot;).get(SettlementDataRowIndex).get(16).toString();
			Settlement_CashOutCommission = vars.getObject(&quot;sheet&quot;).get(SettlementDataRowIndex).get(21).toString();	
		}else if(&quot;${ProductName}&quot;==&quot;BA&quot;){
			Settlement_BACommission = vars.getObject(&quot;sheet&quot;).get(SettlementDataRowIndex).get(35).toString();
			Settlement_AmtDueToBA = vars.getObject(&quot;sheet&quot;).get(SettlementDataRowIndex).get(36).toString();	
		}
		
		
		String FlagTurnOver = Functions.returnStatusFormat(&quot;Fail&quot;);
		String FlagTotalTrans = Functions.returnStatusFormat(&quot;Fail&quot;);
		String FlagCustomerWinLoss = Functions.returnStatusFormat(&quot;Fail&quot;);
		String FlagCashOutCommission = Functions.returnStatusFormat(&quot;Fail&quot;);
		String FlagBACommission = Functions.returnStatusFormat(&quot;Fail&quot;);
		String FlagAmtDueToBA = Functions.returnStatusFormat(&quot;Fail&quot;);
		
		//If Cashout then check Total Trans = Cash Out Times*2 , Cash Out Commission = Cash Out Commission
		if(&quot;${ProductName}&quot;==&quot;Cash Out&quot;){
			//log.info(&quot;=======William2 :&quot;+Settlement_CashOutTimes+&quot;-&quot;+Settlement_CashOutCommission);
			if(Math.abs(Functions.ConvertStringToFloat(Settlement_CashOutTimes)*2 - Functions.ConvertStringToFloat(TotalTrans))&lt;0.2){
				FlagTotalTrans = Functions.returnStatusFormat(&quot;Pass&quot;);
			}else{
				AssertionResult.setFailure(true);
			}

			if(Math.abs(Functions.ConvertStringToFloat(Settlement_CashOutCommission) - Functions.ConvertStringToFloat(CashOutCommission))&lt;0.2){
				FlagCashOutCommission = Functions.returnStatusFormat(&quot;Pass&quot;);
			}else{
				AssertionResult.setFailure(true);
			}
		}else if(&quot;${ProductName}&quot;==&quot;BA&quot;){
			//if(response.SummaryTotal[&quot;${BaseCurrencyName}&quot;]!=null){
				
				if(Math.abs(Functions.ConvertStringToFloat(Settlement_Turnover) - Functions.ConvertStringToFloat(Turnover))&lt;0.2){
					FlagTurnOver = Functions.returnStatusFormat(&quot;Pass&quot;);
				}else{
					AssertionResult.setFailure(true);
				}
	
				if(Math.abs(Functions.ConvertStringToFloat(Settlement_CustomerWinLoss) - Functions.ConvertStringToFloat(CustomerWinLoss))&lt;0.2){
					FlagCustomerWinLoss = Functions.returnStatusFormat(&quot;Pass&quot;);
				}else{
					AssertionResult.setFailure(true);
				}
	
				if(Math.abs(Functions.ConvertStringToFloat(Settlement_BACommission) - Functions.ConvertStringToFloat(BACommission))&lt;0.2){
					FlagBACommission = Functions.returnStatusFormat(&quot;Pass&quot;);
				}else{
					AssertionResult.setFailure(true);
				}
	
				if(Math.abs(Functions.ConvertStringToFloat(Settlement_AmtDueToBA) - Functions.ConvertStringToFloat(AmtDueToBA))&lt;0.2){
					FlagAmtDueToBA = Functions.returnStatusFormat(&quot;Pass&quot;);
				}else{
					AssertionResult.setFailure(true);
				}

				
				
			/*}else{
				if(Settlement_Turnover == Turnover){
					FlagTurnOver = Functions.returnStatusFormat(&quot;Pass&quot;);
				}else{
					AssertionResult.setFailure(true);
				}
	
				if(Settlement_CustomerWinLoss == CustomerWinLoss){
					FlagCustomerWinLoss = Functions.returnStatusFormat(&quot;Pass&quot;);
				}else{
					AssertionResult.setFailure(true);
				}
	
				if(Settlement_BACommission == BACommission){
					FlagBACommission = Functions.returnStatusFormat(&quot;Pass&quot;);
				}else{
					AssertionResult.setFailure(true);
				}
	
				if(Settlement_AmtDueToBA == AmtDueToBA){
					FlagAmtDueToBA = Functions.returnStatusFormat(&quot;Pass&quot;);
				}else{
					AssertionResult.setFailure(true);
				}
			}*/
		}else{
			if(Math.abs(Functions.ConvertStringToFloat(Settlement_Turnover) - Functions.ConvertStringToFloat(Turnover))&lt;0.2){
				FlagTurnOver = Functions.returnStatusFormat(&quot;Pass&quot;);
			}else{
				AssertionResult.setFailure(true);
			}
			if(Math.abs(Functions.ConvertStringToFloat(Settlement_TotalTrans) - Functions.ConvertStringToFloat(TotalTrans))&lt;0.2){
				FlagTotalTrans = Functions.returnStatusFormat(&quot;Pass&quot;);
			}else{
				AssertionResult.setFailure(true);
			}
			if(Math.abs(Functions.ConvertStringToFloat(Settlement_CustomerWinLoss) - Functions.ConvertStringToFloat(CustomerWinLoss))&lt;0.2){
				FlagCustomerWinLoss = Functions.returnStatusFormat(&quot;Pass&quot;);
			}else{
				AssertionResult.setFailure(true);
			}
		}

		File file = new File(path + &quot;/&quot;+&quot;${glb_Report_CheckMonthlyBilling_File}&quot;);
		
		Functions.WriteHeaderToReport(file,&quot;${Licensee}&quot;, &quot;${Report}&quot;, &quot;Settlement Report&quot;);

		if(&quot;${ProductName}&quot;==&quot;Cash Out&quot;){
			Functions.WriteResultToReport(file,&quot;TotalTrans=CO Times*2-&quot;+&quot;${ProductCode}&quot;,TotalTrans,Settlement_CashOutTimes.toString(),FlagTotalTrans);
			Functions.WriteResultToReport(file,&quot;Cash Out Commission-&quot;+&quot;${ProductCode}&quot;,CashOutCommission,Settlement_CashOutCommission,FlagCashOutCommission);
		}else if(&quot;${ProductName}&quot;==&quot;BA&quot;){
			Functions.WriteResultToReport(file,&quot;Turnover-&quot;+&quot;${ProductCode}&quot;,Turnover,Settlement_Turnover,FlagTurnOver);
			Functions.WriteResultToReport(file,&quot;Customer WL-&quot;+&quot;${ProductCode}&quot;,CustomerWinLoss,Settlement_CustomerWinLoss,FlagCustomerWinLoss);
			Functions.WriteResultToReport(file,&quot;BA Commission-&quot;+&quot;${ProductCode}&quot;,BACommission,Settlement_BACommission,FlagBACommission);
			Functions.WriteResultToReport(file,&quot;Amt Due To BA-&quot;+&quot;${ProductCode}&quot;,AmtDueToBA,Settlement_AmtDueToBA,FlagAmtDueToBA);
		}else{
			Functions.WriteResultToReport(file,&quot;TotalTrans-&quot;+&quot;${ProductCode}&quot;,TotalTrans,Settlement_TotalTrans,FlagTotalTrans);
			Functions.WriteResultToReport(file,&quot;Turnover-&quot;+&quot;${ProductCode}&quot;,Turnover,Settlement_Turnover,FlagTurnOver);
			Functions.WriteResultToReport(file,&quot;Customer WL-&quot;+&quot;${ProductCode}&quot;,CustomerWinLoss,Settlement_CustomerWinLoss,FlagCustomerWinLoss);
		}
		
		
		
		
      }

      
}


</stringProp>
                <stringProp name="scriptLanguage">groovy</stringProp>
              </JSR223Assertion>
              <hashTree/>
            </hashTree>
          </hashTree>
          <IfController guiclass="IfControllerPanel" testclass="IfController" testname="IF LAP-AG CASINO WIN LOSS REPORT" enabled="true">
            <stringProp name="IfController.condition">&quot;${Report}&quot;==&quot;LAP-AG Casino Win Loss&quot;</stringProp>
