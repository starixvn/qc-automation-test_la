//		}else 

		if(ProductName==&quot;Sportsbook&quot; || ProductName==&quot;Virtual Sports&quot;){
			Functions.WriteResultToReport(file,&quot;TotalTrans-&quot;+ ProductName,TotalTrans,Settlement_TotalTrans,FlagTotalTrans);
			Functions.WriteResultToReport(file,&quot;Turnover-&quot;+ ProductName,Turnover,Settlement_Turnover,FlagTurnOver);
			Functions.WriteResultToReport(file,&quot;Customer WL-&quot;+ ProductName,CustomerWinLoss,Settlement_CustomerWinLoss,FlagCustomerWinLoss);
		}else{
