	&quot;InvoiceTypeId&quot;:1,&#xd;
	&quot;IsSeparateProduct&quot;:false,&#xd;
	&quot;InvoiceLanguage&quot;: &quot;${glb_InvoiceLanguage}&quot;&#xd;
}</stringProp>
                    <stringProp name="Argument.metadata">=</stringProp>
                  </elementProp>
                </collectionProp>
