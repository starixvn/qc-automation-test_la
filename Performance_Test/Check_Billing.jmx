              <JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="Save Data From Report To Google SpreadSheet and Compare with LA-Spcefic Reports" enabled="true">
                <stringProp name="cacheKey"></stringProp>
                <stringProp name="filename"></stringProp>
                <stringProp name="parameters"></stringProp>
                <stringProp name="script">import com.google.api.services.sheets.v4.model.ValueRange;
import com.google.api.services.sheets.v4.model.BatchUpdateValuesRequest;
import java.util.regex.Matcher;
import java.util.regex.Pattern;
import java.nio.file.Files;
import java.nio.file.Paths;
import org.apache.jmeter.services.FileServer;
import groovy.json.JsonSlurper

def path = FileServer.getFileServer().getBaseDir();
/*Load Common Functions - Start*/
ClassLoader parent = getClass().getClassLoader();
GroovyClassLoader loader = new GroovyClassLoader(parent);
Class groovyClass = loader.parseClass(new File(path + &quot;/&quot;+&quot;Functions.groovy&quot;));
GroovyObject Functions  = (GroovyObject) groovyClass.newInstance();
/*Load Common Functions - End*/

int i = Integer.parseInt(vars.get(&quot;counter&quot;));

List&lt;List&lt;Object&gt;&gt; sheet = vars.getObject(&quot;spreadsheets&quot;).values().get(&quot;${glb_LABillingLicensees_GoogleSpreadSheetID}&quot;, &quot;Licensees&quot;).setMajorDimension(&quot;ROWS&quot;).setValueRenderOption(&quot;UNFORMATTED_VALUE&quot;).setDateTimeRenderOption(&quot;FORMATTED_STRING&quot;).execute().getValues();                                     
vars.putObject(&quot;sheet&quot;, sheet);

if (vars.getObject(&quot;sheet&quot;).get(i).size() != 0) {
		
	String LicensingFee = &quot;${Licensing Fee}&quot;;
	//String DiscountSB = &quot;${Discount - SB}&quot;;
	String AmtDueToBA = &quot;${AmtDueToBA}&quot;;
	String TotalFee = &quot;${Total Fee}&quot;;
	
	if(&quot;${Licensing Fee - Negative}&quot;!=&quot;Not_Found&quot;){
		LicensingFee = &quot;${Licensing Fee - Negative}&quot;;
	}

	if(&quot;${AmtDueToBA - Negative}&quot;!=&quot;Not_Found&quot;){
		AmtDueToBA = &quot;${AmtDueToBA - Negative}&quot;;
	}

	switch (&quot;${ProductName}&quot;) {
	   case &quot;Sportsbook&quot;:
	       LicensingFee = &quot;${Licensing Fee - SB}&quot;;
	       break;
	}
	
	List&lt;ValueRange&gt; list = Arrays.asList(
      new ValueRange().setRange(&quot;Licensees!Y&quot; + (i + 1) + &quot;:Y&quot; + (i + 1)).setValues(Arrays.asList(Arrays.asList(LicensingFee))),
      new ValueRange().setRange(&quot;Licensees!AZ&quot; + (i + 1) + &quot;:AZ&quot; + (i + 1)).setValues(Arrays.asList(Arrays.asList(TotalFee)))
      );     

	vars.getObject(&quot;spreadsheets&quot;).values().batchUpdate(&quot;${glb_LABillingLicensees_GoogleSpreadSheetID}&quot;,
                    new BatchUpdateValuesRequest().setData(list).setValueInputOption(&quot;RAW&quot;))
                    .execute();

	/* CHECK DATA WITH LA Specific REPORTs
	 * LicensingFee
	 * 
	 */
	//Get Index of Data Row that Licensee Performance in Details report need to compare with
	String strReport = Functions.getLAReportNameFromProductNameToCompareWithCreateInvoice(&quot;${ProductName}&quot;);
	String strCompareDataWithReport = strReport+&quot;, ${Licensee}, ${PartyId}, ${ProductName}&quot;;
	int DataRowIndex = 0;
	
	for(int j = 0;j&lt;vars.getObject(&quot;sheet&quot;).size();j++) {
		String RowData = vars.getObject(&quot;sheet&quot;).get(j).toString();
		if(RowData.indexOf(strCompareDataWithReport)&gt;=1){
			log.info(strCompareDataWithReport+&quot;: -&gt; &quot;+j.toString());
			DataRowIndex = j;
			break;
		}
      }
	
	//Get Data from Settlement Data Row
      if(DataRowIndex&gt;0){
		String Specific_LicensingFee = vars.getObject(&quot;sheet&quot;).get(DataRowIndex).get(24).toString();
		String Specific_AmtDueToBA = &quot;&quot;;
		//String Specific_DiscountSB = &quot;&quot;;
		String Specific_Prizes = &quot;&quot;;
//		String Specific_TipsAmountDue = &quot;&quot;;
		switch (&quot;${ProductName}&quot;) {
		   
		   case &quot;Sportsbook&quot;:
		       Specific_LicensingFee = vars.getObject(&quot;sheet&quot;).get(DataRowIndex).get(51).toString(); //get from LPID
		       //Specific_DiscountSB = vars.getObject(&quot;sheet&quot;).get(DataRowIndex).get(46).toString(); //get from LPID
		       break;
		   case [&quot;Saba Casino&quot;, &quot;Allbet&quot;, &quot;SG&quot;, &quot;Virtual Games&quot;,&quot;SA Gaming&quot;, &quot;Vgaming&quot;, &quot;Virtual Sports&quot;, &quot;GPI&quot;, &quot;SEAL Entertainment&quot;, &quot;MG-RNG&quot;, &quot;Jili&quot;, &quot;YeeBet&quot;, &quot;Live22&quot;, &quot;WE Live Casino&quot;, &quot;Nextspin&quot;, &quot;FastSpin&quot;, &quot;FA CHAI&quot;, &quot;GPI Live Casino&quot;, &quot;ON Casino&quot;]: // &quot;Saba.club&quot; terminated
		       Specific_LicensingFee = vars.getObject(&quot;sheet&quot;).get(DataRowIndex).get(11).toString(); //get from Settlement Report
		       break;
		   case &quot;Pragmatic&quot;:
		   	  Specific_LicensingFee = vars.getObject(&quot;sheet&quot;).get(DataRowIndex).get(11).toString(); //get from Settlement Report
		   	  Specific_Prizes = vars.getObject(&quot;sheet&quot;).get(DataRowIndex).get(50).toString(); //get from Settlement Report
		       break;
		   case &quot;SA Gaming&quot;: 
		       Specific_LicensingFee = vars.getObject(&quot;sheet&quot;).get(DataRowIndex).get(11).toString(); //get from Settlement Report
		       Specific_TipsAmountDue = vars.getObject(&quot;sheet&quot;).get(DataRowIndex).get(52).toString(); //get from Settlement Report
		       break;	
		   case &quot;BA&quot;:
		   	  Specific_AmtDueToBA = vars.getObject(&quot;sheet&quot;).get(DataRowIndex).get(36).toString();
		   	  break
		}

		String FlagLicensingFee = Functions.returnStatusFormat(&quot;Fail&quot;);
		String FlagDiscountSB = Functions.returnStatusFormat(&quot;Fail&quot;);
		String FlagAmtDueToBA = Functions.returnStatusFormat(&quot;Fail&quot;);

		if (Specific_Prizes == &quot;-&quot;){
			Specific_Prizes = &quot;0&quot;;
		}

//		if (Specific_TipsAmountDue == &quot;-&quot;){
//			Specific_TipsAmountDue = &quot;0&quot;;
//		}
		
		File file = new File(path + &quot;/&quot;+&quot;${glb_Report_CheckMonthlyBilling_File}&quot;);
		Functions.WriteHeaderToReport(file,&quot;${Licensee}&quot;, &quot;${Report}&quot;, strReport);	

		switch (&quot;${ProductName}&quot;) {
		   case &quot;Sportsbook&quot;:
		   	  	//if(Math.abs(Functions.ConvertStringToFloat(Specific_LicensingFee,true) - Functions.ConvertStringToFloat(LicensingFee,true))&lt;0.2){
		   	  	if(Math.abs(Functions.ConvertStringToFloat(Specific_LicensingFee,true) - Functions.ConvertStringToFloat(TotalFee,true))&lt;0.2){
					FlagLicensingFee = Functions.returnStatusFormat(&quot;Pass&quot;);
				}else{
					AssertionResult.setFailure(true);
				}
//				if(Math.abs(Math.abs(Functions.ConvertStringToFloat(Specific_DiscountSB)) - Math.abs(Functions.ConvertStringToFloat(DiscountSB)))&lt;0.2){
//					FlagDiscountSB = Functions.returnStatusFormat(&quot;Pass&quot;);
//				}else{
//					AssertionResult.setFailure(true);
//				}
//			  	Functions.WriteResultToReport(file,&quot;Discount-${ProductCode}&quot;,DiscountSB,Specific_DiscountSB,FlagDiscountSB);
                    Functions.WriteResultToReport(file,&quot;LicensingFee-${ProductCode}&quot;,TotalFee,Specific_LicensingFee,FlagLicensingFee);
			  	break;
		   case &quot;BA&quot;:
		   		if(Math.abs(Functions.ConvertStringToFloat(Specific_AmtDueToBA) - Functions.ConvertStringToFloat(AmtDueToBA))&lt;0.2){
					FlagAmtDueToBA = Functions.returnStatusFormat(&quot;Pass&quot;);
				}else{
					AssertionResult.setFailure(true);
				}
			  	Functions.WriteResultToReport(file,&quot;AmtDueToBA-${ProductCode}&quot;,AmtDueToBA,Specific_AmtDueToBA,FlagAmtDueToBA);
			  	break;
		   case &quot;Exchange&quot;: //&quot;Colossus Bets&quot;, &quot;Cash Out&quot;
		   		if(Math.abs(Functions.ConvertStringToFloat(Specific_LicensingFee) - Functions.ConvertStringToFloat(LicensingFee))&lt;0.2){
					FlagLicensingFee = Functions.returnStatusFormat(&quot;Pass&quot;);
				}else{
					AssertionResult.setFailure(true);
				}
		   	  	Functions.WriteResultToReport(file,&quot;LicensingFee-${ProductCode}&quot;,LicensingFee,Specific_LicensingFee,FlagLicensingFee);
		   	  	break;
		   case [&quot;Pragmatic&quot;,&quot;Arcadia Gaming&quot;,&quot;Vgaming&quot;,&quot;SG&quot;,&quot;Allbet&quot;,&quot;SA Gaming&quot;,&quot;PG Soft&quot;,&quot;AG Casino&quot;]: // &quot;Saba.club&quot; terminated
		   		/*if (Functions.ConvertStringToFloat(Specific_LicensingFee,true) &gt; 0)
				{ 
					def Specific_LicensingFeePositive = Math.abs(Functions.ConvertStringToFloat(Specific_LicensingFee,true) - Functions.ConvertStringToFloat(Specific_Prizes,true)).toString();
					if(Math.abs(Functions.ConvertStringToFloat(Specific_LicensingFeePositive,true) - Functions.ConvertStringToFloat(TotalFee,true))&lt;0.2){
						FlagLicensingFee = Functions.returnStatusFormat(&quot;Pass&quot;);
					}else{
						AssertionResult.setFailure(true);
					}
					Functions.WriteResultToReport(file,&quot;LicensingFee-${ProductCode}&quot;,TotalFee,Specific_LicensingFeePositive,FlagLicensingFee);
				}
				else{
					if(Math.abs(Functions.ConvertStringToFloat(Specific_Prizes,true) - Functions.ConvertStringToFloat(TotalFee,true))&lt;0.2){
					FlagLicensingFee = Functions.returnStatusFormat(&quot;Pass&quot;);
					}else{
						AssertionResult.setFailure(true);
					}
					Functions.WriteResultToReport(file,&quot;LicensingFee-${ProductCode}&quot;,TotalFee,Specific_Prizes,FlagLicensingFee);
				}*/
				if(Math.abs(Functions.ConvertStringToFloat(Specific_LicensingFee,true) - Functions.ConvertStringToFloat(TotalFee,true))&lt;0.2){
					FlagLicensingFee = Functions.returnStatusFormat(&quot;Pass&quot;);
				}else{
					AssertionResult.setFailure(true);
				}
		   	  	Functions.WriteResultToReport(file,&quot;LicensingFee-${ProductCode}&quot;,TotalFee,Specific_LicensingFee,FlagLicensingFee);
				break;
//		   case &quot;SA Gaming&quot;:
//				if(Math.abs(Functions.ConvertStringToFloat(Specific_LicensingFee,true) - Functions.ConvertStringToFloat(Specific_TipsAmountDue,true) - Functions.ConvertStringToFloat(TotalFee,true))&lt;0.2) //SHOULD REVIEW SYNTAX WHEN SA GAMING HAS TIP AMOUNT DUE
//				{
//					FlagLicensingFee = Functions.returnStatusFormat(&quot;Pass&quot;);
//				}else{
//					AssertionResult.setFailure(true);
//				}
//		   	  	Functions.WriteResultToReport(file,&quot;LicensingFee-${ProductCode}&quot;,TotalFee,Specific_LicensingFee,FlagLicensingFee);
//				break;
		   default:
		   		if(Math.abs(Functions.ConvertStringToFloat(Specific_LicensingFee,true) - Functions.ConvertStringToFloat(LicensingFee,true))&lt;0.2){
					FlagLicensingFee = Functions.returnStatusFormat(&quot;Pass&quot;);
				}else{
					AssertionResult.setFailure(true);
				}
		   	  	Functions.WriteResultToReport(file,&quot;LicensingFee-${ProductCode}&quot;,LicensingFee,Specific_LicensingFee,FlagLicensingFee);
		   	  	break;
		}
      }            
}
	
</stringProp>
                <stringProp name="scriptLanguage">groovy</stringProp>
              </JSR223Assertion>
