                <stringProp name="cacheKey"></stringProp>
                <stringProp name="script">var response = &quot;${PartyData}&quot;;
var PartyData = responnse.replace(&quot;&amp;quot;&quot;,&quot;&quot;);
var obj = JSON.parse(PartyData);
//var BalanceUpDay = response.substr(response.indexOf(&quot;BalanceUpDay&quot;) + 26,19);
