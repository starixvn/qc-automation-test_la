              <hashTree/>
              <JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="Save Data From Report To Google SpreadSheet" enabled="true">
                <stringProp name="cacheKey"></stringProp>
                <stringProp name="filename"></stringProp>
                <stringProp name="parameters"></stringProp>
                <stringProp name="script">import com.google.api.services.sheets.v4.model.ValueRange;
import com.google.api.services.sheets.v4.model.BatchUpdateValuesRequest;
import java.util.regex.Matcher;
import java.util.regex.Pattern;
import java.nio.file.Files;
import java.nio.file.Paths;
import org.apache.jmeter.services.FileServer;
import groovy.json.JsonSlurper

def path = FileServer.getFileServer().getBaseDir();
/*Load Common Functions - Start*/
ClassLoader parent = getClass().getClassLoader();
GroovyClassLoader loader = new GroovyClassLoader(parent);
Class groovyClass = loader.parseClass(new File(path + &quot;/&quot;+&quot;Functions.groovy&quot;));
GroovyObject Functions  = (GroovyObject) groovyClass.newInstance();
/*Load Common Functions - End*/

int i = Integer.parseInt(vars.get(&quot;counter&quot;));

List&lt;List&lt;Object&gt;&gt; sheet = vars.getObject(&quot;spreadsheets&quot;).values().get(&quot;${glb_LABillingLicensees_GoogleSpreadSheetID}&quot;, &quot;Licensees&quot;).setMajorDimension(&quot;ROWS&quot;).setValueRenderOption(&quot;UNFORMATTED_VALUE&quot;).setDateTimeRenderOption(&quot;FORMATTED_STRING&quot;).execute().getValues();                                     
vars.putObject(&quot;sheet&quot;, sheet);

if (vars.getObject(&quot;sheet&quot;).get(i).size() != 0) {
	
	
	def jsonSlurper = new JsonSlurper();
	def response = jsonSlurper.parseText(prev.getResponseDataAsString());
		
	String TotalTrans = response.GrandTotal.TotalTrans.toString();
	String Turnover = response.GrandTotal.Turnover.toString();
	String CustomerWinLoss = response.GrandTotal.GrossWinLoss.toString();
	String BAComm = response.GrandTotal.BACommission.toString();
	String AmtDueToBA = response.GrandTotal.AmountDueToBA.toString();
	String LicensingFee = response.GrandTotal.TotalLicensingFee.toString();
	String DiscountSportsbook = response.GrandTotal.DiscountSportsbook.toString();
	String TotalLicensingFee = response.GrandTotal.TotalLicensingFee.toString();

	if(&quot;${ProductName}&quot;==&quot;Sportsbook&quot;){
	LicensingFee = response.GrandTotal.SportsbookFee.toString();
	//String TotalLicensingFeeSB = response.GrandTotal.TotalLicensingFee.toString();
	}
	
	List&lt;ValueRange&gt; list = Arrays.asList(
      new ValueRange().setRange(&quot;Licensees!I&quot; + (i + 1) + &quot;:K&quot; + (i + 1)).setValues(Arrays.asList(Arrays.asList(Turnover,TotalTrans,CustomerWinLoss))),
      new ValueRange().setRange(&quot;Licensees!Y&quot; + (i + 1) + &quot;:Y&quot; + (i + 1)).setValues(Arrays.asList(Arrays.asList(LicensingFee))),
      new ValueRange().setRange(&quot;Licensees!AJ&quot; + (i + 1) + &quot;:AK&quot; + (i + 1)).setValues(Arrays.asList(Arrays.asList(BAComm,AmtDueToBA))),
      new ValueRange().setRange(&quot;Licensees!AU&quot; + (i + 1) + &quot;:AU&quot; + (i + 1)).setValues(Arrays.asList(Arrays.asList(DiscountSportsbook))),
      new ValueRange().setRange(&quot;Licensees!AZ&quot; + (i + 1) + &quot;:AZ&quot; + (i + 1)).setValues(Arrays.asList(Arrays.asList(TotalLicensingFee)))
      );     

	vars.getObject(&quot;spreadsheets&quot;).values().batchUpdate(&quot;${glb_LABillingLicensees_GoogleSpreadSheetID}&quot;,
                    new BatchUpdateValuesRequest().setData(list).setValueInputOption(&quot;RAW&quot;))
                    .execute();

	/* CHECK DATA WITH LA Specific REPORTs
	 * TotalTrans, Turnover, CustomerWinLoss, LicensingFee
	 * 
	 */
	//Get Index of Data Row that Licensee Performance in Details report need to compare with
	String strReport = Functions.getLAReportNameFromProductNameToCompareWithLicenseePerformanceInDetails(&quot;${ProductName}&quot;);
	String strCompareDataWithReport = strReport+&quot;, ${Licensee}, ${PartyId}, ${ProductName}&quot;;
	int DataRowIndex = 0;
	
	for(int j = 0;j&lt;vars.getObject(&quot;sheet&quot;).size();j++) {
		String RowData = vars.getObject(&quot;sheet&quot;).get(j).toString();
		if(RowData.indexOf(strCompareDataWithReport)&gt;=1){
			log.info(strCompareDataWithReport+&quot;: -&gt; &quot;+j.toString());
			DataRowIndex = j;
			break;
		}
      }

	//Get Data from Specific Report or Settlement Report
      if(DataRowIndex&gt;0){

		String Specific_CustomerWinLoss = vars.getObject(&quot;sheet&quot;).get(DataRowIndex).get(10).toString();
		String Specific_LicensingFee = vars.getObject(&quot;sheet&quot;).get(DataRowIndex).get(24).toString();
		switch (&quot;${ProductName}&quot;) {
//		   case &quot;Number Game&quot;:
//		       Specific_CustomerWinLoss = vars.getObject(&quot;sheet&quot;).get(DataRowIndex).get(25).toString();//get from Gross Win
//		       break
//		   case &quot;Virtual Sports&quot;:
//		       Specific_CustomerWinLoss = vars.getObject(&quot;sheet&quot;).get(DataRowIndex).get(26).toString();//get from Licensee Win Loss
//		       break;
		   case &quot;Exchange&quot;:
		       String Specific_CustomerChargeComm = vars.getObject(&quot;sheet&quot;).get(DataRowIndex).get(27).toString();//get from Customer Charge Comm
		       double tmpCustWL = Functions.ConvertStringToFloat(Specific_CustomerWinLoss) + Functions.ConvertStringToFloat(Specific_CustomerChargeComm);
		       Specific_CustomerWinLoss = tmpCustWL.toString();
		       break;
		   case [&quot;Sportsbook&quot;, &quot;Saba Casino&quot;, &quot;Allbet&quot;, &quot;Pragmatic&quot;, &quot;SG&quot;, &quot;Virtual Games&quot;, &quot;SA Gaming&quot;, &quot;Vgaming&quot;, &quot;Virtual Sports&quot;, &quot;GPI&quot;, &quot;SEAL Entertainment&quot;, &quot;MG-RNG&quot;, &quot;Jili&quot;, &quot;YeeBet&quot;, &quot;Live22&quot;, &quot;WE Live Casino&quot;, &quot;Nextspin&quot;, &quot;FastSpin&quot;, &quot;FA CHAI&quot;, &quot;GPI Live Casino&quot;, &quot;ON Casino&quot;]: // &quot;Saba.club&quot; terminated
		   	  Specific_LicensingFee = vars.getObject(&quot;sheet&quot;).get(DataRowIndex).get(11).toString();//get from Settlement Report -&gt; Equivalent 
		       break
		}
		String Specific_Turnover = vars.getObject(&quot;sheet&quot;).get(DataRowIndex).get(8).toString();
		String Specific_TotalTrans = vars.getObject(&quot;sheet&quot;).get(DataRowIndex).get(9).toString();
		String Specific_BAComm = vars.getObject(&quot;sheet&quot;).get(DataRowIndex).get(35).toString();
		String Specific_AmtDueToBA = vars.getObject(&quot;sheet&quot;).get(DataRowIndex).get(36).toString();
		String Specific_Prizes = vars.getObject(&quot;sheet&quot;).get(DataRowIndex).get(50).toString();
		
		String FlagTurnOver = Functions.returnStatusFormat(&quot;Fail&quot;);
		String FlagTotalTrans = Functions.returnStatusFormat(&quot;Fail&quot;);
		String FlagCustomerWinLoss = Functions.returnStatusFormat(&quot;Fail&quot;);
		String FlagLicensingFee = Functions.returnStatusFormat(&quot;Fail&quot;);
		String FlagBAComm = Functions.returnStatusFormat(&quot;Fail&quot;);
		String FlagAmtDueToBA = Functions.returnStatusFormat(&quot;Fail&quot;);

		if (Specific_Prizes == &quot;-&quot;){
			Specific_Prizes = &quot;0&quot;;
		}
		
		File file = new File(path + &quot;/&quot;+&quot;${glb_Report_CheckMonthlyBilling_File}&quot;);
		
		Functions.WriteHeaderToReport(file,&quot;${Licensee}&quot;, &quot;${Report}&quot;, strReport);
		
		if(Math.abs(Functions.ConvertStringToFloat(Specific_Turnover) - Functions.ConvertStringToFloat(Turnover))&lt;0.2){
			FlagTurnOver = Functions.returnStatusFormat(&quot;Pass&quot;);
		}else{
			AssertionResult.setFailure(true);
		}	
		if(Math.abs(Math.abs(Functions.ConvertStringToFloat(Specific_CustomerWinLoss)) - Math.abs(Functions.ConvertStringToFloat(CustomerWinLoss)))&lt;0.2){
			FlagCustomerWinLoss = Functions.returnStatusFormat(&quot;Pass&quot;);
		}else{
			AssertionResult.setFailure(true);
		}		
		if(&quot;${ProductName}&quot;==&quot;BA&quot;){
			if(Math.abs(Functions.ConvertStringToFloat(Specific_BAComm) - Functions.ConvertStringToFloat(BAComm))&lt;0.2){
				FlagBAComm = Functions.returnStatusFormat(&quot;Pass&quot;);
			}else{
				AssertionResult.setFailure(true);
			}
			if(Math.abs(Functions.ConvertStringToFloat(Specific_AmtDueToBA) - Functions.ConvertStringToFloat(AmtDueToBA))&lt;0.2){
				FlagAmtDueToBA = Functions.returnStatusFormat(&quot;Pass&quot;);
			}else{
				AssertionResult.setFailure(true);
			}
			Functions.WriteResultToReport(file,&quot;AmtDueToBA-${ProductCode}&quot;,AmtDueToBA,Specific_AmtDueToBA,FlagAmtDueToBA);
			Functions.WriteResultToReport(file,&quot;BAComm-${ProductCode}&quot;,BAComm,Specific_BAComm,FlagBAComm);
		}
//		else if(&quot;${ProductName}&quot;==&quot;Pragmatic&quot;){
//			if (Functions.ConvertStringToFloat(Specific_LicensingFee,true) &gt; 0)
//			{ 
//				def Specific_LicensingFeePositive = Math.abs(Functions.ConvertStringToFloat(Specific_LicensingFee,true) - Functions.ConvertStringToFloat(Specific_Prizes,true)).toString();
//				if(Math.abs(Functions.ConvertStringToFloat(Specific_LicensingFeePositive,true) - Functions.ConvertStringToFloat(LicensingFee,true))&lt;0.2){
//					FlagLicensingFee = Functions.returnStatusFormat(&quot;Pass&quot;);
//				}else{
//					AssertionResult.setFailure(true);
//				}
//				Functions.WriteResultToReport(file,&quot;LicensingFee-${ProductCode}&quot;,LicensingFee,Specific_LicensingFeePositive,FlagLicensingFee);
//			}else{
//				if(Math.abs(Functions.ConvertStringToFloat(Specific_Prizes,true) - Functions.ConvertStringToFloat(LicensingFee,true))&lt;0.2){
//				FlagLicensingFee = Functions.returnStatusFormat(&quot;Pass&quot;);
//				}else{
//					AssertionResult.setFailure(true);
//				}
//				Functions.WriteResultToReport(file,&quot;LicensingFee-${ProductCode}&quot;,LicensingFee,Specific_Prizes,FlagLicensingFee);
//			}
//		}
		else{
			if(Math.abs(Functions.ConvertStringToFloat(Specific_TotalTrans) - Functions.ConvertStringToFloat(TotalTrans))&lt;0.2){
				FlagTotalTrans = Functions.returnStatusFormat(&quot;Pass&quot;);
			}else{
				AssertionResult.setFailure(true);
			}
			if(Math.abs(Functions.ConvertStringToFloat(Specific_LicensingFee,true) - Functions.ConvertStringToFloat(LicensingFee,true))&lt;0.2){
				FlagLicensingFee = Functions.returnStatusFormat(&quot;Pass&quot;);
			}else{
				AssertionResult.setFailure(true);
			}
			Functions.WriteResultToReport(file,&quot;TotalTrans-${ProductCode}&quot;,TotalTrans,Specific_TotalTrans,FlagTotalTrans);
			Functions.WriteResultToReport(file,&quot;LicensingFee-${ProductCode}&quot;,LicensingFee,Specific_LicensingFee,FlagLicensingFee);
		}
		Functions.WriteResultToReport(file,&quot;Turnover-${ProductCode}&quot;,Turnover,Specific_Turnover,FlagTurnOver);
		Functions.WriteResultToReport(file,&quot;Customer WL-${ProductCode}&quot;,CustomerWinLoss,Specific_CustomerWinLoss,FlagCustomerWinLoss);
      }            
}


</stringProp>
                <stringProp name="scriptLanguage">groovy</stringProp>
              </JSR223Assertion>
              <hashTree/>
              <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="TryCatchErrorCode" enabled="true">
                <stringProp name="scriptLanguage">groovy</stringProp>
                <stringProp name="parameters"></stringProp>
                <stringProp name="filename"></stringProp>
                <stringProp name="cacheKey"></stringProp>
                <stringProp name="script">import java.nio.file.Files;
import java.nio.file.Paths;
import org.apache.jmeter.services.FileServer;

def path = FileServer.getFileServer().getBaseDir();
/*Load Common Functions - Start*/
ClassLoader parent = getClass().getClassLoader();
GroovyClassLoader loader = new GroovyClassLoader(parent);
Class groovyClass = loader.parseClass(new File(path + &quot;/&quot;+&quot;Functions.groovy&quot;));
GroovyObject Functions  = (GroovyObject) groovyClass.newInstance();
/*Load Common Functions - End*/
File file = new File(path + &quot;/&quot;+&quot;${glb_Report_CheckMonthlyBilling_File}&quot;);
Functions.TryCatchErrorCode(file,prev.getResponseCode(),&quot;${Licensee}-${Report}-${ProductName}&quot;);</stringProp>
              </JSR223PostProcessor>
