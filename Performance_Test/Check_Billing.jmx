            <hashTree>
              <JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="Save Data LAP-Cash Out Win Loss To Google SpreadSheet And Compare Data with Settlement Report vs LA - Cash Out Win Loss" enabled="true">
                <stringProp name="cacheKey"></stringProp>
                <stringProp name="filename"></stringProp>
                <stringProp name="parameters"></stringProp>
                <stringProp name="script">import com.google.api.services.sheets.v4.model.ValueRange;
import com.google.api.services.sheets.v4.model.BatchUpdateValuesRequest;
import java.util.regex.Matcher;
import java.util.regex.Pattern;
import java.nio.file.Files;
import java.nio.file.Paths;
import org.apache.jmeter.services.FileServer;
import groovy.json.JsonSlurper

def path = FileServer.getFileServer().getBaseDir();
/*Load Common Functions - Start*/
ClassLoader parent = getClass().getClassLoader();
GroovyClassLoader loader = new GroovyClassLoader(parent);
Class groovyClass = loader.parseClass(new File(path + &quot;/&quot;+&quot;Functions.groovy&quot;));
GroovyObject Functions  = (GroovyObject) groovyClass.newInstance();
/*Load Common Functions - End*/

int i = Integer.parseInt(vars.get(&quot;counter&quot;));

List&lt;List&lt;Object&gt;&gt; sheet = vars.getObject(&quot;spreadsheets&quot;).values().get(&quot;${glb_LABillingLicensees_GoogleSpreadSheetID}&quot;, &quot;Licensees&quot;).setMajorDimension(&quot;ROWS&quot;).setValueRenderOption(&quot;UNFORMATTED_VALUE&quot;).setDateTimeRenderOption(&quot;FORMATTED_STRING&quot;).execute().getValues();                                     
vars.putObject(&quot;sheet&quot;, sheet);

if (vars.getObject(&quot;sheet&quot;).get(i).size() != 0) {
	def jsonSlurper = new JsonSlurper();
	def response = jsonSlurper.parseText(prev.getResponseDataAsString());
		
	String CashOutTimes = response.SummaryTotal[&quot;${BaseCurrencyName}&quot;].CashOutTimes.toString();
	String CashOutTickets = response.SummaryTotal[&quot;${BaseCurrencyName}&quot;].CashOutTickets.toString();
	String CashOutValue = response.SummaryTotal[&quot;${BaseCurrencyName}&quot;].CashOutValue.toString();
	String BuyBackAmountSportsbook = response.SummaryTotal[&quot;${BaseCurrencyName}&quot;].BuyBackAmountSB.toString();
	String BuyBackAmountBA = response.SummaryTotal[&quot;${BaseCurrencyName}&quot;].BuyBackAmountBA.toString();
	String BuyBackAmountTotal = response.SummaryTotal[&quot;${BaseCurrencyName}&quot;].TotalBuyBackAmount.toString();
	String TicketPayout = response.SummaryTotal[&quot;${BaseCurrencyName}&quot;].TicketPayout.toString();
	String CashOutCommission = response.SummaryTotal[&quot;${BaseCurrencyName}&quot;].CashOutCommission.toString();
	String SettleAmountTicketPayout = response.SummaryTotal[&quot;${BaseCurrencyName}&quot;].SettleAmountTicketPayout.toString();
	String SettleAmountBBAmtComm = response.SummaryTotal[&quot;${BaseCurrencyName}&quot;].SettleAmountBuyBackComm.toString();
	String SettleAmountTotal = response.SummaryTotal[&quot;${BaseCurrencyName}&quot;].SettleAmountTotal.toString();

	List&lt;ValueRange&gt; list = Arrays.asList(
      new ValueRange().setRange(&quot;Licensees!Q&quot; + (i + 1) + &quot;:V&quot; + (i + 1)).setValues(Arrays.asList(Arrays.asList(CashOutTimes,CashOutTickets,CashOutValue,BuyBackAmountTotal,TicketPayout,CashOutCommission))),
      new ValueRange().setRange(&quot;Licensees!AR&quot; + (i + 1) + &quot;:AT&quot; + (i + 1)).setValues(Arrays.asList(Arrays.asList(SettleAmountTicketPayout,SettleAmountBBAmtComm,SettleAmountTotal)))
      );     

	vars.getObject(&quot;spreadsheets&quot;).values().batchUpdate(&quot;${glb_LABillingLicensees_GoogleSpreadSheetID}&quot;,
                    new BatchUpdateValuesRequest().setData(list).setValueInputOption(&quot;RAW&quot;))
                    .execute();
	/* CHECK DATA WITH SETTLEMENT REPORT
	 * Cash Out Times &lt;=&gt; Cash Out Times, Cash Out Tickets &lt;=&gt; Cash Out Tickets, Cash Out Value &lt;=&gt; Cash Out Value, Buy Back Amount - Total &lt;=&gt; Buy Back Amount - Total, Ticket Payout &lt;=&gt; Ticket Payout, Cash Out Commission &lt;=&gt; Cash Out Commission, Settle Amount - Ticket Payout &lt;=&gt; Amount Due to Cash Out - Tickets Payout, Settle Amount - BB Amt + Comm &lt;=&gt; Amount Due to Cash Out - Buyback + Comm, Settle Amount - Total &lt;=&gt; Equivalent
	 * 
	 */
	//Get Index of Settlement Data Row that LAP-Exchange Win Loss report need to compare with
	int SettlementDataRowIndex = 0;
	String strCompareDataWithReport = &quot;Settlement Report, ${Licensee}, ${PartyId}, ${ProductName}&quot;;
	for(int j = 0;j&lt;vars.getObject(&quot;sheet&quot;).size();j++) {
		String RowData = vars.getObject(&quot;sheet&quot;).get(j).toString();
		if(RowData.indexOf(strCompareDataWithReport)&gt;=1){
			log.info(strCompareDataWithReport+&quot;: -&gt; &quot;+j.toString());
			SettlementDataRowIndex = j;
			break;
		}
      }

	
	//Get Data from Settlement Data Row
      if(SettlementDataRowIndex&gt;0){
      	
		String Settlement_CashOutTimes = vars.getObject(&quot;sheet&quot;).get(SettlementDataRowIndex).get(16).toString();
		String Settlement_CashOutTickets = vars.getObject(&quot;sheet&quot;).get(SettlementDataRowIndex).get(17).toString();
		String Settlement_CashOutValue = vars.getObject(&quot;sheet&quot;).get(SettlementDataRowIndex).get(18).toString();
		String Settlement_BuybackAmountTotal = vars.getObject(&quot;sheet&quot;).get(SettlementDataRowIndex).get(19).toString();
		String Settlement_TicketsPayout = vars.getObject(&quot;sheet&quot;).get(SettlementDataRowIndex).get(20).toString();
		String Settlement_CashOutCommission = vars.getObject(&quot;sheet&quot;).get(SettlementDataRowIndex).get(21).toString();
		String Settlement_AmountDuetoCashOutTicketsPayout = vars.getObject(&quot;sheet&quot;).get(SettlementDataRowIndex).get(22).toString();
		String Settlement_AmountDuetoCashOutBuybackComm = vars.getObject(&quot;sheet&quot;).get(SettlementDataRowIndex).get(23).toString();
		String Settlement_Equivalent = vars.getObject(&quot;sheet&quot;).get(SettlementDataRowIndex).get(11).toString();
	
		String FlagCashOutTimes = Functions.returnStatusFormat(&quot;Fail&quot;);
		String FlagCashOutTickets = Functions.returnStatusFormat(&quot;Fail&quot;);
		String FlagCashOutValue = Functions.returnStatusFormat(&quot;Fail&quot;);
		String FlagBuyBackAmountTotal = Functions.returnStatusFormat(&quot;Fail&quot;);
		String FlagTicketPayout = Functions.returnStatusFormat(&quot;Fail&quot;);
		String FlagCashOutCommission = Functions.returnStatusFormat(&quot;Fail&quot;);
		String FlagSettleAmountTicketPayout = Functions.returnStatusFormat(&quot;Fail&quot;);
		String FlagSettleAmountBBAmtComm = Functions.returnStatusFormat(&quot;Fail&quot;);
		String FlagSettleAmountTotal = Functions.returnStatusFormat(&quot;Fail&quot;);

		if(Math.abs(Functions.ConvertStringToFloat(Settlement_CashOutTimes) - Functions.ConvertStringToFloat(CashOutTimes))&lt;0.2){
			FlagCashOutTimes = Functions.returnStatusFormat(&quot;Pass&quot;);
		}else{
			AssertionResult.setFailure(true);
		}
		if(Math.abs(Functions.ConvertStringToFloat(Settlement_CashOutTickets) - Functions.ConvertStringToFloat(CashOutTickets))&lt;0.2){
			FlagCashOutTickets = Functions.returnStatusFormat(&quot;Pass&quot;);
		}else{
			AssertionResult.setFailure(true);
		}
		if(Math.abs(Functions.ConvertStringToFloat(Settlement_CashOutValue) - Functions.ConvertStringToFloat(CashOutValue))&lt;0.2){
			FlagCashOutValue = Functions.returnStatusFormat(&quot;Pass&quot;);
		}else{
			AssertionResult.setFailure(true);
		}

		if(Math.abs(Functions.ConvertStringToFloat(Settlement_BuybackAmountTotal) - Functions.ConvertStringToFloat(BuyBackAmountTotal))&lt;0.2){
			FlagBuyBackAmountTotal = Functions.returnStatusFormat(&quot;Pass&quot;);
		}else{
			AssertionResult.setFailure(true);
		}


		if(Math.abs(Functions.ConvertStringToFloat(Settlement_TicketsPayout) - Functions.ConvertStringToFloat(TicketPayout))&lt;0.2){
			FlagTicketPayout = Functions.returnStatusFormat(&quot;Pass&quot;);
		}else{
			AssertionResult.setFailure(true);
		}
		if(Math.abs(Functions.ConvertStringToFloat(Settlement_CashOutCommission) - Functions.ConvertStringToFloat(CashOutCommission))&lt;0.2){
			FlagCashOutCommission = Functions.returnStatusFormat(&quot;Pass&quot;);
		}else{
			AssertionResult.setFailure(true);
		}

		if(Math.abs(Functions.ConvertStringToFloat(Settlement_AmountDuetoCashOutTicketsPayout) - Functions.ConvertStringToFloat(SettleAmountTicketPayout))&lt;0.2){
			FlagSettleAmountTicketPayout = Functions.returnStatusFormat(&quot;Pass&quot;);
		}else{
			AssertionResult.setFailure(true);
		}
		if(Math.abs(Functions.ConvertStringToFloat(Settlement_AmountDuetoCashOutBuybackComm) - Functions.ConvertStringToFloat(SettleAmountBBAmtComm))&lt;0.2){
			FlagSettleAmountBBAmtComm = Functions.returnStatusFormat(&quot;Pass&quot;);
		}else{
			AssertionResult.setFailure(true);
		}
		
		
		if(Math.abs(Functions.ConvertStringToFloat(Settlement_Equivalent) - Functions.ConvertStringToFloat(SettleAmountTotal))&lt;0.2){
			FlagSettleAmountTotal = Functions.returnStatusFormat(&quot;Pass&quot;);
		}else{
			AssertionResult.setFailure(true);
		}

		File file = new File(path + &quot;/&quot;+&quot;${glb_Report_CheckMonthlyBilling_File}&quot;);
		
		Functions.WriteHeaderToReport(file,&quot;${Licensee}&quot;, &quot;${Report}&quot;, &quot;Settlement Report&quot;);

		Functions.WriteResultToReport(file,&quot;Cash Out Times&quot;,CashOutTimes,Settlement_CashOutTimes,FlagCashOutTimes);
		Functions.WriteResultToReport(file,&quot;Cash Out Tickets&quot;,CashOutTickets,Settlement_CashOutTickets,FlagCashOutTickets);
		Functions.WriteResultToReport(file,&quot;Cash Out Value&quot;,CashOutValue,Settlement_CashOutValue,FlagCashOutValue);
		Functions.WriteResultToReport(file,&quot;Buyback Amt - Total&quot;,BuyBackAmountTotal,Settlement_BuybackAmountTotal,FlagBuyBackAmountTotal);
		Functions.WriteResultToReport(file,&quot;Tickets Payout&quot;,TicketPayout,Settlement_TicketsPayout,FlagTicketPayout);
		Functions.WriteResultToReport(file,&quot;Cash Out Commission&quot;,CashOutCommission,Settlement_CashOutCommission,FlagCashOutCommission);
		Functions.WriteResultToReport(file,&quot;Settle Amt - Ticket Payout&quot;,SettleAmountTicketPayout,Settlement_AmountDuetoCashOutTicketsPayout,FlagSettleAmountTicketPayout);
		Functions.WriteResultToReport(file,&quot;Settle Amt - BBAmt + Comm&quot;,SettleAmountBBAmtComm,Settlement_AmountDuetoCashOutBuybackComm,FlagSettleAmountBBAmtComm);
		Functions.WriteResultToReport(file,&quot;Settle Amt - Total=Equivalent&quot;,SettleAmountTotal,Settlement_Equivalent,FlagSettleAmountTotal);
      }

	/* CHECK DATA WITH Cash Out Win Loss REPORT
	 * Cash Out Times &lt;=&gt; Cash Out Times, Cash Out Tickets &lt;=&gt; Cash Out Tickets, Cash Out Value &lt;=&gt; Cash Out Value, Buy Back Amount - Total &lt;=&gt; Buy Back Amount - Total, Ticket Payout &lt;=&gt; Ticket Payout, Cash Out Commission &lt;=&gt; Cash Out Commission, Settle Amount - Total &lt;=&gt; max(IncomeAOnBBAmt+AmountDuetoCashOutAOnBBAmt, IncomeBOnProfitSharing+AmountDuetoCashOutBOnProfitSharing);
	 * 
	 */
	//Get Index of Cash Out Win Loss Data Row that LAP-Cash Out Win Loss Win Loss report need to compare with
	int CODataRowIndex = 0;
	strCompareDataWithReport = &quot;Cash Out Win Loss, ${Licensee}, ${PartyId}, ${ProductName}&quot;;
	for(int j = 0;j&lt;vars.getObject(&quot;sheet&quot;).size();j++) {
		String RowData = vars.getObject(&quot;sheet&quot;).get(j).toString();
		if(RowData.indexOf(strCompareDataWithReport)&gt;=1){
			log.info(strCompareDataWithReport+&quot;: -&gt; &quot;+j.toString());
			CODataRowIndex = j;
			break;
		}
      }

	
	//Get Data from Settlement Data Row
      if(CODataRowIndex&gt;0){
      	
		String Settlement_CashOutTimes = vars.getObject(&quot;sheet&quot;).get(CODataRowIndex).get(16).toString();
		String Settlement_CashOutTickets = vars.getObject(&quot;sheet&quot;).get(CODataRowIndex).get(17).toString();
		String Settlement_CashOutValue = vars.getObject(&quot;sheet&quot;).get(CODataRowIndex).get(18).toString();
		String Settlement_BuybackAmountTotal = vars.getObject(&quot;sheet&quot;).get(CODataRowIndex).get(19).toString();
		String Settlement_TicketsPayout = vars.getObject(&quot;sheet&quot;).get(CODataRowIndex).get(20).toString();
		String Settlement_CashOutCommission = vars.getObject(&quot;sheet&quot;).get(CODataRowIndex).get(21).toString();
		String Settlement_IncomeAOnBBAmt = vars.getObject(&quot;sheet&quot;).get(CODataRowIndex).get(31).toString();
		String Settlement_AmountDuetoCashOutAOnBBAmt = vars.getObject(&quot;sheet&quot;).get(CODataRowIndex).get(33).toString();
		String Settlement_IncomeBOnProfitSharing = vars.getObject(&quot;sheet&quot;).get(CODataRowIndex).get(32).toString();
		String Settlement_AmountDuetoCashOutBOnProfitSharing = vars.getObject(&quot;sheet&quot;).get(CODataRowIndex).get(34).toString();
		
		String FlagCashOutTimes = Functions.returnStatusFormat(&quot;Fail&quot;);
		String FlagCashOutTickets = Functions.returnStatusFormat(&quot;Fail&quot;);
		String FlagCashOutValue = Functions.returnStatusFormat(&quot;Fail&quot;);
		String FlagBuyBackAmountTotal = Functions.returnStatusFormat(&quot;Fail&quot;);
		String FlagTicketPayout = Functions.returnStatusFormat(&quot;Fail&quot;);
		String FlagCashOutCommission = Functions.returnStatusFormat(&quot;Fail&quot;);
		String FlagSettleAmountTotal = Functions.returnStatusFormat(&quot;Fail&quot;);

		if(Math.abs(Functions.ConvertStringToFloat(Settlement_CashOutTimes) - Functions.ConvertStringToFloat(CashOutTimes))&lt;0.2){
			FlagCashOutTimes = Functions.returnStatusFormat(&quot;Pass&quot;);
		}else{
			AssertionResult.setFailure(true);
		}
		if(Math.abs(Functions.ConvertStringToFloat(Settlement_CashOutTickets) - Functions.ConvertStringToFloat(CashOutTickets))&lt;0.2){
			FlagCashOutTickets = Functions.returnStatusFormat(&quot;Pass&quot;);
		}else{
			AssertionResult.setFailure(true);
		}
		if(Math.abs(Functions.ConvertStringToFloat(Settlement_CashOutValue) - Functions.ConvertStringToFloat(CashOutValue))&lt;0.2){
			FlagCashOutValue = Functions.returnStatusFormat(&quot;Pass&quot;);
		}else{
			AssertionResult.setFailure(true);
		}

		if(Math.abs(Functions.ConvertStringToFloat(Settlement_BuybackAmountTotal) - Functions.ConvertStringToFloat(BuyBackAmountTotal))&lt;0.2){
			FlagBuyBackAmountTotal = Functions.returnStatusFormat(&quot;Pass&quot;);
		}else{
			AssertionResult.setFailure(true);
		}


		if(Math.abs(Functions.ConvertStringToFloat(Settlement_TicketsPayout) - Functions.ConvertStringToFloat(TicketPayout))&lt;0.2){
			FlagTicketPayout = Functions.returnStatusFormat(&quot;Pass&quot;);
		}else{
			AssertionResult.setFailure(true);
		}
		if(Math.abs(Functions.ConvertStringToFloat(Settlement_CashOutCommission) - Functions.ConvertStringToFloat(CashOutCommission))&lt;0.2){
			FlagCashOutCommission = Functions.returnStatusFormat(&quot;Pass&quot;);
		}else{
			AssertionResult.setFailure(true);
		}

		float Tmp = Math.max(Functions.ConvertStringToFloat(Settlement_IncomeAOnBBAmt)+Functions.ConvertStringToFloat(Settlement_AmountDuetoCashOutAOnBBAmt),Functions.ConvertStringToFloat(Settlement_IncomeBOnProfitSharing)+Functions.ConvertStringToFloat(Settlement_AmountDuetoCashOutBOnProfitSharing));
		if(Math.abs(Functions.ConvertStringToFloat(SettleAmountTotal) - Tmp)&lt;0.2){
			FlagSettleAmountTotal = Functions.returnStatusFormat(&quot;Pass&quot;);
		}else{
			AssertionResult.setFailure(true);
		}

		File file = new File(path + &quot;/&quot;+&quot;${glb_Report_CheckMonthlyBilling_File}&quot;);
		
		Functions.WriteHeaderToReport(file,&quot;${Licensee}&quot;, &quot;${Report}&quot;, &quot;Cash Out Win Loss&quot;);

		Functions.WriteResultToReport(file,&quot;Cash Out Times&quot;,CashOutTimes,Settlement_CashOutTimes,FlagCashOutTimes);
		Functions.WriteResultToReport(file,&quot;Cash Out Tickets&quot;,CashOutTickets,Settlement_CashOutTickets,FlagCashOutTickets);
		Functions.WriteResultToReport(file,&quot;Cash Out Value&quot;,CashOutValue,Settlement_CashOutValue,FlagCashOutValue);
		Functions.WriteResultToReport(file,&quot;Buyback Amt - Total&quot;,BuyBackAmountTotal,Settlement_BuybackAmountTotal,FlagBuyBackAmountTotal);
		Functions.WriteResultToReport(file,&quot;Tickets Payout&quot;,TicketPayout,Settlement_TicketsPayout,FlagTicketPayout);
		Functions.WriteResultToReport(file,&quot;Cash Out Commission&quot;,CashOutCommission,Settlement_CashOutCommission,FlagCashOutCommission);
		Functions.WriteResultToReport(file,&quot;Settle Amt Total&quot;,SettleAmountTotal,Tmp.toString(),FlagSettleAmountTotal);
      }
      
}
</stringProp>
                <stringProp name="scriptLanguage">groovy</stringProp>
              </JSR223Assertion>
              <hashTree/>
            </hashTree>
          </hashTree>
          <IfController guiclass="IfControllerPanel" testclass="IfController" testname="IF LICENSEE PERFORMANCE IN DETAILS" enabled="true">
            <stringProp name="IfController.condition">&quot;${Report}&quot;==&quot;Licensee Performance in Details&quot;</stringProp>
            <boolProp name="IfController.evaluateAll">false</boolProp>
          </IfController>
          <hashTree>
            <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="Performance_Licensee Performance in Details_Load_${Licensee}_${ProductName}" enabled="true">
              <elementProp name="HTTPsampler.Arguments" elementType="Arguments" guiclass="HTTPArgumentsPanel" testclass="Arguments" testname="User Defined Variables" enabled="true">
                <collectionProp name="Arguments.arguments"/>
              </elementProp>
              <stringProp name="HTTPSampler.domain">${glb_ServerName}</stringProp>
              <stringProp name="HTTPSampler.port">${glb_Port}</stringProp>
              <stringProp name="HTTPSampler.protocol">${glb_Protocol}</stringProp>
              <stringProp name="HTTPSampler.contentEncoding">utf-8</stringProp>
              <stringProp name="HTTPSampler.path">${glb_URLFolder}/Report/PerformanceDetail/Main</stringProp>
              <stringProp name="HTTPSampler.method">GET</stringProp>
              <boolProp name="HTTPSampler.follow_redirects">true</boolProp>
              <boolProp name="HTTPSampler.auto_redirects">false</boolProp>
              <boolProp name="HTTPSampler.use_keepalive">true</boolProp>
              <boolProp name="HTTPSampler.DO_MULTIPART_POST">false</boolProp>
              <stringProp name="HTTPSampler.embedded_url_re"></stringProp>
              <stringProp name="HTTPSampler.connect_timeout"></stringProp>
              <stringProp name="HTTPSampler.response_timeout"></stringProp>
            </HTTPSamplerProxy>
            <hashTree>
              <HeaderManager guiclass="HeaderPanel" testclass="HeaderManager" testname="HTTP Header Manager" enabled="true">
                <collectionProp name="HeaderManager.headers">
                  <elementProp name="Accept-Language" elementType="Header">
                    <stringProp name="Header.name">Accept-Language</stringProp>
                    <stringProp name="Header.value">en-US,vi-VN;q=0.8,vi;q=0.5,en;q=0.3</stringProp>
                  </elementProp>
                  <elementProp name="Accept" elementType="Header">
                    <stringProp name="Header.name">Accept</stringProp>
                    <stringProp name="Header.value">text/html,application/xhtml+xml,application/xml;q=0.9,*/*;q=0.8</stringProp>
