            <stringProp name="IfController.condition">&quot;${Report}&quot;==&quot;Create Invoice&quot;</stringProp>
            <boolProp name="IfController.evaluateAll">false</boolProp>
          </IfController>
          <hashTree>
            <IncludeController guiclass="IncludeControllerGui" testclass="IncludeController" testname="Init" enabled="false">
              <stringProp name="IncludeController.includepath">Init.jmx</stringProp>
