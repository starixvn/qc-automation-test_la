          <stringProp name="cacheKey"></stringProp>
          <stringProp name="script">import com.google.api.client.auth.oauth2.Credential;
import com.google.api.client.googleapis.auth.oauth2.GoogleCredential;
import com.google.api.services.sheets.v4.SheetsScopes;
import com.google.api.client.googleapis.javanet.GoogleNetHttpTransport;
import com.google.api.client.json.jackson2.JacksonFactory;
import com.google.api.services.sheets.v4.Sheets;
import com.google.api.services.sheets.v4.SheetsRequestInitializer;


import java.nio.file.Files;
import java.nio.file.Paths;
import java.util.Arrays;
import java.util.List;

import org.apache.jmeter.services.FileServer;

def path = FileServer.getFileServer().getBaseDir();

/*CREATE REPORT FILE TO SEND MAIL*/
File file2 = new File(path + &quot;/&quot;+&quot;${glb_Report_CheckMonthlyBilling_Fails}&quot;);
file2.delete();
File file = new File(path + &quot;/&quot;+&quot;${glb_Report_CheckMonthlyBilling_File}&quot;);
file.delete();
//write stylesheet
file2.append (&quot;&lt;style&gt;.TableBorderStyleStatus{width:100px;float:left;text-align: center;border-bottom: 2px solid #DCDCDC;border-left: 2px solid #DCDCDC;}.TableBorderStyleHeaderStatus{width:100px;float:left;font-weight: bold;text-align: center;border-bottom: 2px solid #DCDCDC;border-left: 2px solid #DCDCDC;}.TableBorderStyleHeaderValue{width:300px;float:left;font-weight: bold;text-align: center;border-bottom: 2px solid #DCDCDC;border-left: 2px solid #DCDCDC;}.TableBorderStyleValue{width:300px;float:left;text-align: center;border-bottom: 2px solid #DCDCDC;border-left: 2px solid #DCDCDC;}.TableBorderStyleDataProperty{width:300px;float:left;font-weight: bold;border-bottom: 2px solid #DCDCDC;}.TableBorderStyleHeader{width:1006px;font-weight: bold;border-bottom: 2px solid #DCDCDC;}.TableBorderStyleBody{width:1006px;float:left;border-top: 2px solid #DCDCDC;border-left: 2px solid #DCDCDC;border-right: 2px solid #DCDCDC;}.TableBorderTryCatchErrorCode{width:1006px;font-weight: bold;border-bottom: 2px solid #DCDCDC;text-align:center}&lt;/style&gt;&quot;);
//write Data Frame
file2.append (&quot;&lt;h1&gt;Check Data from &quot;+&quot;${glb_FirstDateofPrevMonth_2}&quot;+&quot; to &quot;+&quot;${glb_LastDateofPrevMonth_2}&quot;+&quot;&lt;/h1&gt;&quot;);
//file2.append (&quot;&lt;h3&gt;Steps:&lt;/h3&gt;&quot;);
//file2.append (&quot;&lt;span&gt;1. Settlement Report (LA) vs Specific Report (LA)&lt;/span&gt;&lt;br&gt;&quot;);
//file2.append (&quot;&lt;span&gt;2. Settlement Report (LA) vs Licensee WL Report (LAP)&lt;/span&gt;&lt;br&gt;&quot;);
//file2.append (&quot;&lt;span&gt;3. Settlement Report (LA) vs Specific Report (LAP)&lt;/span&gt;&lt;br&gt;&quot;);
//file2.append (&quot;&lt;span&gt;4. Specific Report (LA) vs Specific Report (LAP)&lt;/span&gt;&lt;br&gt;&quot;);
//file2.append (&quot;&lt;span&gt;5. Specific Report (LA), Settlement Report (LA) vs Create Invoice (LA)&lt;/span&gt;&lt;br&gt;&quot;);
//file2.append (&quot;&lt;span&gt;6. Specific Report (LA) vs LPID (LA)&lt;/span&gt;&lt;br&gt;&quot;);
file.append (&quot;&lt;div class=&apos;TableBorderStyleBody&apos;&gt;&quot;);
/*====================*/

//String CleanTestingDataScript = new File(path+&apos;/CreateTestingData/CleanTestingDataScript.sql&apos;).text;


GoogleCredential credential = GoogleCredential.fromStream(Files.newInputStream(Paths.get(path+&quot;/client_secret.json&quot;))).createScoped(Arrays.asList(SheetsScopes.DRIVE));

Sheets.Spreadsheets spreadsheets = new Sheets.Builder(GoogleNetHttpTransport.newTrustedTransport(),JacksonFactory.getDefaultInstance(),credential).setApplicationName(&quot; &quot;).build().spreadsheets();
                    
vars.putObject(&quot;spreadsheets&quot;, spreadsheets);

List&lt;List&lt;Object&gt;&gt; sheet = spreadsheets.values().get(&quot;${glb_LABillingLicensees_GoogleSpreadSheetID}&quot;, &quot;Licensees&quot;).setMajorDimension(&quot;ROWS&quot;).setValueRenderOption(&quot;UNFORMATTED_VALUE&quot;).setDateTimeRenderOption(&quot;FORMATTED_STRING&quot;).execute().getValues();  

                                    
vars.putObject(&quot;sheet&quot;, sheet);
//log.info(&quot;william --- &quot;+vars.getObject(&quot;sheet&quot;).get(0).toString());



