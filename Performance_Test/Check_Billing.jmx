          <hashTree/>
          <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="JSR223 PreProcessor" enabled="false">
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="cacheKey"></stringProp>
            <stringProp name="script">int i = Integer.parseInt(vars.get(&quot;counter&quot;));
log.info(&quot;william : &quot;+i.toString());
if(vars.getObject(&quot;sheet&quot;).get(i).size() != 0) {	
     vars.put(&quot;Report&quot;, vars.getObject(&quot;sheet&quot;).get(i).get(0).toString());
     
     vars.put(&quot;Licensee&quot;, vars.getObject(&quot;sheet&quot;).get(i).get(1).toString());
     vars.put(&quot;PartyId&quot;, vars.getObject(&quot;sheet&quot;).get(i).get(2).toString());
     vars.put(&quot;ProductName&quot;, vars.getObject(&quot;sheet&quot;).get(i).get(3).toString());
     log.info(&quot;william --- &quot;+vars.get(&quot;Report&quot;).toString()+&quot; --- &quot;+vars.getObject(&quot;sheet&quot;).get(i).get(3).toString());
     vars.put(&quot;ProductCode&quot;, vars.getObject(&quot;sheet&quot;).get(i).get(4).toString());
     vars.put(&quot;BaseCurrency&quot;, vars.getObject(&quot;sheet&quot;).get(i).get(5).toString());
     vars.put(&quot;BaseCurrencyName&quot;, vars.getObject(&quot;sheet&quot;).get(i).get(6).toString());
     vars.put(&quot;CurrencyID&quot;, vars.getObject(&quot;sheet&quot;).get(i).get(7).toString());
}
</stringProp>
          </JSR223PreProcessor>
          <hashTree/>
          <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="Get Setting From Google SpreadSheet" enabled="true">
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="cacheKey"></stringProp>
            <stringProp name="script">int i = Integer.parseInt(vars.get(&quot;counter&quot;));
log.info(&quot;william : &quot;+i.toString());
vars.put(&quot;GoogleSheetHeader&quot;, vars.getObject(&quot;sheet&quot;).get(0).toString());

if(vars.getObject(&quot;sheet&quot;).get(i).size() != 0) {	
     vars.put(&quot;Report&quot;, vars.getObject(&quot;sheet&quot;).get(i).get(0).toString());

     vars.put(&quot;Licensee&quot;, vars.getObject(&quot;sheet&quot;).get(i).get(1).toString());
     
     vars.put(&quot;ProductName&quot;, vars.getObject(&quot;sheet&quot;).get(i).get(3).toString());
     log.info(&quot;william --- &quot;+vars.getObject(&quot;sheet&quot;).get(i).toString());
     
     vars.put(&quot;ProductCode&quot;, vars.getObject(&quot;sheet&quot;).get(i).get(4).toString());
     vars.put(&quot;BaseCurrency&quot;, vars.getObject(&quot;sheet&quot;).get(i).get(5).toString());
     vars.put(&quot;BaseCurrencyName&quot;, vars.getObject(&quot;sheet&quot;).get(i).get(6).toString());
     vars.put(&quot;CurrencyID&quot;, vars.getObject(&quot;sheet&quot;).get(i).get(7).toString());

	String PartyId = vars.getObject(&quot;sheet&quot;).get(i).get(2).toString();
	if(PartyId.indexOf(&quot;,&quot;)&gt;=0){
		String[] strarr;
      	strarr = PartyId.split(&apos;,&apos;);
      	vars.put(&quot;PartyId&quot;, strarr[0].toString().trim());
      	vars.put(&quot;LicenseeId&quot;, strarr[1].toString().trim());
	}else{
		vars.put(&quot;PartyId&quot;, PartyId);
	}

	String ProductName = vars.getObject(&quot;sheet&quot;).get(i).get(3).toString();
	if(ProductName==&quot;BA&quot;){
		vars.put(&quot;DrawFilter&quot;, &quot;2&quot;);
	}else{
		vars.put(&quot;DrawFilter&quot;, &quot;1&quot;);
	}
}
</stringProp>
          </JSR223Sampler>
