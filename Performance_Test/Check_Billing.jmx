              <hashTree/>
              <JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="Save Data From Report To Google SpreadSheet and Compare with LA-Spcefic Reports" enabled="true">
                <stringProp name="cacheKey"></stringProp>
                <stringProp name="filename"></stringProp>
                <stringProp name="parameters"></stringProp>
                <stringProp name="script">import com.google.api.services.sheets.v4.model.ValueRange;
import com.google.api.services.sheets.v4.model.BatchUpdateValuesRequest;
import java.util.regex.Matcher;
import java.util.regex.Pattern;
import java.nio.file.Files;
import java.nio.file.Paths;
import org.apache.jmeter.services.FileServer;
import groovy.json.JsonSlurper

def path = FileServer.getFileServer().getBaseDir();
/*Load Common Functions - Start*/
ClassLoader parent = getClass().getClassLoader();
GroovyClassLoader loader = new GroovyClassLoader(parent);
Class groovyClass = loader.parseClass(new File(path + &quot;/&quot;+&quot;Functions.groovy&quot;));
GroovyObject Functions  = (GroovyObject) groovyClass.newInstance();
/*Load Common Functions - End*/

int i = Integer.parseInt(vars.get(&quot;counter&quot;));

List&lt;List&lt;Object&gt;&gt; sheet = vars.getObject(&quot;spreadsheets&quot;).values().get(&quot;${glb_LABillingLicensees_GoogleSpreadSheetID}&quot;, &quot;Licensees&quot;).setMajorDimension(&quot;ROWS&quot;).setValueRenderOption(&quot;UNFORMATTED_VALUE&quot;).setDateTimeRenderOption(&quot;FORMATTED_STRING&quot;).execute().getValues();                                     
vars.putObject(&quot;sheet&quot;, sheet);

if (vars.getObject(&quot;sheet&quot;).get(i).size() != 0) {
		
	String LicensingFee = &quot;${Licensing Fee}&quot;;

	if(&quot;${Licensing Fee - Negative}&quot;!=&quot;Not_Found&quot;){
		LicensingFee = &quot;${Licensing Fee - Negative}&quot;;
	}
	
	List&lt;ValueRange&gt; list = Arrays.asList(
      new ValueRange().setRange(&quot;Licensees!Y&quot; + (i + 1) + &quot;:Y&quot; + (i + 1)).setValues(Arrays.asList(Arrays.asList(LicensingFee)))
      );     

	vars.getObject(&quot;spreadsheets&quot;).values().batchUpdate(&quot;${glb_LABillingLicensees_GoogleSpreadSheetID}&quot;,
                    new BatchUpdateValuesRequest().setData(list).setValueInputOption(&quot;RAW&quot;))
                    .execute();

	/* CHECK DATA WITH LA Specific REPORTs
	 * LicensingFee
	 * 
	 */
	//Get Index of Data Row that Licensee Performance in Details report need to compare with
	String strReport = Functions.getLAReportNameFromProductName(&quot;${ProductName}&quot;);
	String strCompareDataWithReport = strReport+&quot;, ${Licensee}, ${PartyId}, ${ProductName}&quot;;
	int DataRowIndex = 0;
	
	for(int j = 0;j&lt;vars.getObject(&quot;sheet&quot;).size();j++) {
		String RowData = vars.getObject(&quot;sheet&quot;).get(j).toString();
		if(RowData.indexOf(strCompareDataWithReport)&gt;=1){
			log.info(strCompareDataWithReport+&quot;: -&gt; &quot;+j.toString());
			DataRowIndex = j;
			break;
		}
      }

	
	//Get Data from Settlement Data Row
      if(DataRowIndex&gt;0){
		String Specific_LicensingFee = vars.getObject(&quot;sheet&quot;).get(DataRowIndex).get(24).toString();
		switch (&quot;${ProductName}&quot;) {
		   
		   case &quot;Cash Out&quot;:
		       //String Specific_CustomerChargeComm = vars.getObject(&quot;sheet&quot;).get(DataRowIndex).get(27).toString();//get from Customer Charge Comm
		       String IncomeAOnBBAmt = vars.getObject(&quot;sheet&quot;).get(DataRowIndex).get(31).toString();
			  String IncomeBOnProfitSharing = vars.getObject(&quot;sheet&quot;).get(DataRowIndex).get(32).toString();
			  String AmountDuetoCashOutAOnBBAmt = vars.getObject(&quot;sheet&quot;).get(DataRowIndex).get(33).toString();
			  String AmountDuetoCashOutBOnProfitSharing = vars.getObject(&quot;sheet&quot;).get(DataRowIndex).get(34).toString();
		       float tmpLicensingFee = Math.max(Functions.ConvertStringToFloat(IncomeAOnBBAmt)+Functions.ConvertStringToFloat(AmountDuetoCashOutAOnBBAmt), Functions.ConvertStringToFloat(IncomeBOnProfitSharing)+Functions.ConvertStringToFloat(AmountDuetoCashOutBOnProfitSharing));
		       Specific_LicensingFee = tmpLicensingFee.toString();
		       break;
		}

		

		String FlagLicensingFee = Functions.returnStatusFormat(&quot;Fail&quot;);

		if(Math.abs(Functions.ConvertStringToFloat(Specific_LicensingFee,true) - Functions.ConvertStringToFloat(LicensingFee,true))&lt;0.2){
			FlagLicensingFee = Functions.returnStatusFormat(&quot;Pass&quot;);
		}else{
			AssertionResult.setFailure(true);
		}
		
		File file = new File(path + &quot;/&quot;+&quot;${glb_Report_CheckMonthlyBilling_File}&quot;);
		
		Functions.WriteHeaderToReport(file,&quot;${Licensee}&quot;, &quot;${Report}&quot;, strReport);

		Functions.WriteResultToReport(file,&quot;LicensingFee-${ProductCode}&quot;,LicensingFee,Specific_LicensingFee,FlagLicensingFee);
      }            
}
	
</stringProp>
                <stringProp name="scriptLanguage">groovy</stringProp>
              </JSR223Assertion>
              <hashTree/>
            </hashTree>
          </hashTree>
          <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="Increase Counter" enabled="true">
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="cacheKey"></stringProp>
            <stringProp name="script">import com.google.api.services.sheets.v4.model.ValueRange;
import com.google.api.services.sheets.v4.model.BatchUpdateValuesRequest;
import java.util.regex.Matcher;
import java.util.regex.Pattern;

int i = Integer.parseInt(vars.get(&quot;counter&quot;));

if (i + 1 == vars.getObject(&quot;sheet&quot;).size()) {
	vars.put(&quot;stopWhile&quot;,&quot;OK&quot;);
}</stringProp>
          </JSR223Sampler>
          <hashTree/>
        </hashTree>
      </hashTree>
