                <stringProp name="XPathExtractor.default">Not_Found</stringProp>
                <stringProp name="XPathExtractor.refname">Licensing fee</stringProp>
                <stringProp name="XPathExtractor.matchNumber">-1</stringProp>
                <stringProp name="XPathExtractor.xpathQuery">//td[contains(text(),&apos;Total in&apos;)]/following::td[7]</stringProp>
