                <stringProp name="RegexExtractor.refname">PartyData</stringProp>
                <stringProp name="RegexExtractor.regex">id=&quot;PartyData&quot; name=&quot;PartyData&quot; type=&quot;hidden&quot; value=&quot;(.+?)&quot;</stringProp>
                <stringProp name="RegexExtractor.template">$1$</stringProp>
