                <stringProp name="XPathExtractor.default">Not_Found</stringProp>
                <stringProp name="XPathExtractor.refname">Licensing Fee - Negative</stringProp>
                <stringProp name="XPathExtractor.matchNumber">-1</stringProp>
                <stringProp name="XPathExtractor.xpathQuery">//span[@class=&apos;item-amount-text&apos;]/span</stringProp>
