              <hashTree/>
              <JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="Save Data Colossus Bet Win Loss To Google SpreadSheet And Compare Data with Settlement Report" enabled="true">
                <stringProp name="cacheKey"></stringProp>
                <stringProp name="filename"></stringProp>
                <stringProp name="parameters"></stringProp>
                <stringProp name="script">import com.google.api.services.sheets.v4.model.ValueRange;
import com.google.api.services.sheets.v4.model.BatchUpdateValuesRequest;
import java.util.regex.Matcher;
import java.util.regex.Pattern;
import java.nio.file.Files;
import java.nio.file.Paths;
import org.apache.jmeter.services.FileServer;

def path = FileServer.getFileServer().getBaseDir();
/*Load Common Functions - Start*/
ClassLoader parent = getClass().getClassLoader();
GroovyClassLoader loader = new GroovyClassLoader(parent);
Class groovyClass = loader.parseClass(new File(path + &quot;/&quot;+&quot;Functions.groovy&quot;));
GroovyObject Functions  = (GroovyObject) groovyClass.newInstance();
/*Load Common Functions - End*/

int i = Integer.parseInt(vars.get(&quot;counter&quot;));

List&lt;List&lt;Object&gt;&gt; sheet = vars.getObject(&quot;spreadsheets&quot;).values().get(&quot;${glb_LABillingLicensees_GoogleSpreadSheetID}&quot;, &quot;Licensees&quot;).setMajorDimension(&quot;ROWS&quot;).setValueRenderOption(&quot;UNFORMATTED_VALUE&quot;).setDateTimeRenderOption(&quot;FORMATTED_STRING&quot;).execute().getValues();                                     
vars.putObject(&quot;sheet&quot;, sheet);

if (vars.getObject(&quot;sheet&quot;).get(i).size() != 0) {
	String MemberWinAmountPrize = &quot;${Member Win Amount - Prize}&quot;;
	String Turnover = &quot;${Turnover}&quot;;
	String TotalTrans = &quot;${Total Trans}&quot;;
	String MemberWinAmountCashOut = &quot;${Member Win Amount - Cash Out}&quot;;
	List&lt;ValueRange&gt; list = Arrays.asList(
      new ValueRange().setRange(&quot;Licensees!I&quot; + (i + 1) + &quot;:K&quot; + (i + 1)).setValues(Arrays.asList(Arrays.asList(Turnover,TotalTrans))),
      new ValueRange().setRange(&quot;Licensees!AD&quot; + (i + 1) + &quot;:AE&quot; + (i + 1)).setValues(Arrays.asList(Arrays.asList(MemberWinAmountPrize,MemberWinAmountCashOut)))
      );     

	vars.getObject(&quot;spreadsheets&quot;).values().batchUpdate(&quot;${glb_LABillingLicensees_GoogleSpreadSheetID}&quot;,
                    new BatchUpdateValuesRequest().setData(list).setValueInputOption(&quot;RAW&quot;))
                    .execute();
	/* CHECK DATA WITH SETTLEMENT REPORT
	 * Turnover &lt;=&gt; Turnover, Total Trans &lt;=&gt; Total Trans, Member Win Amount - Prize &lt;=&gt; Member Winning, Member Win Amount - Cash Out &lt;=&gt; Cash-out Amt
	 * 
	 */
	//Get Index of Settlement Data Row that Colossus Bet Win Loss report need to compare with
	int SettlementDataRowIndex = 0;
	String strCompareDataWithReport = &quot;Settlement Report, ${Licensee}, ${PartyId}, ${ProductName}&quot;;
	for(int j = 0;j&lt;vars.getObject(&quot;sheet&quot;).size();j++) {
		String RowData = vars.getObject(&quot;sheet&quot;).get(j).toString();
		if(RowData.indexOf(strCompareDataWithReport)&gt;=1){
			log.info(strCompareDataWithReport+&quot;: -&gt; &quot;+j.toString());
			SettlementDataRowIndex = j;
			break;
		}
      }

	
	//Get Data from Settlement Data Row
      if(SettlementDataRowIndex&gt;0){
      	String Settlement_MemberWinning = vars.getObject(&quot;sheet&quot;).get(SettlementDataRowIndex).get(12).toString();
		String Settlement_Turnover = vars.getObject(&quot;sheet&quot;).get(SettlementDataRowIndex).get(8).toString();
		String Settlement_TotalTrans = vars.getObject(&quot;sheet&quot;).get(SettlementDataRowIndex).get(9).toString();
		String Settlement_CashoutAmt = vars.getObject(&quot;sheet&quot;).get(SettlementDataRowIndex).get(13).toString();
		
		String FlagTurnOver = Functions.returnStatusFormat(&quot;Fail&quot;);
		String FlagTotalTrans = Functions.returnStatusFormat(&quot;Fail&quot;);
		String FlagCashoutAmt = Functions.returnStatusFormat(&quot;Fail&quot;);
		String FlagMemberWinning = Functions.returnStatusFormat(&quot;Fail&quot;);

		
		if(Math.abs(Functions.ConvertStringToFloat(Settlement_Turnover) - Functions.ConvertStringToFloat(Turnover))&lt;0.2){
			FlagTurnOver = Functions.returnStatusFormat(&quot;Pass&quot;);
		}else{
			AssertionResult.setFailure(true);
		}
		if(Math.abs(Functions.ConvertStringToFloat(Settlement_TotalTrans) - Functions.ConvertStringToFloat(TotalTrans))&lt;0.2){
			FlagTotalTrans = Functions.returnStatusFormat(&quot;Pass&quot;);
		}else{
			AssertionResult.setFailure(true);
		}
		if(Math.abs(Functions.ConvertStringToFloat(Settlement_MemberWinning) - Functions.ConvertStringToFloat(MemberWinAmountPrize))&lt;0.2){
			FlagMemberWinning = Functions.returnStatusFormat(&quot;Pass&quot;);
		}else{
			AssertionResult.setFailure(true);
		}
		if(Math.abs(Functions.ConvertStringToFloat(Settlement_CashoutAmt) - Functions.ConvertStringToFloat(MemberWinAmountCashOut))&lt;0.2){
			FlagCashoutAmt = Functions.returnStatusFormat(&quot;Pass&quot;);
		}else{
			AssertionResult.setFailure(true);
		}

		File file = new File(path + &quot;/&quot;+&quot;${glb_Report_CheckMonthlyBilling_File}&quot;);
		
		Functions.WriteHeaderToReport(file,&quot;${Licensee}&quot;, &quot;${Report}&quot;, &quot;Settlement Report&quot;);

		Functions.WriteResultToReport(file,&quot;TotalTrans&quot;,TotalTrans,Settlement_TotalTrans,FlagTotalTrans);
		Functions.WriteResultToReport(file,&quot;Turnover&quot;,Turnover,Settlement_Turnover,FlagTurnOver);
		Functions.WriteResultToReport(file,&quot;Member Win Amt - Prize&quot;,MemberWinAmountPrize,Settlement_MemberWinning,FlagMemberWinning);
		Functions.WriteResultToReport(file,&quot;Member Win Amt - CO&quot;,MemberWinAmountCashOut,Settlement_CashoutAmt,FlagCashoutAmt);
		
      }

      
}

</stringProp>
