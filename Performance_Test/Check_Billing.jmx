                <stringProp name="script">Boolean EnableDurationAssertion = &apos;${glb_EnableDurationAssertion}&apos;.toBoolean();
if(EnableDurationAssertion==true){
	long ExpectedDuration = 688;//Expected Load Time of Function
	long LoadTime = prev.getTime();
	if(ExpectedDuration &lt; LoadTime){
		AssertionResult.setFailureMessage(&quot;It took &quot;+LoadTime.toString()+&quot; milliseconds, but should not have lasted longer than &quot;+ExpectedDuration.toString()+&quot; milliseconds.&quot;);
		AssertionResult.setFailure(true);
	}
}
