              <stringProp name="parameters"></stringProp>
              <stringProp name="filename"></stringProp>
              <stringProp name="cacheKey"></stringProp>
              <stringProp name="script">&quot;If it fails please check JSR223 Assertion for more details !!!&quot;</stringProp>
            </JSR223Sampler>
            <hashTree>
              <JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="JSR223 Assertion" enabled="true">
                <stringProp name="scriptLanguage">groovy</stringProp>
                <stringProp name="parameters"></stringProp>
                <stringProp name="filename"></stringProp>
                <stringProp name="cacheKey"></stringProp>
                <stringProp name="script">import org.apache.poi.ss.usermodel.*;
import java.io.*;
import java.util.regex.Matcher;
import java.util.regex.Pattern;
import java.nio.file.Files;
import java.nio.file.Paths;
import org.apache.jmeter.services.FileServer;

def path = FileServer.getFileServer().getBaseDir();
/*Load Common Functions - Start*/
ClassLoader parent = getClass().getClassLoader();
GroovyClassLoader loader = new GroovyClassLoader(parent);
Class groovyClass = loader.parseClass(new File(path + &quot;/&quot;+&quot;Functions.groovy&quot;));
GroovyObject Functions  = (GroovyObject) groovyClass.newInstance();
/*Load Common Functions - End*/
def pathReport =  path+&quot;/Excel Report/Bet Trade Win Loss.xlsx&quot;;
def pathExist = new File(pathReport)
def book;
for(def i=0;i&lt;10;i++)
{
	if(pathExist.exists()){
		book = WorkbookFactory.create(new File(pathReport));	
		break;
	} else {sleep(1000)}
}

int d = book.getSheetAt(0).getLastRowNum();
log.info &quot;--------------------------------------&quot;
log.info d.toString();
Row row = book.getSheetAt(0).getRow(d-4);

//Get data from Excel file
	String Excel_TotalTrans = row.getCell(3).toString();
	String Excel_ActualStake = row.getCell(4).toString();
	String Excel_BBackAmtSportsbook = row.getCell(5).toString();
	String Excel_BBackAmtBA = row.getCell(6).toString();
	String Excel_BBackAmtTotal = row.getCell(7).toString();
	String Excel_WLBBackAmt = row.getCell(8).toString();
	String Excel_WLBoughtTickets = row.getCell(9).toString();
	String Excel_BetTradeComm = row.getCell(10).toString();
	String Excel_ProfitSharing = row.getCell(11).toString();
	String Excel_PaytoSupplier = row.getCell(12).toString();

//Get data from Web
	String TotalTrans = vars.get(&quot;Total Trans&quot;);
	String ActualStake = vars.get(&quot;Actual Stake&quot;);
	String BBackAmtSportsbook = vars.get(&quot;Buy Back Amt Sportsbook&quot;);
	String BBackAmtBA = vars.get(&quot;Buy Back Amt BA&quot;);
	String BBackAmtTotal = vars.get(&quot;Buy Back Amt Total&quot;);
	String WLBBackAmt = vars.get(&quot;Win Loss on Buy Back Amt&quot;);
	String WLBoughtTickets = vars.get(&quot;Win Loss on Bought Tickets&quot;);
	String BetTradeComm = vars.get(&quot;Bet Trade Comm&quot;);
	String ProfitSharing = vars.get(&quot;Profit Sharing&quot;);
	String PaytoSupplier = vars.get(&quot;Pay to Supplier&quot;);

//Compare data between Excel and Web
def FailureMessage =&quot;&quot;
	if(Math.abs(Functions.ConvertStringToFloat(Excel_TotalTrans) - Functions.ConvertStringToFloat(TotalTrans))&gt;0.1){
		FailureMessage+=&quot;Failure!\nTotal Transactions of Excel: &quot;+Excel_TotalTrans +&quot;\nTotal Transactions of Report: &quot;+TotalTrans;
	}
	if(Math.abs(Functions.ConvertStringToFloat(Excel_ActualStake) - Functions.ConvertStringToFloat(ActualStake))&gt;0.1){
		FailureMessage+=&quot;Failure!\nActual Stake of Excel: &quot;+Excel_ActualStake +&quot;\nActual Stake of Report: &quot;+ActualStake;
	}
	if(Math.abs(Functions.ConvertStringToFloat(Excel_BBackAmtSportsbook) - Functions.ConvertStringToFloat(BBackAmtSportsbook))&gt;0.1){
		FailureMessage+=&quot;Failure!\nBuy Back Amt Sportsbook of Excel: &quot;+Excel_BBackAmtSportsbook +&quot;\nBuy Back Amt Sportsbook of Report: &quot;+BBackAmtSportsbook;
	}
	if(Math.abs(Functions.ConvertStringToFloat(Excel_BBackAmtBA) - Functions.ConvertStringToFloat(BBackAmtBA))&gt;0.1){
		FailureMessage+=&quot;Failure!\nBuy Back Amt BA of Excel: &quot;+Excel_BBackAmtBA +&quot;\nBuy Back Amt BA of Report: &quot;+BBackAmtBA;
	}
	if(Math.abs(Functions.ConvertStringToFloat(Excel_BBackAmtTotal) - Functions.ConvertStringToFloat(BBackAmtTotal))&gt;0.1){
		FailureMessage+=&quot;Failure!\nBuy Back Amt Total of Excel: &quot;+Excel_BBackAmtTotal +&quot;\nBuy Back Amt Total of Report: &quot;+BBackAmtTotal;
	}
	if(Math.abs(Functions.ConvertStringToFloat(Excel_WLBBackAmt) - Functions.ConvertStringToFloat(WLBBackAmt))&gt;0.1){
		FailureMessage+=&quot;Failure!\nWin Loss on Buy Back Amt of Excel: &quot;+Excel_WLBBackAmt +&quot;\nWin Loss on Buy Back Amt of Report: &quot;+WLBBackAmt;
	}
	if(Math.abs(Functions.ConvertStringToFloat(Excel_WLBoughtTickets) - Functions.ConvertStringToFloat(WLBoughtTickets))&gt;0.1){
		FailureMessage+=&quot;Failure!\nWin Loss on Bought Tickets of Excel: &quot;+Excel_WLBoughtTickets +&quot;\nWin Loss on Bought Tickets of Report: &quot;+WLBoughtTickets;
	}
	if(Math.abs(Functions.ConvertStringToFloat(Excel_BetTradeComm) - Functions.ConvertStringToFloat(BetTradeComm))&gt;0.1){
		FailureMessage+=&quot;Failure!\nBet Trade Comm of Excel: &quot;+Excel_BetTradeComm +&quot;\nBet Trade Comm of Report: &quot;+BetTradeComm;
	}
	if(Math.abs(Functions.ConvertStringToFloat(Excel_ProfitSharing) - Functions.ConvertStringToFloat(ProfitSharing))&gt;0.1){
		FailureMessage+=&quot;Failure!\nProfit Sharing of Excel: &quot;+Excel_ProfitSharing +&quot;\nProfit Sharing of Report: &quot;+ProfitSharing;
	}
	if(Math.abs(Functions.ConvertStringToFloat(Excel_PaytoSupplier) - Functions.ConvertStringToFloat(PaytoSupplier))&gt;0.1){
		FailureMessage+=&quot;Failure!\nPay to Supplier of Excel: &quot;+Excel_PaytoSupplier +&quot;\nPay to Supplier of Report: &quot;+PaytoSupplier;
	}
	if(FailureMessage!=&quot;&quot;){
		AssertionResult.setFailure(true);
		AssertionResult.setFailureMessage(FailureMessage);
	}</stringProp>
              </JSR223Assertion>
