                    <stringProp name="Header.value">Mozilla/5.0 (Windows NT 6.1; WOW64; rv:43.0) Gecko/20100101 Firefox/43.0</stringProp>
                  </elementProp>
                  <elementProp name="Accept-Encoding" elementType="Header">
