              <hashTree/>
              <JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="Compare Data with Web Report" enabled="false">
                <stringProp name="cacheKey"></stringProp>
                <stringProp name="filename"></stringProp>
                <stringProp name="parameters"></stringProp>
                <stringProp name="script">import org.apache.poi.ss.usermodel.*;
import java.io.*;
import java.util.regex.Matcher;
import java.util.regex.Pattern;
import java.nio.file.Files;
import java.nio.file.Paths;
import org.apache.jmeter.services.FileServer;

def path = FileServer.getFileServer().getBaseDir();
/*Load Common Functions - Start*/
ClassLoader parent = getClass().getClassLoader();
GroovyClassLoader loader = new GroovyClassLoader(parent);
Class groovyClass = loader.parseClass(new File(path + &quot;/&quot;+&quot;Functions.groovy&quot;));
GroovyObject Functions  = (GroovyObject) groovyClass.newInstance();
/*Load Common Functions - End*/

def pathReport =  path+&quot;/Excel Report/Exchange Win Loss.xlsx&quot;;
def book = WorkbookFactory.create(new File(pathReport));	

int d = book.getSheetAt(0).getLastRowNum();
Row row = book.getSheetAt(0).getRow(d-4);	

//Get data from Excel file
	String Excel_TotalTrans = row.getCell(3).toString();
	String Excel_Turnover = row.getCell(4).toString();
	String Excel_CustomerWL = row.getCell(5).toString();
	String Excel_CustomerChargeComm = row.getCell(6).toString();
	String Excel_LicenseeChargeComm = row.getCell(7).toString();
	String Excel_LicensingFee = row.getCell(8).toString();
	String Excel_PaytoSupplier = row.getCell(9).toString();
	String Excel_NetIncome = row.getCell(10).toString();

//Get data from Web
	String TotalTrans = vars.get(&quot;Total Trans&quot;);
	String Turnover = vars.get(&quot;Turnover&quot;);
	
	String CustomerWLP = vars.get(&quot;Customer W/L&quot;);
	String CustomerWLN = vars.get(&quot;Customer W/L - Negative&quot;);
	String CustomerWinLoss = getNotEmptyDataBetween2String(&quot;${CustomerWLP}&quot;,&quot;${CustomerWLN}&quot;);
	
	String CustomerChargeComm = vars.get(&quot;Customer Charge Comm&quot;);
	String LicenseeChargeComm = vars.get(&quot;Licensee Charge Comm&quot;);
	String RacingRevenue = vars.get(&quot;Racing Revenue&quot;);
	String LicensingFee = vars.get(&quot;Licensing fee&quot;);
	String PaytoSupplier = vars.get(&quot;Pay to Supplier&quot;);
	String NetIncome = vars.get(&quot;Net Income&quot;);
	
String getNotEmptyDataBetween2String(String str1, String str2) { 
   if(str1==&quot;&quot;){
   	return str2;
   }else{
   	return str1;
   }
}

//Compare data between Excel and Web
	if(Math.abs(Functions.ConvertStringToFloat(Excel_TotalTrans) - Functions.ConvertStringToFloat(TotalTrans))&gt;0.2){
			AssertionResult.setFailure(true);
			AssertionResult.setFailureMessage(&quot;Failure!\nTotal Transactions of Excel: &quot;+Excel_TotalTrans +&quot;\nTotal Transactions of Report: &quot;+TotalTrans);
	}
	if(Math.abs(Functions.ConvertStringToFloat(Excel_Turnover) - Functions.ConvertStringToFloat(Turnover))&gt;0.2){
			AssertionResult.setFailure(true);
			AssertionResult.setFailureMessage(&quot;Failure!\nTotal Turnover of Excel: &quot;+Excel_Turnover +&quot;\nTotal Turnover of Report: &quot;+Turnover);
	}
	if(Math.abs(Functions.ConvertStringToFloat(Excel_CustomerWL) - Functions.ConvertStringToFloat(CustomerWinLoss))&gt;0.2){
			AssertionResult.setFailure(true);
			AssertionResult.setFailureMessage(&quot;Failure!\nTotal CustomerWL of Excel: &quot;+Excel_CustomerWL +&quot;\nTotal CustomerWL of Report: &quot;+CustomerWinLoss);
	}
	if(Math.abs(Functions.ConvertStringToFloat(Excel_CustomerChargeComm) - Functions.ConvertStringToFloat(CustomerChargeComm))&gt;0.2){
			AssertionResult.setFailure(true);
			AssertionResult.setFailureMessage(&quot;Failure!\nTotal Customer Charge Comm of Excel: &quot;+Excel_CustomerChargeComm +&quot;\nTotal Customer Charge Comm of Report: &quot;+CustomerChargeComm);
	}
	if(Math.abs(Functions.ConvertStringToFloat(Excel_LicenseeChargeComm) - Functions.ConvertStringToFloat(LicenseeChargeComm))&gt;0.2){
			AssertionResult.setFailure(true);
			AssertionResult.setFailureMessage(&quot;Failure!\nTotal Licensee Charge Comm of Excel: &quot;+Excel_LicenseeChargeComm +&quot;\nTotal Licensee Charge Comm of Report: &quot;+LicenseeChargeComm);
	}
	if(Math.abs(Functions.ConvertStringToFloat(Excel_LicensingFee) - Functions.ConvertStringToFloat(LicensingFee))&gt;0.2){
			AssertionResult.setFailure(true);
			AssertionResult.setFailureMessage(&quot;Failure!\nTotal Licensing Fee of Excel: &quot;+Excel_LicensingFee +&quot;\nTotal Licensing Fee of Report: &quot;+LicensingFee);
	}
	if(Math.abs(Functions.ConvertStringToFloat(Excel_PaytoSupplier) - Functions.ConvertStringToFloat(PaytoSupplier))&gt;0.2){
			AssertionResult.setFailure(true);
			AssertionResult.setFailureMessage(&quot;Failure!\nTotal Pay to Supplier of Excel: &quot;+Excel_PaytoSupplier +&quot;\nTotal Pay to Supplier of Report: &quot;+PaytoSupplier);
	}
	if(Math.abs(Functions.ConvertStringToFloat(Excel_NetIncome) - Functions.ConvertStringToFloat(NetIncome))&gt;0.2){
			AssertionResult.setFailure(true);
			AssertionResult.setFailureMessage(&quot;Failure!\nTotal Net Income of Excel: &quot;+Excel_NetIncome +&quot;\nTotal Net Income of Report: &quot;+NetIncome);
	}

	

</stringProp>
                <stringProp name="scriptLanguage">groovy</stringProp>
              </JSR223Assertion>
