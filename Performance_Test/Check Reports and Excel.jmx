	String Billing_SetupFeeP = vars.get(&quot;Billing/Setup Fee&quot;);
	String Billing_SetupFeeN = vars.get(&quot;Billing/Setup Fee - Negative&quot;);
	String Billing_SetupFee = getNotEmptyDataBetween2String(&quot;${Billing_SetupFeeP}&quot;,&quot;${Billing_SetupFeeN}&quot;);
		
	String BalanceCfP = vars.get(&quot;Balance Cf&quot;);
	String BalanceCfN = vars.get(&quot;Balance Cf - Negative&quot;);
	String BalanceCf = getNotEmptyDataBetween2String(&quot;${BalanceCfP}&quot;,&quot;${BalanceCfN}&quot;);

