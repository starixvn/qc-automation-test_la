	if(Math.abs(Functions.ConvertStringToFloat(Excel_LFeeOthersPre) - Functions.ConvertStringToFloat(PreviousOtherProductsFee))&gt;0.1){
		FailureMessage+=&quot;\nPrevious Other Products Fee of Excel: &quot;+Excel_LFeeOthersPre +&quot;\nPrevious Other Products Fee of Report: &quot;+PreviousOtherProductsFee;
