def path = FileServer.getFileServer().getBaseDir();
/*Load Common Functions - Start*/
ClassLoader parent = getClass().getClassLoader();
GroovyClassLoader loader = new GroovyClassLoader(parent);
Class groovyClass = loader.parseClass(new File(path + &quot;/&quot;+&quot;Functions.groovy&quot;));
GroovyObject Functions  = (GroovyObject) groovyClass.newInstance();
/*Load Common Functions - End*/
def pathReport =  path+&quot;/Excel Report/PP Win Loss.xlsx&quot;;
def pathExist = new File(pathReport)
def book;
for(def i=0;i&lt;10;i++)
{
	if(pathExist.exists()){
		book = WorkbookFactory.create(new File(pathReport));	
		break;
	} else {sleep(1000)}
}

int d = book.getSheetAt(0).getLastRowNum();
log.info &quot;--------------------------------------&quot;
log.info d.toString();
Row row = book.getSheetAt(0).getRow(d-4);

//Get data from Excel file
	String Excel_TotalTrans = row.getCell(3).toString();
	String Excel_Turnover = row.getCell(4).toString();
	String Excel_CustomerWL = row.getCell(5).toString();
	String Excel_LicenseeWL = row.getCell(6).toString();
	String Excel_PromotionPrize = row.getCell(7).toString();
	String Excel_Contribution = row.getCell(8).toString();
	String Excel_JackpotPrize = row.getCell(9).toString();
	String Excel_LicensingFee = row.getCell(10).toString();
	String Excel_PaytoSupplier = row.getCell(11).toString();
	String Excel_NetIncome = row.getCell(12).toString();

//Get data from Web
	String TotalTrans = vars.get(&quot;Total Trans&quot;);
	String Turnover = vars.get(&quot;Turnover&quot;);
	String CustomerWL = vars.get(&quot;Customer Win Loss&quot;);
	String LicenseeWL = vars.get(&quot;Licensee Win Loss&quot;);
	String PromotionPrize = vars.get(&quot;Promotion Prize&quot;);
	String Contribution = vars.get(&quot;Contribution&quot;);
	String JackpotPrize = vars.get(&quot;Jackpot Prize&quot;);
	String LicensingFee = vars.get(&quot;Licensing fee&quot;);
	String PaytoSupplier = vars.get(&quot;Pay to Supplier&quot;);
	String NetIncome = vars.get(&quot;Net Income&quot;);

//Compare data between Excel and Web
def FailureMessage =&quot;&quot;
	if(Math.abs(Functions.ConvertStringToFloat(Excel_TotalTrans) - Functions.ConvertStringToFloat(TotalTrans))&gt;0.1){
		FailureMessage+=&quot;\nTotal Transactions of Excel: &quot;+Excel_TotalTrans +&quot;\nTotal Transactions of Report: &quot;+TotalTrans;
	}
	if(Math.abs(Functions.ConvertStringToFloat(Excel_Turnover) - Functions.ConvertStringToFloat(Turnover))&gt;0.1){
		FailureMessage+=&quot;\nTurnover of Excel: &quot;+Excel_Turnover +&quot;\nTurnover of Report: &quot;+Turnover;
