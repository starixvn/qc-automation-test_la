                <JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="JSR223 Assertion" enabled="true">
                  <stringProp name="scriptLanguage">groovy</stringProp>
                  <stringProp name="parameters"></stringProp>
                  <stringProp name="filename"></stringProp>
                  <stringProp name="cacheKey"></stringProp>
                  <stringProp name="script">import org.apache.poi.ss.usermodel.*;
import java.io.*;
import java.util.regex.Matcher;
import java.util.regex.Pattern;
import java.nio.file.Files;
import java.nio.file.Paths;
import org.apache.jmeter.services.FileServer;

def path = FileServer.getFileServer().getBaseDir();
/*Load Common Functions - Start*/
ClassLoader parent = getClass().getClassLoader();
GroovyClassLoader loader = new GroovyClassLoader(parent);
Class groovyClass = loader.parseClass(new File(path + &quot;/&quot;+&quot;Functions.groovy&quot;));
GroovyObject Functions  = (GroovyObject) groovyClass.newInstance();
/*Load Common Functions - End*/
def pathReport =  path+&quot;/Excel Report/Licensee Performance by Licensee Fee NG.xlsx&quot;;
def pathExist = new File(pathReport)
def book;
for(def i=0;i&lt;10;i++)
{
	if(pathExist.exists()){
		book = WorkbookFactory.create(new File(pathReport));	
		break;
	} else {sleep(1000)}
}

int d = book.getSheetAt(0).getLastRowNum();
log.info &quot;--------------------------------------&quot;
log.info d.toString();
Row row = book.getSheetAt(0).getRow(d-1);

//Get data from Excel file
	String Excel_LFee = row.getCell(1).toString();

//Get data from Web
	String LFee = vars.get(&quot;Licensing Fee&quot;);

//Compare data between Excel and Web
def FailureMessage =&quot;&quot;
	if(Math.abs(Functions.ConvertStringToFloat(Excel_LFee) - Functions.ConvertStringToFloat(LFee))&gt;0.1){
		FailureMessage+=&quot;\nLicensing Fee of Excel: &quot;+Excel_LFee +&quot;\nLicensing Fee of Report: &quot;+LFee;
	}
	if(FailureMessage!=&quot;&quot;){
		AssertionResult.setFailure(true);
		AssertionResult.setFailureMessage(FailureMessage);
	}
	</stringProp>
                </JSR223Assertion>
