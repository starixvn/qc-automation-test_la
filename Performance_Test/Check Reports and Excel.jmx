	if(Math.abs(Functions.ConvertStringToFloat(Excel_DiscountSBTotalPre) - Functions.ConvertStringToFloat(PreviousDiscountSportsbook))&gt;0.1){
		FailureMessage+=&quot;\nPrevious Discount Sportsbook of Excel: &quot;+Excel_DiscountSBTotalPre +&quot;\nPrevious Discount Sportsbook of Report: &quot;+PreviousDiscountSportsbook;
