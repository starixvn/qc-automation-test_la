Row row = book.getSheetAt(0).getRow(d-2);

//Get data from Excel file
	String Excel_TotalTrans = row.getCell(1).toString();
	String Excel_Turnover = row.getCell(2).toString();
	String Excel_CustomerWL = row.getCell(3).toString();
	String Excel_LicensingFee = row.getCell(4).toString();
	String p = row.getCell(5).toString();
	def Excel_Margin = p.replace(&apos;%&apos;,&apos;&apos;);
	
//Get data from Web
	String TotalTrans = vars.get(&quot;Total Sportsbook No Of Bets&quot;);
	String Turnover = vars.get(&quot;Total Sportsbook Turnover&quot;);
	String CustomerWL = vars.get(&quot;Win Lose&quot;);
	String LicensingFee = vars.get(&quot;Total Sportsbook Licensing fee&quot;);

	def response = &quot;${Margin}&quot;;
	def Margin = response.replace(&apos;%&apos;,&apos;&apos;);

//Compare data between Excel and Web
def FailureMessage =&quot;&quot;
	if(Math.abs(Functions.ConvertStringToFloat(Excel_TotalTrans) - Functions.ConvertStringToFloat(TotalTrans))&gt;0.1){
		FailureMessage+=&quot;\nTotal Bets of Excel: &quot;+Excel_TotalTrans +&quot;\nTotal Bets of Report: &quot;+TotalTrans;
