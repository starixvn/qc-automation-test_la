//Compare data between Excel and Web
def FailureMessage =&quot;&quot;
	if(Math.abs(Functions.ConvertStringToFloat(Excel_Turnover_Asia) - Functions.ConvertStringToFloat(Turnover_Asia))&gt;0.1){
		FailureMessage+=&quot;\nTurnover_Asia of Excel: &quot;+Excel_Turnover_Asia +&quot;\nTurnover_Asia of Report: &quot;+Turnover_Asia;
