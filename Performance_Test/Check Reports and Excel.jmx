              <JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="JSR223 Assertion" enabled="true">
                <stringProp name="scriptLanguage">groovy</stringProp>
                <stringProp name="parameters"></stringProp>
                <stringProp name="filename"></stringProp>
                <stringProp name="cacheKey"></stringProp>
                <stringProp name="script">import org.apache.poi.ss.usermodel.*;
import java.io.*;
import java.util.regex.Matcher;
import java.util.regex.Pattern;
import java.nio.file.Files;
import java.nio.file.Paths;
import org.apache.jmeter.services.FileServer;

def path = FileServer.getFileServer().getBaseDir();
/*Load Common Functions - Start*/
ClassLoader parent = getClass().getClassLoader();
GroovyClassLoader loader = new GroovyClassLoader(parent);
Class groovyClass = loader.parseClass(new File(path + &quot;/&quot;+&quot;Functions.groovy&quot;));
GroovyObject Functions  = (GroovyObject) groovyClass.newInstance();
/*Load Common Functions - End*/
def pathReport =  path+&quot;/Excel Report/Saba Promotion (GMT +8)_Group By Licensee_All Tickets.xlsx&quot;;
def pathExist = new File(pathReport)
def book;
for(def i=0;i&lt;10;i++)
{
	if(pathExist.exists()){
		book = WorkbookFactory.create(new File(pathReport));	
		break;
	} else {sleep(1000)}
}

//Get Index need to compare

int d = book.getSheetAt(0).getLastRowNum();
Row row = book.getSheetAt(0).getRow(d);	
log.info d.toString();

//Get data from Excel file
	String Excel_NoOfCoupon = row.getCell(2).toString();
	String Excel_NoOfRedemption = row.getCell(3).toString();
	String Excel_BC_NonPeakHours = row.getCell(5).toString();
	String Excel_BC_PromoDay = row.getCell(6).toString();
	String Excel_BC_PreviousYear = row.getCell(7).toString();
	String Excel_Turnover_PromoDay = row.getCell(10).toString();
	String Excel_Turnover_PreviousYear = row.getCell(11).toString();
	String Excel_PrizeRedeemed = row.getCell(13).toString();

	float resExcel_RedemptionRate = new BigDecimal(row.getCell(4).toString()).floatValue();
	String Excel_RedemptionRate = (resExcel_RedemptionRate * 100).toString();
	log.info &quot;Test---------------------------&quot; + Excel_RedemptionRate;

	float resExcel_BC_Proportion = new BigDecimal(row.getCell(8).toString()).floatValue();
	String Excel_BC_Proportion = (resExcel_BC_Proportion * 100).toString();
	log.info &quot;Test---------------------------&quot; + Excel_BC_Proportion;

	float resExcel_BC_Growth = new BigDecimal(row.getCell(9).toString()).floatValue();
	String Excel_BC_Growth = (resExcel_BC_Growth * 100).toString();
	log.info &quot;Test---------------------------&quot; + Excel_BC_Growth;

	float resExcel_Turnover_Growth = new BigDecimal(row.getCell(12).toString()).floatValue();
	String Excel_Turnover_Growth = (resExcel_Turnover_Growth * 100).toString();
	log.info &quot;Test---------------------------&quot; + Excel_Turnover_Growth;

	
//Get data from Web
	String NoOfCoupon = vars.get(&quot;No of Coupon&quot;);
	String NoOfRedemption = vars.get(&quot;No of Redemption&quot;);
	String BC_NonPeakHours = vars.get(&quot;Bet Count_Non-Peak Hours&quot;);
	String BC_PromoDay = vars.get(&quot;Bet Count_Promo day&quot;);
	String BC_PreviousYear = vars.get(&quot;Bet Count_Previous Year&quot;);
	String Turnover_PromoDay = vars.get(&quot;Turnover_Promo day&quot;);
	String Turnover_PreviousYear = vars.get(&quot;Turnover_Previous Year&quot;);
	String PrizeRedeemed = vars.get(&quot;Prize Redeemed&quot;);

	def resRedemptionRate = &quot;${Redemption Rate}&quot;;
	def RedemptionRate = resRedemptionRate.replace(&apos;%&apos;,&apos;&apos;);
	log.info &quot;Test RedemptionRate---------------------------&quot; + RedemptionRate;
	
	def resBC_Proportion = &quot;${Bet Count_Proportion}&quot;;
	def BC_Proportion = resBC_Proportion.replace(&apos;%&apos;,&apos;&apos;);
	log.info &quot;Test---------------------------&quot; + BC_Proportion;
	
	def resBC_Growth = &quot;${Bet Count_Growth}&quot;;
	def BC_Growth = resBC_Growth.replace(&apos;%&apos;,&apos;&apos;);
	log.info &quot;Test---------------------------&quot; + BC_Growth;
	
	def resTurnover_Growth = &quot;${Turnover_Growth}&quot;;
	def Turnover_Growth = resTurnover_Growth.replace(&apos;%&apos;,&apos;&apos;);
	log.info &quot;Test Turnover_Growth---------------------------&quot; + Turnover_Growth;

//Compare data between Excel and Web
def FailureMessage =&quot;&quot;
	if(Math.abs(Functions.ConvertStringToFloat(Excel_NoOfCoupon) - Functions.ConvertStringToFloat(NoOfCoupon))&gt;0.1){
		FailureMessage+=&quot;\nNo Of Coupon of Excel: &quot;+Excel_NoOfCoupon +&quot;\nNo Of Coupon of Report: &quot;+NoOfCoupon;
	}
	if(Math.abs(Functions.ConvertStringToFloat(Excel_NoOfRedemption) - Functions.ConvertStringToFloat(NoOfRedemption))&gt;0.1){
		FailureMessage+=&quot;\nNo Of Redemption of Excel: &quot;+Excel_NoOfRedemption +&quot;\nNo Of Redemption of Report: &quot;+NoOfRedemption;
	}
	if(Math.abs(Functions.ConvertStringToFloat(Excel_RedemptionRate) - Functions.ConvertStringToFloat(RedemptionRate))&gt;0.1){
		FailureMessage+=&quot;\nRedemption Rate of Excel: &quot;+Excel_RedemptionRate +&quot;\nRedemption Rate of Report: &quot;+RedemptionRate;
	}
	if(Math.abs(Functions.ConvertStringToFloat(Excel_BC_NonPeakHours) - Functions.ConvertStringToFloat(BC_NonPeakHours))&gt;0.1){
		FailureMessage+=&quot;\nBet Count Non Peak Hours of Excel: &quot;+Excel_BC_NonPeakHours +&quot;\nBet Count Non Peak Hours of Report: &quot;+BC_NonPeakHours;
	}
	if(Math.abs(Functions.ConvertStringToFloat(Excel_BC_PromoDay) - Functions.ConvertStringToFloat(BC_PromoDay))&gt;0.1){
		FailureMessage+=&quot;\nBet Count Promo Day of Excel: &quot;+Excel_BC_PromoDay +&quot;\nBet Count Promo Day of Report: &quot;+BC_PromoDay;
	}
	if(Math.abs(Functions.ConvertStringToFloat(Excel_BC_PreviousYear) - Functions.ConvertStringToFloat(BC_PreviousYear))&gt;0.1){
		FailureMessage+=&quot;\nBet Count Previous Year of Excel: &quot;+Excel_BC_PreviousYear +&quot;\nBet Count Previous Year of Report: &quot;+BC_PreviousYear;
	}
	if(Math.abs(Functions.ConvertStringToFloat(Excel_BC_Proportion) - Functions.ConvertStringToFloat(BC_Proportion))&gt;0.1){
		FailureMessage+=&quot;\nBet Count Proportion of Excel: &quot;+Excel_BC_Proportion +&quot;\nBet Count Proportion of Report: &quot;+BC_Proportion;
	}
	if(Math.abs(Functions.ConvertStringToFloat(Excel_BC_Growth) - Functions.ConvertStringToFloat(BC_Growth))&gt;0.1){
		FailureMessage+=&quot;\nBet Count Growth of Excel: &quot;+Excel_BC_Growth +&quot;\nBet Count Growth of Report: &quot;+BC_Growth;
	}
	if(Math.abs(Functions.ConvertStringToFloat(Excel_Turnover_PromoDay) - Functions.ConvertStringToFloat(Turnover_PromoDay))&gt;0.1){
		FailureMessage+=&quot;\nTurnover Promo Day of Excel: &quot;+Excel_Turnover_PromoDay +&quot;\nTurnover Promo Day of Report: &quot;+Turnover_PromoDay;
	}
	if(Math.abs(Functions.ConvertStringToFloat(Excel_Turnover_PreviousYear) - Functions.ConvertStringToFloat(Turnover_PreviousYear))&gt;0.1){
		FailureMessage+=&quot;\nTurnover Previous Year of Excel: &quot;+Excel_Turnover_PreviousYear +&quot;\nTurnover Previous Year of Report: &quot;+Turnover_PreviousYear;
	}
	if(Math.abs(Functions.ConvertStringToFloat(Excel_Turnover_Growth) - Functions.ConvertStringToFloat(Turnover_Growth))&gt;0.1){
		FailureMessage+=&quot;\nTurnover Growth of Excel: &quot;+Excel_Turnover_Growth +&quot;\nTurnover Growth of Report: &quot;+Turnover_Growth;
	}
	if(Math.abs(Functions.ConvertStringToFloat(Excel_PrizeRedeemed) - Functions.ConvertStringToFloat(PrizeRedeemed))&gt;0.1){
		FailureMessage+=&quot;\nPrize Redeemed of Excel: &quot;+Excel_PrizeRedeemed +&quot;\nPrize Redeemed of Report: &quot;+PrizeRedeemed;
	}
	if(FailureMessage!=&quot;&quot;){
		AssertionResult.setFailure(true);
		AssertionResult.setFailureMessage(FailureMessage);
	}
</stringProp>
              </JSR223Assertion>
