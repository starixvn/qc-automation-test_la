	String Equivalent  = getNotEmptyDataBetween2String(&quot;${Equivalent}&quot;,&quot;${Equivalent - Negative}&quot;);

	String getNotEmptyDataBetween2String(String str1, String str2) { 
   	if(str1==&quot;&quot;){
   		return str2;
 		  }
 	else{
   		return str1;
  		 }
	}

	log.info &apos;Test COTimes------------&apos; + COTimes
//Compare data between Excel and Web
def FailureMessage =&quot;&quot;
	if(Math.abs(Functions.ConvertStringToFloat(Excel_COTimes) - Functions.ConvertStringToFloat(COTimes))&gt;0.1){
		FailureMessage+=&quot;\nCash Out Times of Excel: &quot;+Excel_COTimes +&quot;\nCash Out Times of Report: &quot;+COTimes;
	}
	if(Math.abs(Functions.ConvertStringToFloat(Excel_COTickets) - Functions.ConvertStringToFloat(COTickets))&gt;0.1){
		FailureMessage+=&quot;\nCash Out Tickets of Excel: &quot;+Excel_COTickets +&quot;\nCash Out Tickets of Report: &quot;+COTickets;
	}
	if(Math.abs(Functions.ConvertStringToFloat(Excel_COValue) - Functions.ConvertStringToFloat(COValue))&gt;0.1){
		FailureMessage+=&quot;\nCash Out Value of Excel: &quot;+Excel_COValue +&quot;\nCash Out Value of Report: &quot;+COValue;
	}
	if(Math.abs(Functions.ConvertStringToFloat(Excel_BBAmtSB) - Functions.ConvertStringToFloat(BBAmtSB))&gt;0.1){
		FailureMessage+=&quot;\nBuyback Amount - Sportsbook of Excel: &quot;+Excel_BBAmtSB +&quot;\nBuyback Amount - Sportsbook of Report: &quot;+BBAmtSB;
	}
	if(Math.abs(Functions.ConvertStringToFloat(Excel_BBAmtBA) - Functions.ConvertStringToFloat(BBAmtBA))&gt;0.1){
		FailureMessage+=&quot;\nBuyback Amount - BA of Excel: &quot;+Excel_BBAmtBA +&quot;\nBuyback Amount - BA of Report: &quot;+BBAmtBA;
	}
	if(Math.abs(Functions.ConvertStringToFloat(Excel_BBAmtTotal) - Functions.ConvertStringToFloat(BBAmtTotal))&gt;0.1){
		FailureMessage+=&quot;\nBuyback Amount - Total of Excel: &quot;+Excel_BBAmtTotal +&quot;\nBuyback Amount - Total of Report: &quot;+BBAmtTotal;
	}
	if(Math.abs(Functions.ConvertStringToFloat(Excel_TicketsPayout) - Functions.ConvertStringToFloat(TicketsPayout))&gt;0.1){
		FailureMessage+=&quot;\nTickets Payout of Excel: &quot;+Excel_TicketsPayout +&quot;\nTickets Payout of Report: &quot;+TicketsPayout;
	}
	if(Math.abs(Functions.ConvertStringToFloat(Excel_COCommission) - Functions.ConvertStringToFloat(COCommission))&gt;0.1){
		FailureMessage+=&quot;\nCash Out Commission of Excel: &quot;+Excel_COCommission +&quot;\nCash Out Commission of Report: &quot;+COCommission;
	}	
	if(Math.abs(Functions.ConvertStringToFloat(Excel_AmtDuetoCOTicketsPayout) - Functions.ConvertStringToFloat(AmtDuetoCOTicketsPayout))&gt;0.1){
		FailureMessage+=&quot;\nAmount Due to Cash Out - Tickets Payout of Excel: &quot;+Excel_AmtDuetoCOTicketsPayout +&quot;\nAmount Due to Cash Out - Tickets Payout of Report: &quot;+AmtDuetoCOTicketsPayout;
	}	
	if(Math.abs(Functions.ConvertStringToFloat(Excel_AmtDuetoCOBuybackComm) - Functions.ConvertStringToFloat(AmtDuetoCOBuybackComm))&gt;0.1){
		FailureMessage+=&quot;\nAmount Due to Cash Out - Buyback + Comm of Excel: &quot;+Excel_AmtDuetoCOBuybackComm +&quot;\nAmount Due to Cash Out - Buyback + Comm of Report: &quot;+AmtDuetoCOBuybackComm;
	}	
	if(Math.abs(Functions.ConvertStringToFloat(Excel_Equivalent) - Functions.ConvertStringToFloat(Equivalent))&gt;0.1){
		FailureMessage+=&quot;\nEquivalent of Excel: &quot;+Excel_Equivalent +&quot;\nEquivalent of Report: &quot;+Equivalent;
	}
	if(FailureMessage!=&quot;&quot;){
		AssertionResult.setFailure(true);
		AssertionResult.setFailureMessage(FailureMessage);
	}
	</stringProp>
                </JSR223Assertion>
