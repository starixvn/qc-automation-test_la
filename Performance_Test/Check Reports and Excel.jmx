	log.info &apos;Test Excel_COTimes------------&apos; + Excel_COTimes
//Get data from Web
	String COTimes = vars.get(&quot;Cash Out Times&quot;);
	String COTickets = vars.get(&quot;Cash Out Tickets&quot;);
	String COValue = vars.get(&quot;Cash Out Value&quot;);
	String BBAmtSB = vars.get(&quot;Buyback Amount - Sportsbook&quot;);
	String BBAmtBA = vars.get(&quot;Buyback Amount - BA&quot;);
	if (BBAmtBA==&quot;-&quot;) {	BBAmtBA=&quot;0&quot;;}
