              <hashTree/>
              <JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="JSR223 Assertion" enabled="true">
                <stringProp name="scriptLanguage">groovy</stringProp>
                <stringProp name="parameters"></stringProp>
                <stringProp name="filename"></stringProp>
                <stringProp name="cacheKey"></stringProp>
                <stringProp name="script">import org.apache.poi.ss.usermodel.*;
import java.io.*;
import java.util.regex.Matcher;
import java.util.regex.Pattern;
import java.nio.file.Files;
import java.nio.file.Paths;
import org.apache.jmeter.services.FileServer;

def path = FileServer.getFileServer().getBaseDir();
/*Load Common Functions - Start*/
ClassLoader parent = getClass().getClassLoader();
GroovyClassLoader loader = new GroovyClassLoader(parent);
Class groovyClass = loader.parseClass(new File(path + &quot;/&quot;+&quot;Functions.groovy&quot;));
GroovyObject Functions  = (GroovyObject) groovyClass.newInstance();
/*Load Common Functions - End*/
def pathReport =  path+&quot;/Excel Report/AllBet Win Loss.xlsx&quot;;
def pathExist = new File(pathReport)
def book;
for(def i=0;i&lt;10;i++)
{
	if(pathExist.exists()){
		book = WorkbookFactory.create(new File(pathReport));	
		break;
	} else {sleep(1000)}
}

//Get Index need to compare
	int DataRowIndex = 0;
	String strCompareDataWithReport = &quot;Grand Total in&quot;;
	for(int j = 0;j&lt;book.getSheetAt(0).getLastRowNum();j++) {
		if(book.getSheetAt(0).getRow(j)!=null){
			String RowData = book.getSheetAt(0).getRow(j).getCell(0).toString();
			log.info RowData; 
			if(RowData==strCompareDataWithReport){
				//log.info(strCompareDataWithReport+&quot;: -&gt; &quot;+j.toString());
				DataRowIndex = j;
				break;
			}
		}
      }

//log.info &quot;--------------------------------------&quot;
//log.info DataRowIndex.toString();
Row row = book.getSheetAt(0).getRow(DataRowIndex);

//Get data from Excel file
	String Excel_TotalTrans = row.getCell(4).toString();
	String Excel_Turnover = row.getCell(5).toString();
	String Excel_ValidBetAmt = row.getCell(6).toString();
	String Excel_CustomerWL = row.getCell(7).toString();
	String Excel_SCRegistered = row.getCell(9).toString();
	String Excel_SCVariance = row.getCell(10).toString();
	String Excel_RCRegistered = row.getCell(12).toString();
	String Excel_RCVariance = row.getCell(13).toString();
	String Excel_PromotionRegistered = row.getCell(15).toString();
	String Excel_PromotionVariance = row.getCell(16).toString();
	String Excel_PSRegistered = row.getCell(18).toString();
	String Excel_PSVariance = row.getCell(19).toString();

//Get data from Web
	String TotalTrans = vars.get(&quot;Total Trans&quot;);
	String Turnover = vars.get(&quot;Turnover&quot;);
	String ValidBetAmt = vars.get(&quot;Valid Bet Amount&quot;);
	String CustomerWL = vars.get(&quot;Customer WL&quot;);
	String SCRegistered = vars.get(&quot;Service Charge Registered&quot;);
	String SCVariance = vars.get(&quot;Service Charge Variance&quot;);
	String RCRegistered = vars.get(&quot;Rebate Commission Registered&quot;);
	String RCVariance = vars.get(&quot;Rebate Commission Variance&quot;);
	String PromotionRegistered = vars.get(&quot;Promotion Registered&quot;);
	String PromotionVariance = vars.get(&quot;Promotion Variance&quot;);
	String PSRegistered = vars.get(&quot;Pay to Supplier Registered&quot;);
	String PSVariance = vars.get(&quot;Pay to Supplier Variance&quot;);

//Compare data between Excel and Web
def FailureMessage =&quot;&quot;
	if(Math.abs(Functions.ConvertStringToFloat(Excel_TotalTrans) - Functions.ConvertStringToFloat(TotalTrans))&gt;0.1){
		FailureMessage+=&quot;\nTotal Transactions of Excel: &quot;+Excel_TotalTrans +&quot;\nTotal Transactions of Report: &quot;+TotalTrans;
	}
	if(Math.abs(Functions.ConvertStringToFloat(Excel_Turnover) - Functions.ConvertStringToFloat(Turnover))&gt;0.1){
		FailureMessage+=&quot;\nTurnover of Excel: &quot;+Excel_Turnover +&quot;\nTurnover of Report: &quot;+Turnover;
	}
	if(Math.abs(Functions.ConvertStringToFloat(Excel_ValidBetAmt) - Functions.ConvertStringToFloat(ValidBetAmt))&gt;0.1){
		FailureMessage+=&quot;\nValid Bet Amount of Excel: &quot;+Excel_ValidBetAmt +&quot;\nValid Bet Amount of Report: &quot;+ValidBetAmt;
	}
	if(Math.abs(Functions.ConvertStringToFloat(Excel_CustomerWL) - Functions.ConvertStringToFloat(CustomerWL))&gt;0.1){
		FailureMessage+=&quot;\nCustomer WL of Excel: &quot;+Excel_CustomerWL +&quot;\nCustomer WL of Report: &quot;+CustomerWL;
	}
	if(Math.abs(Functions.ConvertStringToFloat(Excel_SCRegistered) - Functions.ConvertStringToFloat(SCRegistered))&gt;0.1){
		FailureMessage+=&quot;\nService Charge Registered of Excel: &quot;+Excel_SCRegistered +&quot;\nService Charge Registered of Report: &quot;+SCRegistered;
	}
	if(Math.abs(Functions.ConvertStringToFloat(Excel_SCVariance) - Functions.ConvertStringToFloat(SCVariance))&gt;0.1){
		FailureMessage+=&quot;\nService Charge Variance of Excel: &quot;+Excel_SCVariance +&quot;\nService Charge Variance of Report: &quot;+SCVariance;
	}
	if(Math.abs(Functions.ConvertStringToFloat(Excel_RCRegistered) - Functions.ConvertStringToFloat(RCRegistered))&gt;0.1){
		FailureMessage+=&quot;\nRebate Commission Registered of Excel: &quot;+Excel_RCRegistered +&quot;\nRebate Commission Registered of Report: &quot;+RCRegistered;
	}
	if(Math.abs(Functions.ConvertStringToFloat(Excel_RCVariance) - Functions.ConvertStringToFloat(RCVariance))&gt;0.1){
		FailureMessage+=&quot;\nRebate Commission Variance of Excel: &quot;+Excel_RCVariance +&quot;\nRebate Commission Variance of Report: &quot;+RCVariance;
	}
	if(Math.abs(Functions.ConvertStringToFloat(Excel_PromotionRegistered) - Functions.ConvertStringToFloat(PromotionRegistered))&gt;0.1){
		FailureMessage+=&quot;\nPromotion Registered of Excel: &quot;+Excel_PromotionRegistered +&quot;\nPromotion Registered of Report: &quot;+PromotionRegistered;
	}
	if(Math.abs(Functions.ConvertStringToFloat(Excel_PromotionVariance) - Functions.ConvertStringToFloat(PromotionVariance))&gt;0.1){
		FailureMessage+=&quot;\nPromotion Variance of Excel: &quot;+Excel_PromotionVariance +&quot;\nPromotion Variance of Report: &quot;+PromotionVariance;
	}
	if(Math.abs(Functions.ConvertStringToFloat(Excel_PSRegistered) - Functions.ConvertStringToFloat(PSRegistered))&gt;0.1){
		FailureMessage+=&quot;\nPay to Supplier Registered of Excel: &quot;+Excel_PSRegistered +&quot;\nPay to Supplier Registered of Report: &quot;+PSRegistered;
	}
	if(Math.abs(Functions.ConvertStringToFloat(Excel_PSVariance) - Functions.ConvertStringToFloat(PSVariance))&gt;0.1){
		FailureMessage+=&quot;\nPay to Supplier Variance of Excel: &quot;+Excel_PSVariance +&quot;\nPay to Supplier Variance of Report: &quot;+PSVariance;
	}
	if(FailureMessage!=&quot;&quot;){
		AssertionResult.setFailure(true);
		AssertionResult.setFailureMessage(FailureMessage);
	}</stringProp>
              </JSR223Assertion>
              <hashTree/>
            </hashTree>
