	&quot;BaseCurrencyName&quot;:&quot;${glb_BaseCurrency}&quot;,&#xd;
	&quot;BrandName&quot;:&quot;12Bet&quot;,&#xd;
	&quot;CurrencyID&quot;:&quot;0&quot;,&#xd;
	&quot;FromDay&quot;:&quot;${FDay}&quot;,&#xd;
