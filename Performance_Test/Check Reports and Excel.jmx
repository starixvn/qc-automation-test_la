		FailureMessage+=&quot;\nTurnover Previous Year of Excel: &quot;+Excel_Turnover_PreviousYear +&quot;\nTurnover Previous Year of Report: &quot;+Turnover_PreviousYear;
	}
	if(Math.abs(Functions.ConvertStringToFloat(Excel_Turnover_Growth) - Functions.ConvertStringToFloat(Turnover_Growth))&gt;0.1){
		FailureMessage+=&quot;\nTurnover Growth of Excel: &quot;+Excel_Turnover_Growth +&quot;\nTurnover Growth of Report: &quot;+Turnover_Growth;
	}
	if(Math.abs(Functions.ConvertStringToFloat(Excel_PrizeRedeemed) - Functions.ConvertStringToFloat(PrizeRedeemed))&gt;0.1){
		FailureMessage+=&quot;\nPrize Redeemed of Excel: &quot;+Excel_PrizeRedeemed +&quot;\nPrize Redeemed of Report: &quot;+PrizeRedeemed;
	}
	if(FailureMessage!=&quot;&quot;){
		AssertionResult.setFailure(true);
		AssertionResult.setFailureMessage(FailureMessage);
	}
</stringProp>
              </JSR223Assertion>
