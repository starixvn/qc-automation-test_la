              <JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="JSR223 Assertion" enabled="true">
                <stringProp name="scriptLanguage">groovy</stringProp>
                <stringProp name="parameters"></stringProp>
                <stringProp name="filename"></stringProp>
                <stringProp name="cacheKey"></stringProp>
                <stringProp name="script">import org.apache.poi.ss.usermodel.*;
import java.io.*;
import java.util.regex.Matcher;
import java.util.regex.Pattern;
import java.nio.file.Files;
import java.nio.file.Paths;
import org.apache.jmeter.services.FileServer;

def path = FileServer.getFileServer().getBaseDir();
/*Load Common Functions - Start*/
ClassLoader parent = getClass().getClassLoader();
GroovyClassLoader loader = new GroovyClassLoader(parent);
Class groovyClass = loader.parseClass(new File(path + &quot;/&quot;+&quot;Functions.groovy&quot;));
GroovyObject Functions  = (GroovyObject) groovyClass.newInstance();
/*Load Common Functions - End*/
def pathReport =  path+&quot;/Excel Report/Number Game Win Loss.xlsx&quot;;
def pathExist = new File(pathReport)
def book;
for(def i=0;i&lt;10;i++)
{
	if(pathExist.exists()){
		book = WorkbookFactory.create(new File(pathReport));	
		break;
	} else {sleep(1000)}
}

//Get Index need to compare
	int DataRowIndex = 0;
	String strCompareDataWithReport = &quot;Grand Total in&quot;;
	for(int j = 0;j&lt;book.getSheetAt(0).getLastRowNum();j++) {
		if(book.getSheetAt(0).getRow(j)!=null){
			String RowData = book.getSheetAt(0).getRow(j).getCell(0).toString();
			log.info RowData; 
			if(RowData==strCompareDataWithReport){
				//log.info(strCompareDataWithReport+&quot;: -&gt; &quot;+j.toString());
				DataRowIndex = j;
				break;
			}
		}
      }

log.info &quot;--------------------------------------&quot;
log.info DataRowIndex.toString();
Row row = book.getSheetAt(0).getRow(DataRowIndex);

//Get data from Excel file
	String Excel_TotalTrans = row.getCell(3).toString();
	String Excel_Turnover = row.getCell(4).toString();
	String Excel_HouseTurnover = row.getCell(5).toString();
	String Excel_CustomerWL = row.getCell(6).toString();
	String Excel_LicenseeWL = row.getCell(7).toString();
	String Excel_LicensingFee = row.getCell(8).toString();
	String Excel_ExtraPTWL = row.getCell(9).toString();
	String Excel_PaytoSupplier = row.getCell(10).toString();
	String Excel_NetIncome = row.getCell(11).toString();

//Get data from Web
	String TotalTrans = vars.get(&quot;Total Trans&quot;);
	String Turnover = vars.get(&quot;Turnover&quot;);
	String HouseTurnover = vars.get(&quot;House Turnover&quot;);
	String CustomerWL = vars.get(&quot;Customer Win Loss&quot;);
	String LicenseeWL = vars.get(&quot;Licensee Win Loss&quot;);
	String LicensingFee = vars.get(&quot;Licensing fee&quot;);
	String ExtraPTWL = vars.get(&quot;ExtraPT WL&quot;);
	String PaytoSupplier = vars.get(&quot;Pay to Supplier&quot;);
	String NetIncome = vars.get(&quot;Net Income&quot;);

//Compare data between Excel and Web
def FailureMessage =&quot;&quot;
	if(Math.abs(Functions.ConvertStringToFloat(Excel_TotalTrans) - Functions.ConvertStringToFloat(TotalTrans))&gt;0.1){
		FailureMessage+=&quot;\nTotal Transactions of Excel: &quot;+Excel_TotalTrans +&quot;\nTotal Transactions of Report: &quot;+TotalTrans;
	}
	if(Math.abs(Functions.ConvertStringToFloat(Excel_Turnover) - Functions.ConvertStringToFloat(Turnover))&gt;0.1){
		FailureMessage+=&quot;\nTurnover of Excel: &quot;+Excel_Turnover +&quot;\nTurnover of Report: &quot;+Turnover;
	}
	if(Math.abs(Functions.ConvertStringToFloat(Excel_HouseTurnover) - Functions.ConvertStringToFloat(HouseTurnover))&gt;0.1){
		FailureMessage+=&quot;\nHouse Turnover of Excel: &quot;+Excel_HouseTurnover +&quot;\nHouse Turnover of Report: &quot;+HouseTurnover;
	}
	if(Math.abs(Functions.ConvertStringToFloat(Excel_CustomerWL) - Functions.ConvertStringToFloat(CustomerWL))&gt;0.1){
		FailureMessage+=&quot;Failure!\nCustomerWL of Excel: &quot;+Excel_CustomerWL +&quot;\nCustomerWL of Report: &quot;+CustomerWL;
	}
	if(Math.abs(Functions.ConvertStringToFloat(Excel_LicenseeWL) - Functions.ConvertStringToFloat(LicenseeWL))&gt;0.1){
		FailureMessage+=&quot;\nLicensee Win Loss of Excel: &quot;+Excel_LicenseeWL +&quot;\nLicensee Win Loss of Report: &quot;+LicenseeWL;
	}
	if(Math.abs(Functions.ConvertStringToFloat(Excel_LicensingFee) - Functions.ConvertStringToFloat(LicensingFee))&gt;0.1){
		FailureMessage+=&quot;\nLicensing Fee of Excel: &quot;+Excel_LicensingFee +&quot;\nLicensing Fee of Report: &quot;+LicensingFee;
	}
	if(Math.abs(Functions.ConvertStringToFloat(Excel_ExtraPTWL) - Functions.ConvertStringToFloat(ExtraPTWL))&gt;0.1){
		FailureMessage+=&quot;\nExtraPT WL of Excel: &quot;+Excel_ExtraPTWL +&quot;\nExtraPT WL of Report: &quot;+ExtraPTWL;
	}
	if(Math.abs(Functions.ConvertStringToFloat(Excel_PaytoSupplier) - Functions.ConvertStringToFloat(PaytoSupplier))&gt;0.1){
		FailureMessage+=&quot;\nPay to Supplier of Excel: &quot;+Excel_PaytoSupplier +&quot;\nPay to Supplier of Report: &quot;+PaytoSupplier;
	}
	if(Math.abs(Functions.ConvertStringToFloat(Excel_NetIncome) - Functions.ConvertStringToFloat(NetIncome))&gt;0.1){
		FailureMessage+=&quot;\nNet Income of Excel: &quot;+Excel_NetIncome +&quot;\nNet Income of Report: &quot;+NetIncome;
	}
	if(FailureMessage!=&quot;&quot;){
		AssertionResult.setFailure(true);
		AssertionResult.setFailureMessage(FailureMessage);
	}</stringProp>
              </JSR223Assertion>
              <hashTree/>
            </hashTree>
            <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="Number Game WL_Group By Licensee - Compare Data with Web Report" enabled="false">
