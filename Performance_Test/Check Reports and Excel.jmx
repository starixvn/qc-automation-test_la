              <JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="JSR223 Assertion" enabled="true">
                <stringProp name="scriptLanguage">groovy</stringProp>
                <stringProp name="parameters"></stringProp>
                <stringProp name="filename"></stringProp>
                <stringProp name="cacheKey"></stringProp>
                <stringProp name="script">import com.google.api.services.sheets.v4.model.ValueRange;
import com.google.api.services.sheets.v4.model.BatchUpdateValuesRequest;
import java.util.regex.Matcher;
import java.util.regex.Pattern;
import java.nio.file.Files;
import java.nio.file.Paths;
import org.apache.jmeter.services.FileServer;
import groovy.json.JsonSlurper;
import com.jayway.jsonpath.*;
import org.apache.poi.ss.usermodel.*;
import java.io.*;

def path = FileServer.getFileServer().getBaseDir();
ClassLoader parent = getClass().getClassLoader();
GroovyClassLoader loader = new GroovyClassLoader(parent);
Class groovyClassUtilities = loader.parseClass(new File(path + &quot;/Library/&quot;+&quot;Utilities.groovy&quot;));
GroovyObject Utilities  = (GroovyObject) groovyClassUtilities.newInstance();
Class groovyClass = loader.parseClass(new File(path + &quot;/&quot;+&quot;Functions.groovy&quot;));
GroovyObject Functions  = (GroovyObject) groovyClass.newInstance();

/*Load Common Functions - End*/
def pathReport =  path+&quot;/Excel Report/Win Loss By Product.xlsx&quot;;
def pathExist = new File(pathReport)
def book;
for(def i=0;i&lt;10;i++)
{
	if(pathExist.exists()){
		book = WorkbookFactory.create(new File(pathReport));	
		break;
	} else {sleep(1000)}
}

int d = book.getSheetAt(0).getLastRowNum();
Row row = book.getSheetAt(0).getRow(d); 

//log.info &apos;Index: &apos; + d.toString()

//Get data from Excel file
	String Excel_Sportsbook = 	(row.getCell(2).toString() == &quot;null&quot;) ?  &quot;0&quot; : row.getCell(2).toString() ;	
	String Excel_NumberGame = 	(row.getCell(4).toString() == &quot;null&quot;) ?  &quot;0&quot; : row.getCell(4).toString() ;
	String Excel_BA = 			(row.getCell(5).toString() == &quot;null&quot;) ?  &quot;0&quot; : row.getCell(5).toString() ;
	String Excel_VirtualSports = 	(row.getCell(7).toString() == &quot;null&quot;) ?  &quot;0&quot; : row.getCell(7).toString() ;
	String Excel_SabaCasino = 	(row.getCell(8).toString() == &quot;null&quot;) ?  &quot;0&quot; : row.getCell(8).toString() ; // RNGCasino
	String Excel_RNGKeno = 		(row.getCell(9).toString() == &quot;null&quot;) ?  &quot;0&quot; : row.getCell(9).toString() ; 
	String Excel_AGCasino = 		(row.getCell(10).toString() == &quot;null&quot;) ?  &quot;0&quot; : row.getCell(10).toString() ;
	String Excel_GoldDeluxe = 	(row.getCell(11).toString() == &quot;null&quot;) ?  &quot;0&quot; : row.getCell(11).toString() ;
	String Excel_MacauGames = 	(row.getCell(15).toString() == &quot;null&quot;) ?  &quot;0&quot; : row.getCell(15).toString() ;
	String Excel_Allbet = 		(row.getCell(16).toString() == &quot;null&quot;) ?  &quot;0&quot; : row.getCell(16).toString() ;
	String Excel_FishingWorld = 	(row.getCell(17).toString() == &quot;null&quot;) ?  &quot;0&quot; : row.getCell(17).toString() ;
	String Excel_ColossusBet = 	(row.getCell(19).toString() == &quot;null&quot;) ?  &quot;0&quot; : row.getCell(19).toString() ;
	String Excel_CashOut = 		(row.getCell(20).toString() == &quot;null&quot;) ?  &quot;0&quot; : row.getCell(20).toString() ;
	String Excel_VirtualSports2 = (row.getCell(21).toString() == &quot;null&quot;) ?  &quot;0&quot; : row.getCell(21).toString() ;
	String Excel_Lottery = 		(row.getCell(22).toString() == &quot;null&quot;) ?  &quot;0&quot; : row.getCell(22).toString() ;
	String Excel_Exchange = 		(row.getCell(23).toString() == &quot;null&quot;) ?  &quot;0&quot; : row.getCell(23).toString() ;
	String Excel_PP = 			(row.getCell(24).toString() == &quot;null&quot;) ?  &quot;0&quot; : row.getCell(24).toString() ;
	String Excel_ArcadiaGaming = 	(row.getCell(25).toString() == &quot;null&quot;) ?  &quot;0&quot; : row.getCell(25).toString() ;
	String Excel_SG = 			(row.getCell(26).toString() == &quot;null&quot;) ?  &quot;0&quot; : row.getCell(26).toString() ;
	String Excel_VirtualGames = 	(row.getCell(27).toString() == &quot;null&quot;) ?  &quot;0&quot; : row.getCell(27).toString() ;
	String Excel_SAGaming = 		(row.getCell(28).toString() == &quot;null&quot;) ?  &quot;0&quot; : row.getCell(28).toString() ;
	String Excel_Togel4D = 		(row.getCell(29).toString() == &quot;null&quot;) ?  &quot;0&quot; : row.getCell(29).toString() ;
	String Excel_TableGame = 	(row.getCell(30).toString() == &quot;null&quot;) ?  &quot;0&quot; : row.getCell(30).toString() ;
