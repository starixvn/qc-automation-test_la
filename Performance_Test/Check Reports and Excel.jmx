                <stringProp name="script">import org.apache.poi.ss.usermodel.*;
import java.io.*;
import java.util.regex.Matcher;
import java.util.regex.Pattern;
import java.nio.file.Files;
import java.nio.file.Paths;
import org.apache.jmeter.services.FileServer;
import groovy.json.JsonSlurper;

def path = FileServer.getFileServer().getBaseDir();
/*Load Common Functions - Start*/
ClassLoader parent = getClass().getClassLoader();
GroovyClassLoader loader = new GroovyClassLoader(parent);
Class groovyClass = loader.parseClass(new File(path + &quot;/&quot;+&quot;Functions.groovy&quot;));
GroovyObject Functions  = (GroovyObject) groovyClass.newInstance();
/*Load Common Functions - End*/
def pathReport =  path+&quot;/Excel Report/LPID.xlsx&quot;;
def pathExist = new File(pathReport)
def book;
for(def i=0;i&lt;10;i++)
{
	if(pathExist.exists()){
		book = WorkbookFactory.create(new File(pathReport));	
		break;
	} else {sleep(1000)}
}

//Get Index need to compare
int d = book.getSheetAt(0).getLastRowNum();
log.info &quot;--------------------------------------&quot;
log.info d.toString();
Row row = book.getSheetAt(0).getRow(d);

//Get data from Excel file
	String Excel_BetCount = row.getCell(2).toString();
	String Excel_AvgBetValue = row.getCell(3).toString();
	String Excel_Turnover = row.getCell(4).toString();
	String Excel_TurnoverPre = row.getCell(5).toString();
	String Excel_WLTotal = row.getCell(6).toString();
	String Excel_WLTotalPre = row.getCell(7).toString();
	String Excel_Margin = row.getCell(8).toString();
	String Excel_MarginPre = row.getCell(9).toString();
	String Excel_BAComTotal = row.getCell(10).toString();
	String Excel_BAComTotalPre = row.getCell(11).toString();
	String Excel_AmtDuetoBA = row.getCell(12).toString();
	String Excel_AmtDuetoBAPre = row.getCell(13).toString();
	String Excel_LFeeSBTotal = row.getCell(14).toString();
	String Excel_LFeeSBTotalPre = row.getCell(15).toString();
	String Excel_LFeeOthersTotal = row.getCell(16).toString();
	String Excel_LFeeOthersPre = row.getCell(17).toString();
	String Excel_DiscountSBTotal = row.getCell(18).toString();
	String Excel_DiscountSBTotalPre = row.getCell(19).toString();
	String Excel_DiscountOthersTotal = row.getCell(20).toString();
	String Excel_DiscountOthersTotalPre = row.getCell(21).toString();
	String Excel_RebateSBTotal = row.getCell(22).toString();
	String Excel_RebateSBTotalPre = row.getCell(23).toString();
	String Excel_RebateOthersTotal = row.getCell(24).toString();
	String Excel_RebateOthersTotalPre = row.getCell(25).toString();
	String Excel_PromotionSB = row.getCell(26).toString();
	String Excel_PromotionSBPre = row.getCell(27).toString();
	String Excel_SponsorshipSB = row.getCell(28).toString();
	String Excel_SponsorshipSBPre = row.getCell(29).toString();
	String Excel_PlayerTipsSB = row.getCell(30).toString();
	String Excel_PlayerTipsSBPre = row.getCell(31).toString();
	String Excel_TotalLFee = row.getCell(32).toString();
	String Excel_TotalLFeePre = row.getCell(33).toString();

//Get data from Web
	def jsonSlurper = new JsonSlurper();
	def response = jsonSlurper.parseText(prev.getResponseDataAsString());
		
	String TotalTrans = response.GrandTotal.TotalTrans.toString();
	String AvgBetValue = response.GrandTotal.AverageBetValue.toString();
	String Turnover = response.GrandTotal.Turnover.toString();
	String PreviousTurnover = response.GrandTotal.PreviousTurnover.toString();
	String GrossWinLoss = response.GrandTotal.GrossWinLoss.toString();
	String PreviousGrossWinLoss = response.GrandTotal.PreviousGrossWinLoss.toString();
	String Margin = response.GrandTotal.Margin.toString();
	String PreviousMargin = response.GrandTotal.PreviousMargin.toString();
	String BACommission = response.GrandTotal.BACommission.toString();
	String PreviousBACommission = response.GrandTotal.PreviousBACommission.toString();
	String AmountDueToBA = response.GrandTotal.AmountDueToBA.toString();
	String PreviousAmountDueToBA = response.GrandTotal.PreviousAmountDueToBA.toString();
	String SportsbookFee = response.GrandTotal.SportsbookFee.toString();
	String PreviousSportsbookFee = response.GrandTotal.PreviousSportsbookFee.toString();
	String OtherProductsFee = response.GrandTotal.OtherProductsFee.toString();
	String PreviousOtherProductsFee = response.GrandTotal.PreviousOtherProductsFee.toString();
	String DiscountSportsbook = response.GrandTotal.DiscountSportsbook.toString();
	String PreviousDiscountSportsbook = response.GrandTotal.PreviousDiscountSportsbook.toString();
	String DiscountOthers = response.GrandTotal.DiscountOthers.toString();
	String PreviousDiscountOthers = response.GrandTotal.PreviousDiscountOthers.toString();
	String RebateSportsbook = response.GrandTotal.RebateSportsbook.toString();
	String PreviousRebateSportsbook = response.GrandTotal.PreviousRebateSportsbook.toString();
	String RebateOthers = response.GrandTotal.RebateOthers.toString();
	String PreviousRebateOthers = response.GrandTotal.PreviousRebateOthers.toString();
	String TotalLicensingFee = response.GrandTotal.TotalLicensingFee.toString();
	String PreviousTotalLicensingFee = response.GrandTotal.PreviousTotalLicensingFee.toString();
	String PromotionSportsbook = response.GrandTotal.PromotionSportsbook.toString();
	String PreviousPromotionSportsbook = response.GrandTotal.PreviousPromotionSportsbook.toString();
	String SponsorshipSportsbook = response.GrandTotal.SponsorshipSportsbook.toString();
	String PreviousSponsorshipSportsbook = response.GrandTotal.PreviousSponsorshipSportsbook.toString();
	String PlayerTipsSportsbook = response.GrandTotal.PlayerTipsSportsbook.toString();
	String PreviousPlayerTipsSportsbook = response.GrandTotal.PreviousPlayerTipsSportsbook.toString();

//Compare data between Excel and Web
def FailureMessage =&quot;&quot;
	if(Math.abs(Functions.ConvertStringToFloat(Excel_BetCount) - Functions.ConvertStringToFloat(TotalTrans))&gt;0.1){
		FailureMessage+=&quot;\nBet Count of Excel: &quot;+Excel_BetCount +&quot;\nBet Count of Report: &quot;+TotalTrans;
	}
	if(Math.abs(Functions.ConvertStringToFloat(Excel_AvgBetValue) - Functions.ConvertStringToFloat(AvgBetValue))&gt;0.1){
		FailureMessage+=&quot;\nAvg Bet Value of Excel: &quot;+Excel_AvgBetValue +&quot;\nAvg Bet Value of Report: &quot;+AvgBetValue;
	}
	if(Math.abs(Functions.ConvertStringToFloat(Excel_Turnover) - Functions.ConvertStringToFloat(Turnover))&gt;0.1){
		FailureMessage+=&quot;\nTurnover of Excel: &quot;+Excel_Turnover +&quot;\nTurnover of Report: &quot;+Turnover;
	}
	if(Math.abs(Functions.ConvertStringToFloat(Excel_TurnoverPre) - Functions.ConvertStringToFloat(PreviousTurnover))&gt;0.1){
		FailureMessage+=&quot;\nPrevious Turnover of Excel: &quot;+Excel_TurnoverPre +&quot;\nPrevious Turnover of Report: &quot;+PreviousTurnover;
	}
	if(Math.abs(Functions.ConvertStringToFloat(Excel_WLTotal) - Functions.ConvertStringToFloat(GrossWinLoss))&gt;0.1){
		FailureMessage+=&quot;\nWin Loss of Excel: &quot;+Excel_WLTotal +&quot;\nWin Loss of Report: &quot;+GrossWinLoss;
	}
	if(Math.abs(Functions.ConvertStringToFloat(Excel_WLTotalPre) - Functions.ConvertStringToFloat(PreviousGrossWinLoss))&gt;0.1){
		FailureMessage+=&quot;\nPrevious Win Loss of Excel: &quot;+Excel_WLTotalPre +&quot;\nPrevious Win Loss of Report: &quot;+PreviousGrossWinLoss;
	}
	if(Math.abs(Functions.ConvertStringToFloat(Excel_Margin) - Functions.ConvertStringToFloat(Margin))&gt;0.1){
		FailureMessage+=&quot;\nMargin of Excel: &quot;+Excel_Margin +&quot;\nMargin of Report: &quot;+Margin;
	}
	if(Math.abs(Functions.ConvertStringToFloat(Excel_MarginPre) - Functions.ConvertStringToFloat(PreviousMargin))&gt;0.1){
		FailureMessage+=&quot;\nPrevious Margin of Excel: &quot;+Excel_MarginPre +&quot;\nPrevious Margin of Report: &quot;+PreviousMargin;
	}
	if(Math.abs(Functions.ConvertStringToFloat(Excel_BAComTotal) - Functions.ConvertStringToFloat(BACommission))&gt;0.1){
		FailureMessage+=&quot;\nBA Commission of Excel: &quot;+Excel_BAComTotal +&quot;\nBA Commission of Report: &quot;+BACommission;
	}
	if(Math.abs(Functions.ConvertStringToFloat(Excel_BAComTotalPre) - Functions.ConvertStringToFloat(PreviousBACommission))&gt;0.1){
		FailureMessage+=&quot;\nPrevious BA Commission of Excel: &quot;+Excel_BAComTotalPre +&quot;\nPrevious BA Commission of Report: &quot;+PreviousBACommission;
	}
	if(Math.abs(Functions.ConvertStringToFloat(Excel_AmtDuetoBA) - Functions.ConvertStringToFloat(AmountDueToBA))&gt;0.1){
		FailureMessage+=&quot;\nAmount Due To BA of Excel: &quot;+Excel_AmtDuetoBA +&quot;\nAmount Due To BA of Report: &quot;+AmountDueToBA;
	}
	if(Math.abs(Functions.ConvertStringToFloat(Excel_AmtDuetoBAPre) - Functions.ConvertStringToFloat(PreviousAmountDueToBA))&gt;0.1){
		FailureMessage+=&quot;\nPrevious Amount Due To BA of Excel: &quot;+Excel_AmtDuetoBAPre +&quot;\nPrevious Amount Due To BA of Report: &quot;+PreviousAmountDueToBA;
	}
	if(Math.abs(Functions.ConvertStringToFloat(Excel_LFeeSBTotal) - Functions.ConvertStringToFloat(SportsbookFee))&gt;0.1){
		FailureMessage+=&quot;\nSportsbook Fee of Excel: &quot;+Excel_LFeeSBTotal +&quot;\nSportsbook Fee of Report: &quot;+SportsbookFee;
	}
	if(Math.abs(Functions.ConvertStringToFloat(Excel_LFeeSBTotalPre) - Functions.ConvertStringToFloat(PreviousSportsbookFee))&gt;0.1){
		FailureMessage+=&quot;\nPrevious Sportsbook Fee of Excel: &quot;+Excel_LFeeSBTotalPre +&quot;\nPrevious Sportsbook Fee of Report: &quot;+PreviousSportsbookFee;
	}
	if(Math.abs(Functions.ConvertStringToFloat(Excel_LFeeOthersTotal) - Functions.ConvertStringToFloat(OtherProductsFee))&gt;0.1){
		FailureMessage+=&quot;\nOther Products Fee of Excel: &quot;+Excel_LFeeOthersTotal +&quot;\nOther Products Fee of Report: &quot;+OtherProductsFee;
