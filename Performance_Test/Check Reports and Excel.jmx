def path = FileServer.getFileServer().getBaseDir();
/*Load Common Functions - Start*/
ClassLoader parent = getClass().getClassLoader();
GroovyClassLoader loader = new GroovyClassLoader(parent);
Class groovyClass = loader.parseClass(new File(path + &quot;/&quot;+&quot;Functions.groovy&quot;));
GroovyObject Functions  = (GroovyObject) groovyClass.newInstance();
/*Load Common Functions - End*/
def pathReport =  path+&quot;/Excel Report/Licensee Performance Sexy Gaming.xlsx&quot;;
def pathExist = new File(pathReport)
def book;
for(def i=0;i&lt;10;i++)
{
	if(pathExist.exists()){
		book = WorkbookFactory.create(new File(pathReport));	
		break;
	} else {sleep(1000)}
}

//Get Index need to compare
int d = book.getSheetAt(0).getLastRowNum();
log.info &quot;--------------------------------------&quot;
log.info d.toString();
Row row = book.getSheetAt(0).getRow(d-2);

//Get data from Excel file
	String Excel_TotalTrans = row.getCell(1).toString();
	String Excel_Turnover = row.getCell(2).toString();
	String Excel_CustomerWL = row.getCell(3).toString();
	String Excel_LicensingFee = row.getCell(4).toString();
	String p = row.getCell(5).toString();
	def Excel_Margin = p.replace(&apos;%&apos;,&apos;&apos;);
	
//Get data from Web
	String TotalTrans = vars.get(&quot;Total Sportsbook No Of Bets&quot;);
	String Turnover = vars.get(&quot;Total Sportsbook Turnover&quot;);
	String CustomerWL = vars.get(&quot;Win Lose&quot;);
	String LicensingFee = vars.get(&quot;Total Sportsbook Licensing fee&quot;);

	def response = &quot;${Margin}&quot;;
	def Margin = response.replace(&apos;%&apos;,&apos;&apos;);

//Compare data between Excel and Web
def FailureMessage =&quot;&quot;
	if(Math.abs(Functions.ConvertStringToFloat(Excel_TotalTrans) - Functions.ConvertStringToFloat(TotalTrans))&gt;0.1){
		FailureMessage+=&quot;\nTotal Bets of Excel: &quot;+Excel_TotalTrans +&quot;\nTotal Bets of Report: &quot;+TotalTrans;
	}
	if(Math.abs(Functions.ConvertStringToFloat(Excel_Turnover) - Functions.ConvertStringToFloat(Turnover))&gt;0.1){
		FailureMessage+=&quot;\nTotal Turnover of Excel: &quot;+Excel_Turnover +&quot;\nTotal Turnover of Report: &quot;+Turnover;
	}
	if(Math.abs(Functions.ConvertStringToFloat(Excel_CustomerWL) - Functions.ConvertStringToFloat(CustomerWL))&gt;0.1){
		FailureMessage+=&quot;\nWin Lose of Excel: &quot;+Excel_CustomerWL +&quot;\nWin Lose of Report: &quot;+CustomerWL;
	}
	if(Math.abs(Functions.ConvertStringToFloat(Excel_LicensingFee) - Functions.ConvertStringToFloat(LicensingFee))&gt;0.1){
		FailureMessage+=&quot;\nTotal Licensing fee of Excel: &quot;+Excel_LicensingFee +&quot;\nTotal Licensing fee of Report: &quot;+LicensingFee;
	}
	if(Math.abs(Functions.ConvertStringToFloat(Excel_Margin) - Functions.ConvertStringToFloat(Margin))&gt;0.1){
		FailureMessage+=&quot;\nMargin of Excel: &quot;+Excel_Margin +&quot;\nMargin of Report: &quot;+Margin;
	}
	if(FailureMessage!=&quot;&quot;){
		AssertionResult.setFailure(true);
		AssertionResult.setFailureMessage(FailureMessage);
	}
	</stringProp>
