              <JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="Compare Data with Web Report" enabled="false">
                <stringProp name="cacheKey"></stringProp>
                <stringProp name="filename"></stringProp>
                <stringProp name="parameters"></stringProp>
                <stringProp name="script">import org.apache.poi.ss.usermodel.*;
import java.io.*;
import java.util.regex.Matcher;
import java.util.regex.Pattern;
import java.nio.file.Files;
import java.nio.file.Paths;
import org.apache.jmeter.services.FileServer;

def path = FileServer.getFileServer().getBaseDir();
/*Load Common Functions - Start*/
ClassLoader parent = getClass().getClassLoader();
GroovyClassLoader loader = new GroovyClassLoader(parent);
Class groovyClass = loader.parseClass(new File(path + &quot;/&quot;+&quot;Functions.groovy&quot;));
GroovyObject Functions  = (GroovyObject) groovyClass.newInstance();
/*Load Common Functions - End*/

def pathReport =  path+&quot;/Excel Report/Licensee Win Loss.xlsx&quot;;
def book = WorkbookFactory.create(new File(pathReport));	

int d = book.getSheetAt(0).getLastRowNum();
Row row = book.getSheetAt(0).getRow(d-4);	

//Get data from Excel file
	String Excel_TotalTrans = row.getCell(2).toString();
	String Excel_Turnover = row.getCell(3).toString();
	String Excel_CustomerWL = row.getCell(4).toString();
	String Excel_LicenseeWL = row.getCell(5).toString();
	String Excel_BACommission = row.getCell(6).toString();
	String Excel_RacingRevenue = row.getCell(7).toString();
	String Excel_BA = row.getCell(8).toString();
	String Excel_Racing = row.getCell(9).toString();
	String Excel_Others = row.getCell(10).toString();

//Get data from Web
	String TotalTrans = vars.get(&quot;Total Trans&quot;);
	String Turnover = vars.get(&quot;Turnover&quot;);
	
	String CustomerWLP = vars.get(&quot;Customer W/L&quot;);
	String CustomerWLN = vars.get(&quot;Customer W/L - Negative&quot;);
	String CustomerWinLoss = getNotEmptyDataBetween2String(&quot;${CustomerWLP}&quot;,&quot;${CustomerWLN}&quot;);
	
	String LicenseeWLP = vars.get(&quot;Licensee W/L&quot;);
	String LicenseeWLN = vars.get(&quot;Licensee W/L - Negative&quot;);
	String LicenseeWinLoss = getNotEmptyDataBetween2String(&quot;${LicenseeWLP}&quot;,&quot;${LicenseeWLN}&quot;);

	String BACommission = vars.get(&quot;BA Commission&quot;);
	String RacingRevenue = vars.get(&quot;Racing Revenue&quot;);
	
	String BAP = vars.get(&quot;BA&quot;);
	String BAN = vars.get(&quot;BA - Negative&quot;);
	String BA = getNotEmptyDataBetween2String(&quot;${BAP}&quot;,&quot;${BAN}&quot;);
	
	String Racing = vars.get(&quot;Racing&quot;);
	
	String OthersP = vars.get(&quot;Others&quot;);
	String OthersN = vars.get(&quot;Others - Negative&quot;);
	String Others = getNotEmptyDataBetween2String(&quot;${OthersP}&quot;,&quot;${OthersN}&quot;);

String getNotEmptyDataBetween2String(String str1, String str2) { 
   if(str1==&quot;&quot;){
   	return str2;
   }else{
   	return str1;
   }
}

//Compare data between Excel and Web
	if(Math.abs(Functions.ConvertStringToFloat(Excel_TotalTrans) - Functions.ConvertStringToFloat(TotalTrans))&gt;0.2){
			AssertionResult.setFailure(true);
			AssertionResult.setFailureMessage(&quot;Failure!\nTotal Transactions of Excel: &quot;+Excel_TotalTrans +&quot;\nTotal Transactions of Report: &quot;+TotalTrans);
	}
	if(Math.abs(Functions.ConvertStringToFloat(Excel_Turnover) - Functions.ConvertStringToFloat(Turnover))&gt;0.2){
			AssertionResult.setFailure(true);
			AssertionResult.setFailureMessage(&quot;Failure!\nTotal Turnover of Excel: &quot;+Excel_Turnover +&quot;\nTotal Turnover of Report: &quot;+Turnover);
	}
	if(Math.abs(Functions.ConvertStringToFloat(Excel_CustomerWL) - Functions.ConvertStringToFloat(CustomerWinLoss))&gt;0.2){
			AssertionResult.setFailure(true);
			AssertionResult.setFailureMessage(&quot;Failure!\nTotal CustomerWL of Excel: &quot;+Excel_CustomerWL +&quot;\nTotal CustomerWL of Report: &quot;+CustomerWinLoss);
	}
	if(Math.abs(Functions.ConvertStringToFloat(Excel_LicenseeWL) - Functions.ConvertStringToFloat(LicenseeWinLoss))&gt;0.2){
			AssertionResult.setFailure(true);
			AssertionResult.setFailureMessage(&quot;Failure!\nTotal LicenseeWL of Excel: &quot;+Excel_LicenseeWL +&quot;\nTotal LicenseeWL of Report: &quot;+LicenseeWinLoss);
	}
	if(Math.abs(Functions.ConvertStringToFloat(Excel_BACommission) - Functions.ConvertStringToFloat(BACommission))&gt;0.2){
			AssertionResult.setFailure(true);
			AssertionResult.setFailureMessage(&quot;Failure!\nTotal BA Commission of Excel: &quot;+Excel_BACommission +&quot;\nTotal BA Commission of Report: &quot;+BACommission);
	}
	if(Math.abs(Functions.ConvertStringToFloat(Excel_RacingRevenue) - Functions.ConvertStringToFloat(RacingRevenue))&gt;0.2){
			AssertionResult.setFailure(true);
			AssertionResult.setFailureMessage(&quot;Failure!\nTotal Racing Revenue of Excel: &quot;+Excel_RacingRevenue +&quot;\nTotal Racing Revenue of Report: &quot;+RacingRevenue);
	}
	if(Math.abs(Functions.ConvertStringToFloat(Excel_BA) - Functions.ConvertStringToFloat(BA))&gt;0.2){
			AssertionResult.setFailure(true);
			AssertionResult.setFailureMessage(&quot;Failure!\nTotal BA of Excel: &quot;+Excel_BA +&quot;\nTotal BA of Report: &quot;+BA);
	}
	if(Math.abs(Functions.ConvertStringToFloat(Excel_Racing) - Functions.ConvertStringToFloat(Racing))&gt;0.2){
			AssertionResult.setFailure(true);
			AssertionResult.setFailureMessage(&quot;Failure!\nTotal Racing of Excel: &quot;+Excel_Racing +&quot;\nTotal Racing of Report: &quot;+Racing);
	}
	if(Math.abs(Functions.ConvertStringToFloat(Excel_Others) - Functions.ConvertStringToFloat(Others))&gt;0.2){
			AssertionResult.setFailure(true);
			AssertionResult.setFailureMessage(&quot;Failure!\nTotal Others of Excel: &quot;+Excel_Others +&quot;\nTotal Others of Report: &quot;+Others);
	}
	

</stringProp>
