              <JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="JSR223 Assertion" enabled="true">
                <stringProp name="scriptLanguage">groovy</stringProp>
                <stringProp name="parameters"></stringProp>
                <stringProp name="filename"></stringProp>
                <stringProp name="cacheKey"></stringProp>
                <stringProp name="script">import org.apache.poi.ss.usermodel.*;
import java.io.*;
import java.util.regex.Matcher;
import java.util.regex.Pattern;
import java.nio.file.Files;
import java.nio.file.Paths;
import org.apache.jmeter.services.FileServer;

def path = FileServer.getFileServer().getBaseDir();
/*Load Common Functions - Start*/
ClassLoader parent = getClass().getClassLoader();
GroovyClassLoader loader = new GroovyClassLoader(parent);
Class groovyClass = loader.parseClass(new File(path + &quot;/&quot;+&quot;Functions.groovy&quot;));
GroovyObject Functions  = (GroovyObject) groovyClass.newInstance();
/*Load Common Functions - End*/
def pathReport =  path+&quot;/Excel Report/Peak Concurrent Users.xlsx&quot;;
def pathExist = new File(pathReport)
def book;
for(def i=0;i&lt;10;i++)
{
	if(pathExist.exists()){
		book = WorkbookFactory.create(new File(pathReport));	
		break;
	} else {sleep(1000)}
}

//Get Index need to compare
int d = book.getSheetAt(0).getLastRowNum();
log.info &quot;--------------------------------------&quot;
log.info d.toString();
Row row3 = book.getSheetAt(0).getRow(d-3); //TotalUser
Row row2 = book.getSheetAt(0).getRow(d-2); //AverageUser
Row row1 = book.getSheetAt(0).getRow(d-1); //MaxUser
Row row = book.getSheetAt(0).getRow(d); //MinUser

//Get data from Excel file
	String Excel_TotalUser = row3.getCell(1).toString();
	String Excel_AverageUser = row2.getCell(1).toString();
	String Excel_MaxUser = row1.getCell(1).toString();
	String Excel_MinUser = row.getCell(1).toString();
	
//Get data from Web
	String TotalUser = vars.get(&quot;Total Peak Concurrent Users&quot;);
	String AverageUser = vars.get(&quot;Average Peak Concurrent Users&quot;);
	String MaxUser = vars.get(&quot;Max Peak Concurrent Users&quot;);
	String MinUser = vars.get(&quot;Min Peak Concurrent Users&quot;);

//Compare data between Excel and Web
def FailureMessage =&quot;&quot;
	if(Math.abs(Functions.ConvertStringToFloat(Excel_TotalUser) - Functions.ConvertStringToFloat(TotalUser))&gt;0.1){
		FailureMessage+=&quot;\nTotal Peak Concurrent Users of Excel: &quot;+Excel_TotalUser +&quot;\nTotal Peak Concurrent Users of Report: &quot;+TotalUser;
	}
	if(Math.abs(Functions.ConvertStringToFloat(Excel_AverageUser) - Functions.ConvertStringToFloat(AverageUser))&gt;0.1){
		FailureMessage+=&quot;\nAverage Peak Concurrent Users of Excel: &quot;+Excel_AverageUser +&quot;\nAverage Peak Concurrent Users of Report: &quot;+AverageUser;
	}
	if(Math.abs(Functions.ConvertStringToFloat(Excel_MaxUser) - Functions.ConvertStringToFloat(MaxUser))&gt;0.1){
		FailureMessage+=&quot;\nMax Peak Concurrent Users of Excel: &quot;+Excel_MaxUser +&quot;\nMax Peak Concurrent Users of Report: &quot;+MaxUser;
	}
	if(Math.abs(Functions.ConvertStringToFloat(Excel_MinUser) - Functions.ConvertStringToFloat(MinUser))&gt;0.1){
		FailureMessage+=&quot;\nMin Peak Concurrent Users of Excel: &quot;+Excel_MinUser +&quot;\nMin Peak Concurrent Users of Report: &quot;+MinUser;
	}
	if(FailureMessage!=&quot;&quot;){
		AssertionResult.setFailure(true);
		AssertionResult.setFailureMessage(FailureMessage);
	}
	</stringProp>
              </JSR223Assertion>
