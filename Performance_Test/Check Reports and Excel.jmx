		FailureMessage+=&quot;\nPrevious Rebate Sportsbook of Excel: &quot;+Excel_RebateSBTotalPre +&quot;\nPrevious Rebate Sportsbook of Report: &quot;+PreviousRebateSportsbook;
	}
	if(Math.abs(Functions.ConvertStringToFloat(Excel_RebateOthersTotal) - Functions.ConvertStringToFloat(RebateOthers))&gt;0.1){
		FailureMessage+=&quot;\nRebate Others of Excel: &quot;+Excel_RebateOthersTotal +&quot;\nRebate Others of Report: &quot;+RebateOthers;
