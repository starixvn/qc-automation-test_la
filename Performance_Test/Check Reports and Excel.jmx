              <JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="JSR223 Assertion" enabled="true">
                <stringProp name="scriptLanguage">groovy</stringProp>
                <stringProp name="parameters"></stringProp>
                <stringProp name="filename"></stringProp>
                <stringProp name="cacheKey"></stringProp>
                <stringProp name="script">import org.apache.poi.ss.usermodel.*;
import java.io.*;
import java.util.regex.Matcher;
import java.util.regex.Pattern;
import java.nio.file.Files;
import java.nio.file.Paths;
import org.apache.jmeter.services.FileServer;

def path = FileServer.getFileServer().getBaseDir();
/*Load Common Functions - Start*/
ClassLoader parent = getClass().getClassLoader();
GroovyClassLoader loader = new GroovyClassLoader(parent);
Class groovyClass = loader.parseClass(new File(path + &quot;/&quot;+&quot;Functions.groovy&quot;));
GroovyObject Functions  = (GroovyObject) groovyClass.newInstance();
/*Load Common Functions - End*/
def pathReport =  path+&quot;/Excel Report/Currency Win Loss_Group by Currency.xlsx&quot;;
def pathExist = new File(pathReport)
def book;
for(def i=0;i&lt;10;i++)
{
	if(pathExist.exists()){
		book = WorkbookFactory.create(new File(pathReport));	
		break;
	} else {sleep(1000)}
}

int d = book.getSheetAt(0).getLastRowNum();
Row row = book.getSheetAt(0).getRow(d);	

//Get data from Excel file
	String Excel_TotalTrans = row.getCell(1).toString();
	String Excel_Turnover = row.getCell(2).toString();
	String Excel_PercentTurnover = row.getCell(3).toString();
	String Excel_CustomerWL = row.getCell(4).toString();
	String Excel_LicenseeWL = row.getCell(5).toString();
	String Excel_PercentLicenseeWL = row.getCell(6).toString();
	String Excel_BACommission = row.getCell(7).toString();
	String Excel_BA = row.getCell(8).toString();
	String Excel_Others = row.getCell(9).toString();
	float Excel_MarginF = new BigDecimal(row.getCell(11).toString()).floatValue();
	String Excel_Margin = (Excel_MarginF * 100).toString();

//Get data from Web
	String TotalTrans = vars.get(&quot;Total Trans&quot;);
	String Turnover = vars.get(&quot;Turnover&quot;);
	
	String CustomerWLP = vars.get(&quot;Customer W/L&quot;);
	String CustomerWLN = vars.get(&quot;Customer W/L - Negative&quot;);
	String CustomerWinLoss = getNotEmptyDataBetween2String(&quot;${CustomerWLP}&quot;,&quot;${CustomerWLN}&quot;);
	
	String LicenseeWLP = vars.get(&quot;Licensee W/L&quot;);
	String LicenseeWLN = vars.get(&quot;Licensee W/L - Negative&quot;);
	String LicenseeWinLoss = getNotEmptyDataBetween2String(&quot;${LicenseeWLP}&quot;,&quot;${LicenseeWLN}&quot;);

	String BACommission = vars.get(&quot;BA Commission&quot;);
	
	String BAP = vars.get(&quot;BA&quot;);
	String BAN = vars.get(&quot;BA - Negative&quot;);
	String BA = getNotEmptyDataBetween2String(&quot;${BAP}&quot;,&quot;${BAN}&quot;);
	
	String OthersP = vars.get(&quot;Others&quot;);
	String OthersN = vars.get(&quot;Others - Negative&quot;);
	String Others = getNotEmptyDataBetween2String(&quot;${OthersP}&quot;,&quot;${OthersN}&quot;);

	def resPercentTurnover = &quot;${Percent Turnover}&quot;;
	def PercentTurnover = resPercentTurnover.replace(&apos;%&apos;,&apos;&apos;);
	log.info &quot;Test---------------------------&quot; + PercentTurnover;
	def resPercentLicenseeWL = &quot;${Percent Licensee WL}&quot;;
	def PercentLicenseeWL = resPercentLicenseeWL.replace(&apos;%&apos;,&apos;&apos;);
	log.info &quot;Test1---------------------------&quot; + PercentLicenseeWL;
	def resMargin = &quot;${Margin}&quot;;
	def Margin = resMargin.replace(&apos;%&apos;,&apos;&apos;);
	
String getNotEmptyDataBetween2String(String str1, String str2) { 
   if(str1==&quot;&quot;){
   	return str2;
   }else{
   	return str1;
   }
}

//Compare data between Excel and Web
def FailureMessage =&quot;&quot;
	if(Math.abs(Functions.ConvertStringToFloat(Excel_TotalTrans) - Functions.ConvertStringToFloat(TotalTrans))&gt;0.1){
		FailureMessage+=&quot;\nTotal Transactions of Excel: &quot;+Excel_TotalTrans +&quot;\nTotal Transactions of Report: &quot;+TotalTrans;
	}
	if(Math.abs(Functions.ConvertStringToFloat(Excel_Turnover) - Functions.ConvertStringToFloat(Turnover))&gt;0.1){
		FailureMessage+=&quot;\nTurnover of Excel: &quot;+Excel_Turnover +&quot;\nTurnover of Report: &quot;+Turnover;
	}
	if(Math.abs(Functions.ConvertStringToFloat(Excel_CustomerWL) - Functions.ConvertStringToFloat(CustomerWinLoss))&gt;0.1){
		FailureMessage+=&quot;\nCustomerWL of Excel: &quot;+Excel_CustomerWL +&quot;\nCustomerWL of Report: &quot;+CustomerWinLoss;
	}
	if(Math.abs(Functions.ConvertStringToFloat(Excel_LicenseeWL) - Functions.ConvertStringToFloat(LicenseeWinLoss))&gt;0.1){
		FailureMessage+=(&quot;\nLicenseeWL of Excel: &quot;+Excel_LicenseeWL +&quot;\nLicenseeWL of Report: &quot;+LicenseeWinLoss);
	}
	if(Math.abs(Functions.ConvertStringToFloat(Excel_BACommission) - Functions.ConvertStringToFloat(BACommission))&gt;0.1){
		FailureMessage+=(&quot;\nBA Commission of Excel: &quot;+Excel_BACommission +&quot;\nBA Commission of Report: &quot;+BACommission);
	}
	if(Math.abs(Functions.ConvertStringToFloat(Excel_PercentTurnover) - Functions.ConvertStringToFloat(PercentTurnover))&gt;0.1){
		FailureMessage+=(&quot;\n% Turnover of Excel: &quot;+Excel_PercentTurnover +&quot;\n% Turnover of Report: &quot;+PercentTurnover);
	}
	if(Math.abs(Functions.ConvertStringToFloat(Excel_BA) - Functions.ConvertStringToFloat(BA))&gt;0.1){
		FailureMessage+=(&quot;\nBA of Excel: &quot;+Excel_BA +&quot;\nBA of Report: &quot;+BA);
	}
	if(Math.abs(Functions.ConvertStringToFloat(Excel_PercentLicenseeWL) - Functions.ConvertStringToFloat(PercentLicenseeWL))&gt;0.1){
		FailureMessage+=(&quot;\n% LicenseeWL of Excel: &quot;+Excel_PercentLicenseeWL +&quot;\n% LicenseeWL of Report: &quot;+PercentLicenseeWL);
	}
	if(Math.abs(Functions.ConvertStringToFloat(Excel_Others) - Functions.ConvertStringToFloat(Others))&gt;0.1){
		FailureMessage+=&quot;\nOthers of Excel: &quot;+Excel_Others +&quot;\nOthers of Report: &quot;+Others;
	}
	if(Math.abs(Functions.ConvertStringToFloat(Excel_Margin) - Functions.ConvertStringToFloat(Margin))&gt;0.1){
		FailureMessage+=&quot;\nMargin of Excel: &quot;+Excel_Margin +&quot;\nMargin of Report: &quot;+Margin;
	}
	if(FailureMessage!=&quot;&quot;){
		AssertionResult.setFailure(true);
		AssertionResult.setFailureMessage(FailureMessage);
	}

</stringProp>
              </JSR223Assertion>
