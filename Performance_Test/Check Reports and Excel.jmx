              <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="Settlement Report Cash Out - Compare Data with Web Report" enabled="false">
                <stringProp name="scriptLanguage">groovy</stringProp>
                <stringProp name="parameters"></stringProp>
                <stringProp name="filename"></stringProp>
                <stringProp name="cacheKey"></stringProp>
                <stringProp name="script">&quot;If it fails please check JSR223 Assertion for more details !!!&quot;</stringProp>
              </JSR223Sampler>
              <hashTree>
                <JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="JSR223 Assertion" enabled="true">
                  <stringProp name="scriptLanguage">groovy</stringProp>
                  <stringProp name="parameters"></stringProp>
                  <stringProp name="filename"></stringProp>
                  <stringProp name="cacheKey"></stringProp>
                  <stringProp name="script">import org.apache.poi.ss.usermodel.*;
import java.io.*;
import java.util.regex.Matcher;
import java.util.regex.Pattern;
import java.nio.file.Files;
import java.nio.file.Paths;
import org.apache.jmeter.services.FileServer;

def path = FileServer.getFileServer().getBaseDir();
/*Load Common Functions - Start*/
ClassLoader parent = getClass().getClassLoader();
GroovyClassLoader loader = new GroovyClassLoader(parent);
Class groovyClass = loader.parseClass(new File(path + &quot;/&quot;+&quot;Functions.groovy&quot;));
GroovyObject Functions  = (GroovyObject) groovyClass.newInstance();
/*Load Common Functions - End*/
def pathReport =  path+&quot;/Excel Report/Settlement Report CO.xlsx&quot;;
def pathExist = new File(pathReport)
def book;
for(def i=0;i&lt;10;i++)
{
	if(pathExist.exists()){
		book = WorkbookFactory.create(new File(pathReport));	
		break;
	} else {sleep(1000)}
}

//Get Index need to compare
	int DataRowIndex = 0;
	String strCompareDataWithReport = &quot;Total in Eur&quot;;
	for(int j = 0;j&lt;book.getSheetAt(0).getLastRowNum();j++) {
		if(book.getSheetAt(0).getRow(j)!=null){
			String RowData = book.getSheetAt(0).getRow(j).getCell(1).toString();
			log.info RowData; 
			if(RowData==strCompareDataWithReport){
				log.info(strCompareDataWithReport+&quot;: -&gt; &quot;+j.toString());
				DataRowIndex = j;
				break;
			}
		}
      }
      
Row row = book.getSheetAt(0).getRow(DataRowIndex);

//Get data from Excel file
	String Excel_COTimes = row.getCell(3).toString();
	String Excel_COTickets = row.getCell(4).toString();
	String Excel_COValue = row.getCell(5).toString();
	String Excel_BBAmtSB = row.getCell(6).toString();
	String Excel_BBAmtBA = row.getCell(7).toString();
	String Excel_BBAmtTotal = row.getCell(8).toString();
	String Excel_TicketsPayout = row.getCell(9).toString();
	String Excel_COCommission = row.getCell(10).toString();
	String Excel_AmtDuetoCOTicketsPayout = row.getCell(11).toString();
	String Excel_AmtDuetoCOBuybackComm = row.getCell(12).toString();
	String Excel_Equivalent = row.getCell(13).toString();

	log.info &apos;Test Excel_COTimes------------&apos; + Excel_COTimes
//Get data from Web
	String COTimes = vars.get(&quot;Cash Out Times&quot;);
	String COTickets = vars.get(&quot;Cash Out Tickets&quot;);
	String COValue = vars.get(&quot;Cash Out Value&quot;);
	String BBAmtSB = vars.get(&quot;Buyback Amount - Sportsbook&quot;);
	String BBAmtBA = vars.get(&quot;Buyback Amount - BA&quot;);
	if (BBAmtBA==&quot;-&quot;) {	BBAmtBA=&quot;0&quot;;}
	String BBAmtTotal = vars.get(&quot;Buyback Amount - Total&quot;);
	String TicketsPayout = vars.get(&quot;Tickets Payout&quot;);
	String COCommission = vars.get(&quot;Cash Out Commission&quot;);
	String AmtDuetoCOTicketsPayout = vars.get(&quot;Amount Due to Cash Out - Tickets Payout&quot;);
	String AmtDuetoCOBuybackComm = vars.get(&quot;Amount Due to Cash Out - Buyback + Comm&quot;);
	//String Equivalent = vars.get(&quot;Equivalent&quot;);
	String Equivalent  = getNotEmptyDataBetween2String(&quot;${Equivalent}&quot;,&quot;${Equivalent - Negative}&quot;);

	String getNotEmptyDataBetween2String(String str1, String str2) { 
   	if(str1==&quot;&quot;){
   		return str2;
 		  }
 	else{
   		return str1;
  		 }
	}

	log.info &apos;Test COTimes------------&apos; + COTimes
//Compare data between Excel and Web
def FailureMessage =&quot;&quot;
	if(Math.abs(Functions.ConvertStringToFloat(Excel_COTimes) - Functions.ConvertStringToFloat(COTimes))&gt;0.1){
		FailureMessage+=&quot;\nCash Out Times of Excel: &quot;+Excel_COTimes +&quot;\nCash Out Times of Report: &quot;+COTimes;
	}
	if(Math.abs(Functions.ConvertStringToFloat(Excel_COTickets) - Functions.ConvertStringToFloat(COTickets))&gt;0.1){
		FailureMessage+=&quot;\nCash Out Tickets of Excel: &quot;+Excel_COTickets +&quot;\nCash Out Tickets of Report: &quot;+COTickets;
	}
	if(Math.abs(Functions.ConvertStringToFloat(Excel_COValue) - Functions.ConvertStringToFloat(COValue))&gt;0.1){
		FailureMessage+=&quot;\nCash Out Value of Excel: &quot;+Excel_COValue +&quot;\nCash Out Value of Report: &quot;+COValue;
	}
	if(Math.abs(Functions.ConvertStringToFloat(Excel_BBAmtSB) - Functions.ConvertStringToFloat(BBAmtSB))&gt;0.1){
		FailureMessage+=&quot;\nBuyback Amount - Sportsbook of Excel: &quot;+Excel_BBAmtSB +&quot;\nBuyback Amount - Sportsbook of Report: &quot;+BBAmtSB;
	}
	if(Math.abs(Functions.ConvertStringToFloat(Excel_BBAmtBA) - Functions.ConvertStringToFloat(BBAmtBA))&gt;0.1){
		FailureMessage+=&quot;\nBuyback Amount - BA of Excel: &quot;+Excel_BBAmtBA +&quot;\nBuyback Amount - BA of Report: &quot;+BBAmtBA;
	}
	if(Math.abs(Functions.ConvertStringToFloat(Excel_BBAmtTotal) - Functions.ConvertStringToFloat(BBAmtTotal))&gt;0.1){
		FailureMessage+=&quot;\nBuyback Amount - Total of Excel: &quot;+Excel_BBAmtTotal +&quot;\nBuyback Amount - Total of Report: &quot;+BBAmtTotal;
	}
	if(Math.abs(Functions.ConvertStringToFloat(Excel_TicketsPayout) - Functions.ConvertStringToFloat(TicketsPayout))&gt;0.1){
		FailureMessage+=&quot;\nTickets Payout of Excel: &quot;+Excel_TicketsPayout +&quot;\nTickets Payout of Report: &quot;+TicketsPayout;
	}
	if(Math.abs(Functions.ConvertStringToFloat(Excel_COCommission) - Functions.ConvertStringToFloat(COCommission))&gt;0.1){
		FailureMessage+=&quot;\nCash Out Commission of Excel: &quot;+Excel_COCommission +&quot;\nCash Out Commission of Report: &quot;+COCommission;
	}	
	if(Math.abs(Functions.ConvertStringToFloat(Excel_AmtDuetoCOTicketsPayout) - Functions.ConvertStringToFloat(AmtDuetoCOTicketsPayout))&gt;0.1){
		FailureMessage+=&quot;\nAmount Due to Cash Out - Tickets Payout of Excel: &quot;+Excel_AmtDuetoCOTicketsPayout +&quot;\nAmount Due to Cash Out - Tickets Payout of Report: &quot;+AmtDuetoCOTicketsPayout;
	}	
	if(Math.abs(Functions.ConvertStringToFloat(Excel_AmtDuetoCOBuybackComm) - Functions.ConvertStringToFloat(AmtDuetoCOBuybackComm))&gt;0.1){
		FailureMessage+=&quot;\nAmount Due to Cash Out - Buyback + Comm of Excel: &quot;+Excel_AmtDuetoCOBuybackComm +&quot;\nAmount Due to Cash Out - Buyback + Comm of Report: &quot;+AmtDuetoCOBuybackComm;
	}	
	if(Math.abs(Functions.ConvertStringToFloat(Excel_Equivalent) - Functions.ConvertStringToFloat(Equivalent))&gt;0.1){
		FailureMessage+=&quot;\nEquivalent of Excel: &quot;+Excel_Equivalent +&quot;\nEquivalent of Report: &quot;+Equivalent;
	}
	if(FailureMessage!=&quot;&quot;){
		AssertionResult.setFailure(true);
		AssertionResult.setFailureMessage(FailureMessage);
	}
	</stringProp>
                </JSR223Assertion>
