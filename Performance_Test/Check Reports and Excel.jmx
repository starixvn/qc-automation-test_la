                <JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="JSR223 Assertion" enabled="true">
                  <stringProp name="scriptLanguage">groovy</stringProp>
                  <stringProp name="parameters"></stringProp>
                  <stringProp name="filename"></stringProp>
                  <stringProp name="cacheKey"></stringProp>
                  <stringProp name="script">import org.apache.poi.ss.usermodel.*;
import java.io.*;
import java.util.regex.Matcher;
import java.util.regex.Pattern;
import java.nio.file.Files;
import java.nio.file.Paths;
import org.apache.jmeter.services.FileServer;

def path = FileServer.getFileServer().getBaseDir();
/*Load Common Functions - Start*/
ClassLoader parent = getClass().getClassLoader();
GroovyClassLoader loader = new GroovyClassLoader(parent);
Class groovyClass = loader.parseClass(new File(path + &quot;/&quot;+&quot;Functions.groovy&quot;));
GroovyObject Functions  = (GroovyObject) groovyClass.newInstance();
/*Load Common Functions - End*/
def pathReport =  path+&quot;/Excel Report/Collection Summary.xlsx&quot;;
def pathExist = new File(pathReport)
def book;
for(def i=0;i&lt;10;i++)
{
	if(pathExist.exists()){
		book = WorkbookFactory.create(new File(pathReport));	
		break;
	} else {sleep(1000)}
}

int d = book.getSheetAt(0).getLastRowNum();
Row row = book.getSheetAt(0).getRow(d);	
//log.info &quot;Test------------&quot; + d.toString();

//Get data from Excel file
	String Excel_BalanceBf = row.getCell(1).toString();
	String Excel_Prepayment = row.getCell(2).toString();
	String Excel_Billing_SetupFee = row.getCell(3).toString();
	String Excel_CollectionTotal = row.getCell(9).toString();
	String Excel_BalanceCf = row.getCell(10).toString();

//Get data from Web
	String CollectionTotal = vars.get(&quot;Collection Total&quot;);
	
	String BalanceBfP = vars.get(&quot;Balance Bf&quot;);
	String BalanceBfPN = vars.get(&quot;Balance Bf - Negative&quot;);
	String BalanceBf = getNotEmptyDataBetween2String(&quot;${BalanceBfP}&quot;,&quot;${BalanceBfPN}&quot;);
	
	String PrepaymentP = vars.get(&quot;Prepayment&quot;);
	String PrepaymentN = vars.get(&quot;Prepayment - Negative&quot;);
	String Prepayment = getNotEmptyDataBetween2String(&quot;${PrepaymentP}&quot;,&quot;${PrepaymentN}&quot;);
	
	String Billing_SetupFeeP = vars.get(&quot;Billing/Setup Fee&quot;);
	String Billing_SetupFeeN = vars.get(&quot;Billing/Setup Fee - Negative&quot;);
	String Billing_SetupFee = getNotEmptyDataBetween2String(&quot;${Billing_SetupFeeP}&quot;,&quot;${Billing_SetupFeeN}&quot;);
		
	String BalanceCfP = vars.get(&quot;Balance Cf&quot;);
	String BalanceCfN = vars.get(&quot;Balance Cf - Negative&quot;);
	String BalanceCf = getNotEmptyDataBetween2String(&quot;${BalanceCfP}&quot;,&quot;${BalanceCfN}&quot;);

String getNotEmptyDataBetween2String(String str1, String str2) { 
   if(str1==&quot;&quot;){
   	return str2;
   }else{
   	return str1;
   }
}

//Compare data between Excel and Web
def FailureMessage =&quot;&quot;
	if(Math.abs(Functions.ConvertStringToFloat(Excel_BalanceBf) - Functions.ConvertStringToFloat(BalanceBf))&gt;0.1	|| Functions.ConvertStringToFloat(BalanceBf) == 0){
		FailureMessage+=&quot;\nBalance Bf of Excel: &quot;+Excel_BalanceBf +&quot;\nBalance Bf of Report: &quot;+BalanceBf;
	}
	if(Math.abs(Functions.ConvertStringToFloat(Excel_Prepayment) - Functions.ConvertStringToFloat(Prepayment))&gt;0.1){
		FailureMessage+=&quot;\nPrepayment of Excel: &quot;+Excel_Prepayment +&quot;\nPrepayment of Report: &quot;+Prepayment;
	}
	if(Math.abs(Functions.ConvertStringToFloat(Excel_Billing_SetupFee) - Functions.ConvertStringToFloat(Billing_SetupFee))&gt;0.1){
		FailureMessage+=&quot;\nBilling/Setup Fee of Excel: &quot;+Excel_Billing_SetupFee +&quot;\nBilling/Setup Fee of Report: &quot;+Billing_SetupFee;
	}
	if(Math.abs(Functions.ConvertStringToFloat(Excel_CollectionTotal) - Functions.ConvertStringToFloat(CollectionTotal))&gt;0.1){
		FailureMessage+=&quot;\nCollection Total of Excel: &quot;+Excel_CollectionTotal +&quot;\nCollection Total of Report: &quot;+CollectionTotal;
	}
	if(Math.abs(Functions.ConvertStringToFloat(Excel_BalanceCf) - Functions.ConvertStringToFloat(BalanceCf))&gt;0.1){
		FailureMessage+=&quot;\nBalance Cf of Excel: &quot;+Excel_BalanceCf +&quot;\nBalance Cf of Report: &quot;+BalanceCf;
	}
	if(FailureMessage!=&quot;&quot;){
		AssertionResult.setFailure(true);
		AssertionResult.setFailureMessage(FailureMessage);
	}
</stringProp>
                </JSR223Assertion>
