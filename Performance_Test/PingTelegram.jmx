          <stringProp name="parameters"></stringProp>
          <stringProp name="filename"></stringProp>
          <stringProp name="cacheKey"></stringProp>
          <stringProp name="script">if(${__property(fFailed)}.toString() == &quot;1&quot;){
	vars.put(&quot;Content&quot;,
		&quot;Hi All, Automation Test [${glb_ContentSkype}] is failed&quot;);
}
if(${__property(fFailed)}.toString() == &quot;0&quot;){
	vars.put(&quot;Content&quot;,
		&quot;Hi All, Automation Test [${glb_ContentSkype}] is successful&quot;);
}

</stringProp>
        </JSR223Sampler>
        <hashTree/>
