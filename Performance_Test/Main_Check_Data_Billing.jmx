                <stringProp name="parameters"></stringProp>
                <stringProp name="script">import com.google.api.services.sheets.v4.model.ValueRange;
import com.google.api.services.sheets.v4.model.BatchUpdateValuesRequest;
import java.util.regex.Matcher;
import java.util.regex.Pattern;
import java.nio.file.Files;
import java.nio.file.Paths;
import org.apache.jmeter.services.FileServer;
import groovy.json.JsonSlurper

int i = Integer.parseInt(vars.get(&quot;counter&quot;));

if (vars.getObject(&quot;sheet&quot;).get(i).size() != 0) {
	def jsonSlurper = new JsonSlurper();
	def response = jsonSlurper.parseText(prev.getResponseDataAsString());
		
	String MemberWinning = response.SummaryTotal[&quot;${BaseCurrencyName}&quot;].MemberWinning.toString();
	String Turnover = response.SummaryTotal[&quot;${BaseCurrencyName}&quot;].TurnOver.toString();
	String TotalTrans = response.SummaryTotal[&quot;${BaseCurrencyName}&quot;].TotalTransaction.toString();
	String CashoutAmt = response.SummaryTotal[&quot;${BaseCurrencyName}&quot;].CashOut.toString();
	String CashoutShare = response.SummaryTotal[&quot;${BaseCurrencyName}&quot;].CashOutShare.toString();
	String CommissionShare = response.SummaryTotal[&quot;${BaseCurrencyName}&quot;].CommissionShare.toString();
	String AmountDueToColossusBets = response.SummaryTotal[&quot;${BaseCurrencyName}&quot;].AmountDueToCB.toString();

	List&lt;ValueRange&gt; list = Arrays.asList(
      new ValueRange().setRange(&quot;Licensees!I&quot; + (i + 1) + &quot;:J&quot; + (i + 1)).setValues(Arrays.asList(Arrays.asList(Turnover,TotalTrans))),
      new ValueRange().setRange(&quot;Licensees!M&quot; + (i + 1) + &quot;:P&quot; + (i + 1)).setValues(Arrays.asList(Arrays.asList(MemberWinning,CashoutAmt,CashoutShare,CommissionShare))),
      new ValueRange().setRange(&quot;Licensees!AM&quot; + (i + 1) + &quot;:AM&quot; + (i + 1)).setValues(Arrays.asList(Arrays.asList(AmountDueToColossusBets)))
      );     

	vars.getObject(&quot;spreadsheets&quot;).values().batchUpdate(&quot;${glb_LABillingLicensees_GoogleSpreadSheetID}&quot;,
                    new BatchUpdateValuesRequest().setData(list).setValueInputOption(&quot;RAW&quot;))
                    .execute();
	/* CHECK DATA WITH SETTLEMENT REPORT
	 * Turnover &lt;=&gt; Turnover, Total Trans &lt;=&gt; Total Trans, Customer&apos;s Winnings &lt;=&gt; Member Winning, Cash-out Amt &lt;=&gt; Cash-out Amt, Cash-out Share &lt;=&gt; Cash-out Share, Commission Share &lt;=&gt; Commission Share, Amount Due To Colossus Bets &lt;=&gt; Equivalent
	 * 
	 */
	//Get Index of Settlement Data Row that LAP-Colossus Bets Win Loss report need to compare with
	int SettlementDataRowIndex = 0;
	String strCompareDataWithReport = &quot;Settlement Report, ${Licensee}, ${PartyId}, ${ProductName}&quot;;
	for(int j = 0;j&lt;vars.getObject(&quot;sheet&quot;).size();j++) {
		String RowData = vars.getObject(&quot;sheet&quot;).get(j).toString();
		if(RowData.indexOf(strCompareDataWithReport)&gt;=1){
			log.info(strCompareDataWithReport+&quot;: -&gt; &quot;+j.toString());
			SettlementDataRowIndex = j;
			break;
		}
      }

	
	//Get Data from Settlement Data Row
      if(SettlementDataRowIndex&gt;0){
      	
		String Settlement_Turnover = vars.getObject(&quot;sheet&quot;).get(SettlementDataRowIndex).get(8).toString();
		String Settlement_TotalTrans = vars.getObject(&quot;sheet&quot;).get(SettlementDataRowIndex).get(9).toString();
		String Settlement_MemberWinning = vars.getObject(&quot;sheet&quot;).get(SettlementDataRowIndex).get(12).toString();
		String Settlement_CashoutAmt = vars.getObject(&quot;sheet&quot;).get(SettlementDataRowIndex).get(13).toString();
		String Settlement_CashoutShare = vars.getObject(&quot;sheet&quot;).get(SettlementDataRowIndex).get(14).toString();
		String Settlement_CommissionShare = vars.getObject(&quot;sheet&quot;).get(SettlementDataRowIndex).get(15).toString();
		String Settlement_Equivalent = vars.getObject(&quot;sheet&quot;).get(SettlementDataRowIndex).get(11).toString();
	
		String FlagTurnOver = returnStatusFormat(&quot;Fail&quot;);
		String FlagTotalTrans = returnStatusFormat(&quot;Fail&quot;);
		String FlagMemberWinning = returnStatusFormat(&quot;Fail&quot;);
		String FlagCashoutAmt = returnStatusFormat(&quot;Fail&quot;);
		String FlagCashoutShare = returnStatusFormat(&quot;Fail&quot;);
		String FlagCommissionShare = returnStatusFormat(&quot;Fail&quot;);
		String FlagEquivalent = returnStatusFormat(&quot;Fail&quot;);

		if(Math.abs(ConvertStringToFloat(Settlement_Turnover) - ConvertStringToFloat(Turnover))&lt;0.2){
			FlagTurnOver = returnStatusFormat(&quot;Pass&quot;);
		}else{
			AssertionResult.setFailure(true);
		}
		if(Math.abs(ConvertStringToFloat(Settlement_TotalTrans) - ConvertStringToFloat(TotalTrans))&lt;0.2){
			FlagTotalTrans = returnStatusFormat(&quot;Pass&quot;);
		}else{
			AssertionResult.setFailure(true);
		}
		if(Math.abs(ConvertStringToFloat(Settlement_MemberWinning) - ConvertStringToFloat(MemberWinning))&lt;0.2){
			FlagMemberWinning = returnStatusFormat(&quot;Pass&quot;);
		}else{
			AssertionResult.setFailure(true);
		}
		if(Math.abs(ConvertStringToFloat(Settlement_CashoutAmt) - ConvertStringToFloat(CashoutAmt))&lt;0.2){
			FlagCashoutAmt = returnStatusFormat(&quot;Pass&quot;);
		}else{
			AssertionResult.setFailure(true);
		}
		if(Math.abs(ConvertStringToFloat(Settlement_CashoutShare) - ConvertStringToFloat(CashoutShare))&lt;0.2){
			FlagCashoutShare = returnStatusFormat(&quot;Pass&quot;);
		}else{
			AssertionResult.setFailure(true);
		}
		if(Math.abs(ConvertStringToFloat(Settlement_CommissionShare) - ConvertStringToFloat(CommissionShare))&lt;0.2){
			FlagCommissionShare = returnStatusFormat(&quot;Pass&quot;);
		}else{
			AssertionResult.setFailure(true);
		}
		if(Math.abs(ConvertStringToFloat(Settlement_Equivalent) - ConvertStringToFloat(AmountDueToColossusBets))&lt;0.2){
			FlagEquivalent = returnStatusFormat(&quot;Pass&quot;);
		}else{
			AssertionResult.setFailure(true);
		}
		
		def path = FileServer.getFileServer().getBaseDir();
		File file = new File(path + &quot;/&quot;+&quot;${glb_Report_CheckMonthlyBilling_File}&quot;);
		
		WriteHeaderToReport(file,&quot;${Licensee}&quot;, &quot;${Report}&quot;, &quot;Settlement Report&quot;);

		WriteResultToReport(file,&quot;TotalTrans&quot;,TotalTrans,Settlement_TotalTrans,FlagTotalTrans);
		WriteResultToReport(file,&quot;Turnover&quot;,Turnover,Settlement_Turnover,FlagTurnOver);
		WriteResultToReport(file,&quot;Customer&apos;s Winnings&quot;,MemberWinning,Settlement_MemberWinning,FlagMemberWinning);
		WriteResultToReport(file,&quot;Cash-out Amt&quot;,CashoutAmt,Settlement_CashoutAmt,FlagCashoutAmt);
		WriteResultToReport(file,&quot;Cash-out Share&quot;,CashoutShare,Settlement_CashoutShare,FlagCashoutShare);
		WriteResultToReport(file,&quot;Commission Share&quot;,CommissionShare,Settlement_CommissionShare,FlagCommissionShare);
		WriteResultToReport(file,&quot;Amt Due To CB vs Equivalent&quot;,AmountDueToColossusBets,Settlement_Equivalent,FlagEquivalent);
		
      }

      /* CHECK DATA WITH LA - Colossus Bet Win Loss
	 * Turnover &lt;=&gt; Turnover, Total Trans &lt;=&gt; Total Trans, Customer&apos;s Winnings &lt;=&gt; Member Winning, Cash-out Amt &lt;=&gt; Cash-out Amt, Cash-out Share &lt;=&gt; Cash-out Share, Commission Share &lt;=&gt; Commission Share, Amount Due To Colossus Bets &lt;=&gt; Equivalent
	 * 
	 */
	//Get Index of Colossus Bet Win Loss Data Row that LAP-Colossus Bets Win Loss report need to compare with
	int LACBWLDataRowIndex = 0;
	strCompareDataWithReport = &quot;Colossus Bet Win Loss, ${Licensee}, ${PartyId}, ${ProductName}&quot;;
	for(int j = 0;j&lt;vars.getObject(&quot;sheet&quot;).size();j++) {
		String RowData = vars.getObject(&quot;sheet&quot;).get(j).toString();
		if(RowData.indexOf(strCompareDataWithReport)&gt;=1){
			log.info(strCompareDataWithReport+&quot;: -&gt; &quot;+j.toString());
			LACBWLDataRowIndex = j;
			break;
		}
      }

	
	//Get Data from Colossus Bet Win Loss Data Row
      if(LACBWLDataRowIndex&gt;0){
      	
		String LACBWL_Turnover = vars.getObject(&quot;sheet&quot;).get(LACBWLDataRowIndex).get(8).toString();
		String LACBWL_TotalTrans = vars.getObject(&quot;sheet&quot;).get(LACBWLDataRowIndex).get(9).toString();
		String LACBWL_MemberWinAmountPrize = vars.getObject(&quot;sheet&quot;).get(LACBWLDataRowIndex).get(29).toString();
		String LACBWL_MemberWinAmountCashOut = vars.getObject(&quot;sheet&quot;).get(LACBWLDataRowIndex).get(30).toString();
	
		String FlagTurnOver = returnStatusFormat(&quot;Fail&quot;);
		String FlagTotalTrans = returnStatusFormat(&quot;Fail&quot;);
		String FlagMemberWinning = returnStatusFormat(&quot;Fail&quot;);
		String FlagCashoutAmt = returnStatusFormat(&quot;Fail&quot;);

		if(Math.abs(ConvertStringToFloat(LACBWL_Turnover) - ConvertStringToFloat(Turnover))&lt;0.2){
			FlagTurnOver = returnStatusFormat(&quot;Pass&quot;);
		}else{
			AssertionResult.setFailure(true);
		}
		if(Math.abs(ConvertStringToFloat(LACBWL_TotalTrans) - ConvertStringToFloat(TotalTrans))&lt;0.2){
			FlagTotalTrans = returnStatusFormat(&quot;Pass&quot;);
		}else{
			AssertionResult.setFailure(true);
		}
		if(Math.abs(ConvertStringToFloat(LACBWL_MemberWinAmountPrize) - ConvertStringToFloat(MemberWinning))&lt;0.2){
			FlagMemberWinning = returnStatusFormat(&quot;Pass&quot;);
		}else{
			AssertionResult.setFailure(true);
		}
		if(Math.abs(ConvertStringToFloat(LACBWL_MemberWinAmountCashOut) - ConvertStringToFloat(CashoutAmt))&lt;0.2){
			FlagCashoutAmt = returnStatusFormat(&quot;Pass&quot;);
		}else{
			AssertionResult.setFailure(true);
		}
		
		def path = FileServer.getFileServer().getBaseDir();
		File file = new File(path + &quot;/&quot;+&quot;${glb_Report_CheckMonthlyBilling_File}&quot;);
		
		WriteHeaderToReport(file,&quot;${Licensee}&quot;, &quot;${Report}&quot;, &quot;Colossus Bet Win Loss&quot;);

		WriteResultToReport(file,&quot;TotalTrans&quot;,TotalTrans,LACBWL_TotalTrans,FlagTotalTrans);
		WriteResultToReport(file,&quot;Turnover&quot;,Turnover,LACBWL_Turnover,FlagTurnOver);
		WriteResultToReport(file,&quot;Customer&apos;s Winnings&quot;,MemberWinning,LACBWL_MemberWinAmountPrize,FlagMemberWinning);
		WriteResultToReport(file,&quot;Cash-out Amt&quot;,CashoutAmt,LACBWL_MemberWinAmountCashOut,FlagCashoutAmt);
		
      }
}

String ChangeDataFormat(String str){
	/* This function will change String from -185,842.93 -&gt; (185,842.93)*/
	String string = str;//.replaceAll(&quot;(&quot;,&quot;&quot;);
	if(string.indexOf(&quot;-&quot;)&gt;=0){
		return string.replaceAll(&quot;-&quot;,&quot;(&quot;) + &quot;)&quot;;
	}
   	return string;
}

String returnStatusFormat(String str){
	String string = str;
	if(string==&quot;Fail&quot;){
		return &quot;&lt;span style=&apos;color:#f33&apos;&gt;Fail&lt;/span&gt;&quot;;
	}else if(string==&quot;Pass&quot;){
		return &quot;&lt;span style=&apos;color:#1d4&apos;&gt;Pass&lt;/span&gt;&quot;;
	}
	return string;
}
def WriteHeaderToReport(File file,String Licensee, String Report1, String Report2){
	file.append (&quot;&lt;div class=&apos;TableBorderStyleHeader&apos;&gt;&lt;span style=&apos;color:red;&apos;&gt;&quot;+Licensee+&quot;&lt;/span&gt; - Compare Data bettwen &lt;span style=&apos;color:red;&apos;&gt;&quot;+Report1+&quot;&lt;/span&gt; &amp; &lt;span style=&apos;color:red;&apos;&gt;&quot;+Report2+&quot;&lt;/span&gt;&lt;/div&gt;&quot;);
	file.append (&quot;&lt;div class=&apos;TableBorderStyleDataProperty&apos;&gt;&amp;nbsp;&lt;/div&gt;&quot;);
	file.append (&quot;&lt;div class=&apos;TableBorderStyleHeaderValue&apos;&gt;&quot;+Report1+&quot;&lt;/div&gt;&quot;);
	file.append (&quot;&lt;div class=&apos;TableBorderStyleHeaderValue&apos;&gt;&quot;+Report2+&quot;&lt;/div&gt;&quot;);
	file.append (&quot;&lt;div class=&apos;TableBorderStyleHeaderStatus&apos;&gt;Status&lt;/div&gt;&quot;);
}
def WriteResultToReport(File file,String DataProperty, String value1, String value2, String Result){
	file.append (&quot;&lt;div class=&apos;TableBorderStyleDataProperty&apos;&gt;&quot;+DataProperty+&quot;&lt;/div&gt;&quot;);
	file.append (&quot;&lt;div class=&apos;TableBorderStyleValue&apos;&gt;&quot;+value1+&quot;&lt;/div&gt;&quot;);
	file.append (&quot;&lt;div class=&apos;TableBorderStyleValue&apos;&gt;&quot;+value2+&quot;&lt;/div&gt;&quot;);
	file.append (&quot;&lt;div class=&apos;TableBorderStyleStatus&apos;&gt;&quot;+Result+&quot;&lt;/div&gt;&quot;);
}
String ConvertNegativeDataToZero(String str){
	String string = str;
	if(string.indexOf(&quot;(&quot;)&gt;=0){
		return &quot;0&quot;;
	}
	return string;
}

/*  Licensee Win Loss = - SettlementReport.Customer WL
* If LicenseeWinLoss &lt; 0 -&gt; Web show -LicenseeWinLoss
* Else show LicenseeWinLoss
 */
String ConvertLicenseeWinLossToCustomerWL(String str){
	String string = str;
	if(string.indexOf(&quot;-&quot;)&gt;=0){
		string = string.replaceAll(&quot;-&quot;,&quot;&quot;);
		//string = string.replaceAll(&apos;\\)&apos;,&apos;&apos;);
		//string = string.substring(1,string.length()-1);
		return string;
	}else{
		return &quot;(&quot;+string+&quot;)&quot;;
	}
}

String RemoveCommaInString(String str){
	/* This function will remove comma in String from -185,842.93 -&gt; -185842.93*/
	String string = str;//.replaceAll(&quot;(&quot;,&quot;&quot;);
	if(string.indexOf(&quot;,&quot;)&gt;=0){
		return string.replaceAll(&quot;,&quot;,&quot;&quot;);
	}
   	return string;
}

float ConvertStringToFloat(String str, Boolean FlagReturnZeroWhenNegative=false){
	String string = str;
	string = RemoveCommaInString(string);
	if(string.indexOf(&quot;(&quot;)&gt;=0){
		string = &quot;-&quot;+string.substring(1,string.length()-1);
	}
	float returnValue = Float.parseFloat(string);
	if(returnValue&lt;0 &amp;&amp; FlagReturnZeroWhenNegative==true){
		return 0;
	}
	return returnValue;
}

