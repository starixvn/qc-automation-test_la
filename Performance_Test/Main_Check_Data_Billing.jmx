        <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="JSR223 Sampler - Excel" enabled="false">
          <stringProp name="scriptLanguage">groovy</stringProp>
          <stringProp name="parameters"></stringProp>
          <stringProp name="filename"></stringProp>
          <stringProp name="cacheKey">de665367-15ad-4bed-8050-a0348fbe77ca</stringProp>
          <stringProp name="script">import org.apache.poi.xssf.usermodel.XSSFWorkbook;
import org.apache.poi.xssf.usermodel.XSSFSheet;
import org.apache.poi.xssf.usermodel.XSSFRow;
import java.io.*;
//import org.apache.jmeter.services.FileServer;

//def path = FileServer.getFileServer().getBaseDir();

XSSFWorkbook book = &quot;&quot;;

try {
	
	InputStream inputStream = new FileInputStream(new File(&quot;${pathToFile}&quot;));
	book = new XSSFWorkbook(inputStream);
	inputStream.close();

} catch (Exception e) {

     log.info(&quot;!!!!!!!!&quot; + e.getMessage() + &quot;!!!!!!!!!!!!!!!&quot;);
}

if (!book.equals(&quot;&quot;)) {

	vars.putObject(&quot;book&quot;, book);		
	
} else {

	SampleResult.setStopTestNow(true);	
}</stringProp>
        </JSR223Sampler>
        <hashTree/>
        <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="JSR223 Sampler" enabled="false">
          <stringProp name="scriptLanguage">groovy</stringProp>
          <stringProp name="parameters"></stringProp>
          <stringProp name="filename"></stringProp>
          <stringProp name="cacheKey"></stringProp>
          <stringProp name="script">import org.apache.jmeter.services.FileServer;

def path = FileServer.getFileServer().getBaseDir();
def csvFile = new File(path+&apos;/DataCenterCheckBilling.csv&apos;)
def lines = csvFile.readLines()


def secondLine = lines.get(1)
def entries = secondLine.split(&quot;,&quot;)
entries[1] = &apos;hello&apos;
secondLine = entries.join(&apos;,&apos;)
lines.set(1, secondLine)

csvFile.withWriter{ out -&gt;
    lines.each {out.println it}
}</stringProp>
        </JSR223Sampler>
        <hashTree/>
        <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="Connect Google SpreadSheet" enabled="true">
          <stringProp name="scriptLanguage">groovy</stringProp>
          <stringProp name="parameters"></stringProp>
          <stringProp name="filename"></stringProp>
          <stringProp name="cacheKey"></stringProp>
          <stringProp name="script">import com.google.api.client.auth.oauth2.Credential;
import com.google.api.client.googleapis.auth.oauth2.GoogleCredential;
import com.google.api.services.sheets.v4.SheetsScopes;
import com.google.api.client.googleapis.javanet.GoogleNetHttpTransport;
import com.google.api.client.json.jackson2.JacksonFactory;
import com.google.api.services.sheets.v4.Sheets;
import com.google.api.services.sheets.v4.SheetsRequestInitializer;


import java.nio.file.Files;
import java.nio.file.Paths;
import java.util.Arrays;
import java.util.List;

import org.apache.jmeter.services.FileServer;

def path = FileServer.getFileServer().getBaseDir();

/*CREATE REPORT FILE TO SEND MAIL*/
File file = new File(path + &quot;/&quot;+&quot;${glb_Report_CheckMonthlyBilling_File}&quot;);
file.delete();
//write stylesheet
file.append (&quot;&lt;style&gt;.TableBorderStyleStatus{width:100px;float:left;text-align: center;border-bottom: 2px solid #DCDCDC;border-left: 2px solid #DCDCDC;}.TableBorderStyleHeaderStatus{width:100px;float:left;font-weight: bold;text-align: center;border-bottom: 2px solid #DCDCDC;border-left: 2px solid #DCDCDC;}.TableBorderStyleHeaderValue{width:300px;float:left;font-weight: bold;text-align: center;border-bottom: 2px solid #DCDCDC;border-left: 2px solid #DCDCDC;}.TableBorderStyleValue{width:300px;float:left;text-align: center;border-bottom: 2px solid #DCDCDC;border-left: 2px solid #DCDCDC;}.TableBorderStyleDataProperty{width:300px;float:left;font-weight: bold;border-bottom: 2px solid #DCDCDC;}.TableBorderStyleHeader{width:1006px;font-weight: bold;border-bottom: 2px solid #DCDCDC;}.TableBorderStyleBody{width:1006px;float:left;border-top: 2px solid #DCDCDC;border-left: 2px solid #DCDCDC;border-right: 2px solid #DCDCDC;}&lt;/style&gt;&quot;);
//write Data Frame
file.append (&quot;&lt;h1&gt;Check Data from &quot;+&quot;${glb_FirstDateofPrevMonth_2}&quot;+&quot; to &quot;+&quot;${glb_LastDateofPrevMonth_2}&quot;+&quot;&lt;/h1&gt;&quot;);
//file.append (&quot;&lt;h3&gt;Data Between LA Reports&lt;/h3&gt;&quot;);
file.append (&quot;&lt;div class=&apos;TableBorderStyleBody&apos;&gt;&quot;);
/*====================*/

//String CleanTestingDataScript = new File(path+&apos;/CreateTestingData/CleanTestingDataScript.sql&apos;).text;


GoogleCredential credential = GoogleCredential.fromStream(Files.newInputStream(Paths.get(path+&quot;/client_secret.json&quot;))).createScoped(Arrays.asList(SheetsScopes.DRIVE));

Sheets.Spreadsheets spreadsheets = new Sheets.Builder(GoogleNetHttpTransport.newTrustedTransport(),JacksonFactory.getDefaultInstance(),credential).setApplicationName(&quot; &quot;).build().spreadsheets();
                    
vars.putObject(&quot;spreadsheets&quot;, spreadsheets);

List&lt;List&lt;Object&gt;&gt; sheet = spreadsheets.values().get(&quot;${glb_LABillingLicensees_GoogleSpreadSheetID}&quot;, &quot;Licensees&quot;).setMajorDimension(&quot;ROWS&quot;).setValueRenderOption(&quot;UNFORMATTED_VALUE&quot;).setDateTimeRenderOption(&quot;FORMATTED_STRING&quot;).execute().getValues();  

                                    
vars.putObject(&quot;sheet&quot;, sheet);
//log.info(&quot;william --- &quot;+vars.getObject(&quot;sheet&quot;).get(0).toString());



/*String[] str;
str = vars.getObject(&quot;sheet&quot;).get(0).toString().split(&apos;,&apos;);
for( String values : str )
      log.info(&quot;william --- &quot;+values);
*/</stringProp>
        </JSR223Sampler>
