              <XPathExtractor guiclass="XPathExtractorGui" testclass="XPathExtractor" testname="Amount Due to Cash Out - B - On Profit Sharing" enabled="true">
                <stringProp name="XPathExtractor.default">Not_Found</stringProp>
                <stringProp name="XPathExtractor.refname">Amount Due to Cash Out - B - On Profit Sharing</stringProp>
                <stringProp name="XPathExtractor.matchNumber">-1</stringProp>
                <stringProp name="XPathExtractor.xpathQuery">//td[contains(text(),&apos;Grand Total&apos;)]/following::td[13]</stringProp>
                <boolProp name="XPathExtractor.validate">false</boolProp>
                <boolProp name="XPathExtractor.tolerant">true</boolProp>
                <boolProp name="XPathExtractor.namespace">false</boolProp>
              </XPathExtractor>
              <hashTree/>
              <JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="Save Data Cash Out Win Loss To Google SpreadSheet And Compare Data with Settlement Report" enabled="true">
                <stringProp name="cacheKey"></stringProp>
                <stringProp name="filename"></stringProp>
                <stringProp name="parameters"></stringProp>
                <stringProp name="script">import com.google.api.services.sheets.v4.model.ValueRange;
import com.google.api.services.sheets.v4.model.BatchUpdateValuesRequest;
import java.util.regex.Matcher;
import java.util.regex.Pattern;
import java.nio.file.Files;
import java.nio.file.Paths;
import org.apache.jmeter.services.FileServer;

int i = Integer.parseInt(vars.get(&quot;counter&quot;));

if (vars.getObject(&quot;sheet&quot;).get(i).size() != 0) {
	String CashOutTimes = &quot;${Cash Out Times}&quot;;
	String CashOutTickets = &quot;${Cash Out Tickets}&quot;;
	String CashOutValue = &quot;${Cash Out Value}&quot;;
	String BuybackAmountTotal = &quot;${Buyback Amount - Total}&quot;;
	String TicketsPayout = &quot;${Tickets Payout}&quot;;
	String CashOutCommission = &quot;${Cash Out Commission}&quot;;
	String IncomeAOnBBAmt = &quot;${Income - A - On BB Amt}&quot;;
	String IncomeBOnProfitSharing = &quot;${Income - B - On Profit Sharing}&quot;;
	String AmountDuetoCashOutAOnBBAmt = &quot;${Amount Due to Cash Out - A - On BB Amt}&quot;;
	String AmountDuetoCashOutBOnProfitSharing = &quot;${Amount Due to Cash Out - B - On Profit Sharing}&quot;;
	List&lt;ValueRange&gt; list = Arrays.asList(
      new ValueRange().setRange(&quot;Licensees!Q&quot; + (i + 1) + &quot;:V&quot; + (i + 1)).setValues(Arrays.asList(Arrays.asList(CashOutTimes,CashOutTickets,CashOutValue,BuybackAmountTotal,TicketsPayout,CashOutCommission))),
      new ValueRange().setRange(&quot;Licensees!AF&quot; + (i + 1) + &quot;:AI&quot; + (i + 1)).setValues(Arrays.asList(Arrays.asList(IncomeAOnBBAmt,IncomeBOnProfitSharing,AmountDuetoCashOutAOnBBAmt,AmountDuetoCashOutBOnProfitSharing)))
      );     

	vars.getObject(&quot;spreadsheets&quot;).values().batchUpdate(&quot;${glb_LABillingLicensees_GoogleSpreadSheetID}&quot;,
                    new BatchUpdateValuesRequest().setData(list).setValueInputOption(&quot;RAW&quot;))
                    .execute();
	/* CHECK DATA WITH SETTLEMENT REPORT
	 * Cash Out Times = Cash Out Times, Cash Out Tickets = Cash Out Tickets, Cash Out Value = Cash Out Value, Buyback Amount - Total = Buyback Amount - Total, Tickets Payout = Tickets Payout,
	 * Cash Out Commission = Cash Out Commission, Max((&quot;Income - A - On BB Amt&quot; + &quot;Amount Due to Cash Out - A - On BB Amt&quot;),(&quot;Income - B - On Profit Sharing&quot; + &quot;Amount Due to Cash Out - B - On Profit Sharing&quot;)) = Equivalent
	 * 
	 */
	//Get Index of Settlement Data Row that Cash Out Win Loss report need to compare with
	int SettlementDataRowIndex = 0;
	String strCompareDataWithReport = &quot;Settlement Report, ${Licensee}, ${PartyId}, ${ProductName}&quot;;
	for(int j = 0;j&lt;vars.getObject(&quot;sheet&quot;).size();j++) {
		String RowData = vars.getObject(&quot;sheet&quot;).get(j).toString();
		if(RowData.indexOf(strCompareDataWithReport)&gt;=1){
			log.info(strCompareDataWithReport+&quot;: -&gt; &quot;+j.toString());
			SettlementDataRowIndex = j;
			break;
		}
      }

	
	//Get Data from Settlement Data Row
      if(SettlementDataRowIndex&gt;0){
      	//String Settlement_CustomerWinLoss = vars.getObject(&quot;sheet&quot;).get(SettlementDataRowIndex).get(10).toString();
		String Settlement_CashOutTimes = vars.getObject(&quot;sheet&quot;).get(SettlementDataRowIndex).get(16).toString();
		String Settlement_CashOutTickets = vars.getObject(&quot;sheet&quot;).get(SettlementDataRowIndex).get(17).toString();
		String Settlement_CashOutValue = vars.getObject(&quot;sheet&quot;).get(SettlementDataRowIndex).get(18).toString();
		String Settlement_BuybackAmountTotal = vars.getObject(&quot;sheet&quot;).get(SettlementDataRowIndex).get(19).toString();
		String Settlement_TicketsPayout = vars.getObject(&quot;sheet&quot;).get(SettlementDataRowIndex).get(20).toString();
		String Settlement_CashOutCommission = vars.getObject(&quot;sheet&quot;).get(SettlementDataRowIndex).get(21).toString();
		String Settlement_Equivalent = vars.getObject(&quot;sheet&quot;).get(SettlementDataRowIndex).get(11).toString();

		float IncomeAOnBBAmt_float = Float.parseFloat(RemoveCommaInString(IncomeAOnBBAmt));
		float IncomeBOnProfitSharing_float = Float.parseFloat(RemoveCommaInString(IncomeBOnProfitSharing));
		float AmountDuetoCashOutAOnBBAmt_float = Float.parseFloat(RemoveCommaInString(AmountDuetoCashOutAOnBBAmt));
		float AmountDuetoCashOutBOnProfitSharing_float = Float.parseFloat(RemoveCommaInString(AmountDuetoCashOutBOnProfitSharing));
		float CashOutEquivalent = Math.max(IncomeAOnBBAmt_float+AmountDuetoCashOutAOnBBAmt_float, IncomeBOnProfitSharing_float+AmountDuetoCashOutBOnProfitSharing_float);
		//log.info(&quot;William Test &quot;+CashOut_Equivalent.toString()+&quot;=============&quot;);
		
		String FlagCashOutTimes = returnStatusFormat(&quot;Fail&quot;);
		String FlagCashOutTickets = returnStatusFormat(&quot;Fail&quot;);
		String FlagCashOutValue = returnStatusFormat(&quot;Fail&quot;);
		String FlagBuybackAmountTotal = returnStatusFormat(&quot;Fail&quot;);
		String FlagTicketsPayout = returnStatusFormat(&quot;Fail&quot;);
		String FlagCashOutCommission = returnStatusFormat(&quot;Fail&quot;);
		String FlagEquivalent = returnStatusFormat(&quot;Fail&quot;);
		
		if(Settlement_CashOutTimes == CashOutTimes){
			FlagCashOutTimes = returnStatusFormat(&quot;Pass&quot;);
		}else{
			AssertionResult.setFailure(true);
		}
		if(Settlement_CashOutTickets == CashOutTickets){
			FlagCashOutTickets = returnStatusFormat(&quot;Pass&quot;);
		}else{
			AssertionResult.setFailure(true);
		}
		if(Settlement_CashOutValue == CashOutValue){
			FlagCashOutValue = returnStatusFormat(&quot;Pass&quot;);
		}else{
			AssertionResult.setFailure(true);
		}
		if(Settlement_BuybackAmountTotal == BuybackAmountTotal){
			FlagBuybackAmountTotal = returnStatusFormat(&quot;Pass&quot;);
		}else{
			AssertionResult.setFailure(true);
		}
		if(Settlement_TicketsPayout == TicketsPayout){
			FlagTicketsPayout = returnStatusFormat(&quot;Pass&quot;);
		}else{
			AssertionResult.setFailure(true);
		}
		if(Settlement_CashOutCommission == CashOutCommission){
			FlagCashOutCommission = returnStatusFormat(&quot;Pass&quot;);
		}else{
			AssertionResult.setFailure(true);
		}
		if(Math.abs(ConvertStringToFloat(Settlement_Equivalent)-CashOutEquivalent)&lt;0.02){
			FlagEquivalent = returnStatusFormat(&quot;Pass&quot;);
		}else{
			AssertionResult.setFailure(true);
		}

		def path = FileServer.getFileServer().getBaseDir();
		File file = new File(path + &quot;/&quot;+&quot;${glb_Report_CheckMonthlyBilling_File}&quot;);
		
		WriteHeaderToReport(file,&quot;${Licensee}&quot;, &quot;${Report}&quot;, &quot;Settlement Report&quot;);

		WriteResultToReport(file,&quot;Cash Out Times&quot;,CashOutTimes,Settlement_CashOutTimes,FlagCashOutTimes);
		WriteResultToReport(file,&quot;Cash Out Tickets&quot;,CashOutTickets,Settlement_CashOutTickets,FlagCashOutTickets);
		WriteResultToReport(file,&quot;Cash Out Value&quot;,CashOutValue,Settlement_CashOutValue,FlagCashOutValue);
		WriteResultToReport(file,&quot;Buyback Amt - Total&quot;,BuybackAmountTotal,Settlement_BuybackAmountTotal,FlagBuybackAmountTotal);
		WriteResultToReport(file,&quot;Tickets Payout&quot;,TicketsPayout,Settlement_TicketsPayout,FlagTicketsPayout);
		WriteResultToReport(file,&quot;Cash Out Commission&quot;,CashOutCommission,Settlement_CashOutCommission,FlagCashOutCommission);
		WriteResultToReport(file,&quot;Cash Out Equivalent&quot;,CashOutEquivalent.toString(),Settlement_Equivalent,FlagEquivalent);
		
		//long a = Double.valueOf(&quot;2,373.39&quot;);//&quot;2373.39&quot;.toInteger();//IncomeAOnBBAmt.toInteger();
		//if(a&gt;0){
			//log.info(&quot;William Test=================&quot;);
		//}
      }

      
}

String ChangeDataFormat(String str){
	/* This function will change String from -185,842.93 -&gt; (185,842.93)*/
	String string = str;//.replaceAll(&quot;(&quot;,&quot;&quot;);
	if(string.indexOf(&quot;-&quot;)&gt;=0){
		return string.replaceAll(&quot;-&quot;,&quot;(&quot;) + &quot;)&quot;;
	}
   	return string;
}

String RemoveCommaInString(String str){
	/* This function will remove comma in String from -185,842.93 -&gt; -185842.93*/
	String string = str;//.replaceAll(&quot;(&quot;,&quot;&quot;);
	if(string.indexOf(&quot;,&quot;)&gt;=0){
		return string.replaceAll(&quot;,&quot;,&quot;&quot;);
	}
   	return string;
}

String returnStatusFormat(String str){
	String string = str;
	if(string==&quot;Fail&quot;){
		return &quot;&lt;span style=&apos;color:#f33&apos;&gt;Fail&lt;/span&gt;&quot;;
	}else if(string==&quot;Pass&quot;){
		return &quot;&lt;span style=&apos;color:#1d4&apos;&gt;Pass&lt;/span&gt;&quot;;
	}
	return string;
}
def WriteHeaderToReport(File file,String Licensee, String Report1, String Report2){
	file.append (&quot;&lt;div class=&apos;TableBorderStyleHeader&apos;&gt;&lt;span style=&apos;color:red;&apos;&gt;&quot;+Licensee+&quot;&lt;/span&gt; - Compare Data bettwen &lt;span style=&apos;color:red;&apos;&gt;&quot;+Report1+&quot;&lt;/span&gt; &amp; &lt;span style=&apos;color:red;&apos;&gt;&quot;+Report2+&quot;&lt;/span&gt;&lt;/div&gt;&quot;);
	file.append (&quot;&lt;div class=&apos;TableBorderStyleDataProperty&apos;&gt;&amp;nbsp;&lt;/div&gt;&quot;);
	file.append (&quot;&lt;div class=&apos;TableBorderStyleHeaderValue&apos;&gt;&quot;+Report1+&quot;&lt;/div&gt;&quot;);
	file.append (&quot;&lt;div class=&apos;TableBorderStyleHeaderValue&apos;&gt;&quot;+Report2+&quot;&lt;/div&gt;&quot;);
	file.append (&quot;&lt;div class=&apos;TableBorderStyleHeaderStatus&apos;&gt;Status&lt;/div&gt;&quot;);
}
def WriteResultToReport(File file,String DataProperty, String value1, String value2, String Result){
	file.append (&quot;&lt;div class=&apos;TableBorderStyleDataProperty&apos;&gt;&quot;+DataProperty+&quot;&lt;/div&gt;&quot;);
	file.append (&quot;&lt;div class=&apos;TableBorderStyleValue&apos;&gt;&quot;+value1+&quot;&lt;/div&gt;&quot;);
	file.append (&quot;&lt;div class=&apos;TableBorderStyleValue&apos;&gt;&quot;+value2+&quot;&lt;/div&gt;&quot;);
	file.append (&quot;&lt;div class=&apos;TableBorderStyleStatus&apos;&gt;&quot;+Result+&quot;&lt;/div&gt;&quot;);
}
String ConvertNegativeDataToZero(String str){
	String string = str;
	if(string.indexOf(&quot;(&quot;)&gt;=0){
		return &quot;0&quot;;
	}
	return string;
}


float ConvertStringToFloat(String str){
	String string = str;
	string = RemoveCommaInString(string);
	if(string.indexOf(&quot;(&quot;)&gt;=0){
		string = string.substring(1,string.length()-1);
	}
	return Float.parseFloat(string);
}
