              <hashTree/>
              <JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="Save Data Keno Win Loss To Google SpreadSheet And Compare Data with Settlement Report" enabled="true">
                <stringProp name="cacheKey"></stringProp>
                <stringProp name="filename"></stringProp>
                <stringProp name="parameters"></stringProp>
                <stringProp name="script">import com.google.api.services.sheets.v4.model.ValueRange;
import com.google.api.services.sheets.v4.model.BatchUpdateValuesRequest;
import java.util.regex.Matcher;
import java.util.regex.Pattern;
import java.nio.file.Files;
import java.nio.file.Paths;
import org.apache.jmeter.services.FileServer;

int i = Integer.parseInt(vars.get(&quot;counter&quot;));

if (vars.getObject(&quot;sheet&quot;).get(i).size() != 0) {
	String CustomerWinLoss = &quot;${Customer Win Loss}&quot;;
	String Turnover = &quot;${Turnover}&quot;;
	String TotalTrans = &quot;${Total Trans}&quot;;
	String Licensingfee = &quot;${Licensing fee}&quot;;
	List&lt;ValueRange&gt; list = Arrays.asList(
      new ValueRange().setRange(&quot;Licensees!I&quot; + (i + 1) + &quot;:K&quot; + (i + 1)).setValues(Arrays.asList(Arrays.asList(Turnover,TotalTrans,CustomerWinLoss))),
      new ValueRange().setRange(&quot;Licensees!Y&quot; + (i + 1) + &quot;:Y&quot; + (i + 1)).setValues(Arrays.asList(Arrays.asList(Licensingfee)))
      );     

	vars.getObject(&quot;spreadsheets&quot;).values().batchUpdate(&quot;${glb_LABillingLicensees_GoogleSpreadSheetID}&quot;,
                    new BatchUpdateValuesRequest().setData(list).setValueInputOption(&quot;RAW&quot;))
                    .execute();
	/* CHECK DATA WITH SETTLEMENT REPORT
	 * Turnover &lt;=&gt; Turnover, Total Trans &lt;=&gt; Total Trans, Customer Win Loss &lt;=&gt; Customer Win Loss, Licensing fee &lt;=&gt; Equivalent
	 * 
	 */
	//Get Index of Settlement Data Row that Keno Win Loss report need to compare with
	int SettlementDataRowIndex = 0;
	String strCompareDataWithReport = &quot;Settlement Report, ${Licensee}, ${PartyId}, ${ProductName}&quot;;
	for(int j = 0;j&lt;vars.getObject(&quot;sheet&quot;).size();j++) {
		String RowData = vars.getObject(&quot;sheet&quot;).get(j).toString();
		if(RowData.indexOf(strCompareDataWithReport)&gt;=1){
			log.info(strCompareDataWithReport+&quot;: -&gt; &quot;+j.toString());
			SettlementDataRowIndex = j;
			break;
		}
      }

	
	//Get Data from Settlement Data Row
      if(SettlementDataRowIndex&gt;0){
      	String Settlement_CustomerWinLoss = vars.getObject(&quot;sheet&quot;).get(SettlementDataRowIndex).get(10).toString();
		String Settlement_Turnover = vars.getObject(&quot;sheet&quot;).get(SettlementDataRowIndex).get(8).toString();
		String Settlement_TotalTrans = vars.getObject(&quot;sheet&quot;).get(SettlementDataRowIndex).get(9).toString();
		String Settlement_Equivalent = vars.getObject(&quot;sheet&quot;).get(SettlementDataRowIndex).get(11).toString();
		
		String FlagTurnOver = returnStatusFormat(&quot;Fail&quot;);
		String FlagTotalTrans = returnStatusFormat(&quot;Fail&quot;);
		String FlagEquivalent = returnStatusFormat(&quot;Fail&quot;);
		String FlagCustomerWinLoss = returnStatusFormat(&quot;Fail&quot;);

		
		if(Settlement_Turnover == Turnover){
			FlagTurnOver = returnStatusFormat(&quot;Pass&quot;);
		}else{
			AssertionResult.setFailure(true);
		}
		if(Settlement_TotalTrans == TotalTrans){
			FlagTotalTrans = returnStatusFormat(&quot;Pass&quot;);
		}else{
			AssertionResult.setFailure(true);
		}
		if(Settlement_CustomerWinLoss == ChangeDataFormat(CustomerWinLoss)){
			FlagCustomerWinLoss = returnStatusFormat(&quot;Pass&quot;);
		}else{
			AssertionResult.setFailure(true);
		}
		if(ConvertNegativeDataToZero(Settlement_Equivalent) == Licensingfee){
			FlagEquivalent = returnStatusFormat(&quot;Pass&quot;);
		}else{
			AssertionResult.setFailure(true);
		}

		def path = FileServer.getFileServer().getBaseDir();
		File file = new File(path + &quot;/&quot;+&quot;${glb_Report_CheckMonthlyBilling_File}&quot;);
		
		WriteHeaderToReport(file,&quot;${Licensee}&quot;, &quot;${Report}&quot;, &quot;Settlement Report&quot;);

		WriteResultToReport(file,&quot;TotalTrans&quot;,TotalTrans,Settlement_TotalTrans,FlagTotalTrans);
		WriteResultToReport(file,&quot;Turnover&quot;,Turnover,Settlement_Turnover,FlagTurnOver);
		WriteResultToReport(file,&quot;Customer WL&quot;,CustomerWinLoss,Settlement_CustomerWinLoss,FlagCustomerWinLoss);
		WriteResultToReport(file,&quot;Licensing fee &amp; Equivalent&quot;,Licensingfee,Settlement_Equivalent,FlagEquivalent);
		
      }

      
}

String ChangeDataFormat(String str){
	/* This function will change String from -185,842.93 -&gt; (185,842.93)*/
	String string = str;//.replaceAll(&quot;(&quot;,&quot;&quot;);
	if(string.indexOf(&quot;-&quot;)&gt;=0){
		return string.replaceAll(&quot;-&quot;,&quot;(&quot;) + &quot;)&quot;;
	}
   	return string;
}

String returnStatusFormat(String str){
	String string = str;
	if(string==&quot;Fail&quot;){
		return &quot;&lt;span style=&apos;color:#f33&apos;&gt;Fail&lt;/span&gt;&quot;;
	}else if(string==&quot;Pass&quot;){
		return &quot;&lt;span style=&apos;color:#1d4&apos;&gt;Pass&lt;/span&gt;&quot;;
	}
	return string;
}
def WriteHeaderToReport(File file,String Licensee, String Report1, String Report2){
	file.append (&quot;&lt;div class=&apos;TableBorderStyleHeader&apos;&gt;&lt;span style=&apos;color:red;&apos;&gt;&quot;+Licensee+&quot;&lt;/span&gt; - Compare Data bettwen &lt;span style=&apos;color:red;&apos;&gt;&quot;+Report1+&quot;&lt;/span&gt; &amp; &lt;span style=&apos;color:red;&apos;&gt;&quot;+Report2+&quot;&lt;/span&gt;&lt;/div&gt;&quot;);
	file.append (&quot;&lt;div class=&apos;TableBorderStyleDataProperty&apos;&gt;&amp;nbsp;&lt;/div&gt;&quot;);
	file.append (&quot;&lt;div class=&apos;TableBorderStyleHeaderValue&apos;&gt;&quot;+Report1+&quot;&lt;/div&gt;&quot;);
	file.append (&quot;&lt;div class=&apos;TableBorderStyleHeaderValue&apos;&gt;&quot;+Report2+&quot;&lt;/div&gt;&quot;);
	file.append (&quot;&lt;div class=&apos;TableBorderStyleHeaderStatus&apos;&gt;Status&lt;/div&gt;&quot;);
}
def WriteResultToReport(File file,String DataProperty, String value1, String value2, String Result){
	file.append (&quot;&lt;div class=&apos;TableBorderStyleDataProperty&apos;&gt;&quot;+DataProperty+&quot;&lt;/div&gt;&quot;);
	file.append (&quot;&lt;div class=&apos;TableBorderStyleValue&apos;&gt;&quot;+value1+&quot;&lt;/div&gt;&quot;);
	file.append (&quot;&lt;div class=&apos;TableBorderStyleValue&apos;&gt;&quot;+value2+&quot;&lt;/div&gt;&quot;);
	file.append (&quot;&lt;div class=&apos;TableBorderStyleStatus&apos;&gt;&quot;+Result+&quot;&lt;/div&gt;&quot;);
}
String ConvertNegativeDataToZero(String str){
	String string = str;
	if(string.indexOf(&quot;(&quot;)&gt;=0){
		return &quot;0&quot;;
	}
	return string;
}

</stringProp>
