                <stringProp name="script">import com.google.api.services.sheets.v4.model.ValueRange;
import com.google.api.services.sheets.v4.model.BatchUpdateValuesRequest;
/*import javax.xml.xpath.*;
import javax.xml.parsers.DocumentBuilderFactory;*/
import java.util.regex.Matcher;
import java.util.regex.Pattern;


int i = Integer.parseInt(vars.get(&quot;counter&quot;));
String requestToApi = SampleResult.getSamplerData(); 
String responseFromApi = SampleResult.getResponseDataAsString();
String status;
/*if(&quot;${Customer Win Loss}&quot;==&quot;&quot;){
	log.info(&quot;${Customer Win Loss}  &quot;+&quot;${ProductName} william&quot;);	
}*/

//log.info(&quot;${Customer Win Loss}  &quot;+&quot;${ProductName}&quot;);
if (vars.getObject(&quot;sheet&quot;).get(i).size() != 0) {
	/*if(&quot;${ProductName}&quot;==&quot;Sportsbook&quot; 
		|| &quot;${ProductName}&quot;==&quot;Number Game&quot;
		|| &quot;${ProductName}&quot;==&quot;Virtual Sports&quot;
		|| &quot;${ProductName}&quot;==&quot;RNG Casino&quot;
		|| &quot;${ProductName}&quot;==&quot;Keno&quot;
		|| &quot;${ProductName}&quot;==&quot;AG Casino&quot;
		|| &quot;${ProductName}&quot;==&quot;Allbet&quot;
		|| &quot;${ProductName}&quot;==&quot;Macau Games&quot;
		|| &quot;${ProductName}&quot;==&quot;Virtual Sports 2&quot;
		|| &quot;${ProductName}&quot;==&quot;Lottery&quot;
		|| &quot;${ProductName}&quot;==&quot;Exchange&quot;){
		
	}else */
	if(&quot;${ProductName}&quot;==&quot;Gold Deluxe&quot;){/* GOLD DELUXE */
		String CustomerWinLoss = getNotEmptyDataBetween2String(&quot;${Customer Win Loss}&quot;,&quot;${Customer Win Loss - Negative}&quot;);
		String Turnover = &quot;${Turnover}&quot;;
		String Equivalent  = getNotEmptyDataBetween2String(&quot;${Equivalent - GD}&quot;,&quot;${Equivalent - GD - Negative}&quot;);
		String TotalTrans = &quot;${Total Trans}&quot;;
		List&lt;ValueRange&gt; list = Arrays.asList(
           new ValueRange().setRange(&quot;Licensees!I&quot; + (i + 1) + &quot;:L&quot; + (i + 1)).setValues(Arrays.asList(Arrays.asList(Turnover,TotalTrans,CustomerWinLoss,Equivalent)))); 

           vars.getObject(&quot;spreadsheets&quot;).values().batchUpdate(&quot;${glb_LABillingLicensees_GoogleSpreadSheetID}&quot;,
	     new BatchUpdateValuesRequest().setData(list).setValueInputOption(&quot;RAW&quot;))
	     .execute();
	}else if(&quot;${ProductName}&quot;==&quot;Colossus Bets&quot;){/* COLOSSUS BETS */
		String MemberWinning = getNotEmptyDataBetween2String(&quot;${Member Winning}&quot;,&quot;${Member Winning - Negative}&quot;);
		String Turnover = &quot;${Turnover}&quot;;
		String Equivalent  = getNotEmptyDataBetween2String(&quot;${Equivalent - GD}&quot;,&quot;${Equivalent - GD - Negative}&quot;);
		String TotalTrans = &quot;${Total Trans}&quot;;
		String CashoutAmt = &quot;${Cash-out Amt}&quot;;
		String CashoutShare = &quot;${Cash-out Share}&quot;;
		String CommissionShare = &quot;${Commission Share}&quot;;
		List&lt;ValueRange&gt; list = Arrays.asList(
           new ValueRange().setRange(&quot;Licensees!I&quot; + (i + 1) + &quot;:J&quot; + (i + 1)).setValues(Arrays.asList(Arrays.asList(Turnover,TotalTrans))),
           new ValueRange().setRange(&quot;Licensees!L&quot; + (i + 1) + &quot;:P&quot; + (i + 1)).setValues(Arrays.asList(Arrays.asList(Equivalent,MemberWinning,CashoutAmt,CashoutShare,CommissionShare)))
           ); 

           vars.getObject(&quot;spreadsheets&quot;).values().batchUpdate(&quot;${glb_LABillingLicensees_GoogleSpreadSheetID}&quot;,
	     new BatchUpdateValuesRequest().setData(list).setValueInputOption(&quot;RAW&quot;))
	     .execute();
	}else if(&quot;${ProductName}&quot;==&quot;Cash Out&quot;){/* CASH OUT */
		String CashOutTimes = &quot;${Cash Out Times}&quot;;
		String CashOutTickets = &quot;${Cash Out Tickets}&quot;;
		String Equivalent  = getNotEmptyDataBetween2String(&quot;${Equivalent - CashOut}&quot;,&quot;${Equivalent - CashOut - Negative}&quot;);
		String CashOutValue = &quot;${Cash Out Value}&quot;;
		String BuybackAmountTotal = &quot;${Buyback Amount - Total}&quot;;
		String TicketsPayout = &quot;${Tickets Payout}&quot;;
		String CashOutCommission = &quot;${Cash Out Commission}&quot;;
		String AmountDuetoCashOutTicketsPayout = &quot;${Amount Due to Cash Out - Tickets Payout}&quot;;
		String AmountDuetoCashOutBuybackComm = &quot;${Amount Due to Cash Out - Buyback + Comm}&quot;;
		List&lt;ValueRange&gt; list = Arrays.asList(
           new ValueRange().setRange(&quot;Licensees!Q&quot; + (i + 1) + &quot;:X&quot; + (i + 1)).setValues(Arrays.asList(Arrays.asList(CashOutTimes,CashOutTickets,CashOutValue,BuybackAmountTotal,TicketsPayout,CashOutCommission,AmountDuetoCashOutTicketsPayout,AmountDuetoCashOutBuybackComm))),
           new ValueRange().setRange(&quot;Licensees!L&quot; + (i + 1) + &quot;:L&quot; + (i + 1)).setValues(Arrays.asList(Arrays.asList(Equivalent)))           
           ); 

           vars.getObject(&quot;spreadsheets&quot;).values().batchUpdate(&quot;${glb_LABillingLicensees_GoogleSpreadSheetID}&quot;,
	     new BatchUpdateValuesRequest().setData(list).setValueInputOption(&quot;RAW&quot;))
	     .execute();
	}else if(&quot;${ProductName}&quot;==&quot;BA&quot;){/* BA */
		String CustomerWinLossBA = getNotEmptyDataBetween2String(&quot;${Customer Win Loss - BA}&quot;,&quot;${Customer Win Loss - BA - Negative}&quot;);
		String TurnoverBA = &quot;${Turnover - BA}&quot;;
		String AmtDueToBA  = getNotEmptyDataBetween2String(&quot;${Amt Due To BA}&quot;,&quot;${Amt Due To BA - Negative}&quot;);
		String BAComm = &quot;${BA Comm}&quot;;

		List&lt;ValueRange&gt; list = Arrays.asList(
           new ValueRange().setRange(&quot;Licensees!I&quot; + (i + 1) + &quot;:I&quot; + (i + 1)).setValues(Arrays.asList(Arrays.asList(TurnoverBA))),
           new ValueRange().setRange(&quot;Licensees!K&quot; + (i + 1) + &quot;:K&quot; + (i + 1)).setValues(Arrays.asList(Arrays.asList(CustomerWinLossBA))),
           new ValueRange().setRange(&quot;Licensees!AJ&quot; + (i + 1) + &quot;:AK&quot; + (i + 1)).setValues(Arrays.asList(Arrays.asList(BAComm,AmtDueToBA)))
           ); 

           vars.getObject(&quot;spreadsheets&quot;).values().batchUpdate(&quot;${glb_LABillingLicensees_GoogleSpreadSheetID}&quot;,
	     new BatchUpdateValuesRequest().setData(list).setValueInputOption(&quot;RAW&quot;))
	     .execute();
	}else{
		String CustomerWinLoss = getNotEmptyDataBetween2String(&quot;${Customer Win Loss}&quot;,&quot;${Customer Win Loss - Negative}&quot;);
		String Turnover = &quot;${Turnover}&quot;;//removeSpecialCharacters(&quot;${Turnover}&quot;);
		String Equivalent  = getNotEmptyDataBetween2String(&quot;${Equivalent}&quot;,&quot;${Equivalent - Negative}&quot;);//&quot;${EUR equivalent}&quot;;
		String TotalTrans = &quot;${Total Trans}&quot;;
		List&lt;ValueRange&gt; list = Arrays.asList(
           new ValueRange().setRange(&quot;Licensees!I&quot; + (i + 1) + &quot;:L&quot; + (i + 1)).setValues(Arrays.asList(Arrays.asList(Turnover,TotalTrans,CustomerWinLoss,Equivalent))));     
	
		vars.getObject(&quot;spreadsheets&quot;).values().batchUpdate(&quot;${glb_LABillingLicensees_GoogleSpreadSheetID}&quot;,
	                    new BatchUpdateValuesRequest().setData(list).setValueInputOption(&quot;RAW&quot;))
	                    .execute();
	}
}
	


