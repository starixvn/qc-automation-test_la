public String removeSpecialCharacters(String str) { 
   String string = str;//.replaceAll(&quot;(&quot;,&quot;&quot;);
   //string = string.replaceAll(&quot;)&quot;,&quot;&quot;);
   string = string.replaceAll(&quot;,&quot;,&quot;&quot;);
   return string;
}

public String getNotEmptyDataBetween2String(String str1, String str2) { 
   if(str1==&quot;&quot;){
   	return str2;
   }else{
   	return str1;
   }
}
