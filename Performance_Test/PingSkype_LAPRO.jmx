          <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="JSR223 Sampler - Generate Content" enabled="true">
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="cacheKey"></stringProp>
            <stringProp name="script">if(${__property(fFailed)}.toString() == &quot;1&quot;){
	vars.put(&quot;Content&quot;,
		&quot;Hi all, Automation Test [${glb_ContentSkype}] is failed\n&quot;);
}
if(${__property(fFailed)}.toString() == &quot;0&quot;){
	vars.put(&quot;Content&quot;,
		&quot;Hi all, Automation Test [${glb_ContentSkype}] is successful\n&quot;);
}

</stringProp>
          </JSR223Sampler>
          <hashTree/>
