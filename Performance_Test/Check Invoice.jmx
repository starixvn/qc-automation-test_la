	String Adj_TotalP = vars.get(&quot;Adj_Total&quot;);
	String Adj_TotalN = vars.get(&quot;Adj_Total - Negative&quot;);
	String Adj_Total = getNotEmptyDataBetween2String(&quot;${Adj_TotalP}&quot;,&quot;${Adj_TotalN}&quot;);

String getNotEmptyDataBetween2String(String str1, String str2) { 
   if(str1==&quot;&quot;){
   	return str2;
   }else{
   	return str1;
   }
}
	def Licensee = vars.get(&quot;Licensee&quot;);
	log.info Licensee + &quot; Reconciliation Adj_Total: &quot;+ Adj_Total

//////Get Index of Google Sheet Data Row that need to compare with
	int DataRowIndex = 0;
