          <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="Get Setting From Google SpreadSheet" enabled="true">
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="cacheKey"></stringProp>
            <stringProp name="script">import com.google.api.services.sheets.v4.model.ValueRange;
import com.google.api.services.sheets.v4.model.BatchUpdateValuesRequest;

int i = Integer.parseInt(vars.get(&quot;counter&quot;));
log.info(&quot;winston : &quot;+i.toString());
vars.put(&quot;GoogleSheetHeader&quot;, vars.getObject(&quot;sheet&quot;).get(0).toString());

if(vars.getObject(&quot;sheet&quot;).get(i).size() != 0) {	
     vars.put(&quot;Report&quot;, vars.getObject(&quot;sheet&quot;).get(i).get(0).toString());
     vars.put(&quot;Licensee&quot;, vars.getObject(&quot;sheet&quot;).get(i).get(1).toString());
     vars.put(&quot;PartyId&quot;, vars.getObject(&quot;sheet&quot;).get(i).get(2).toString());
	vars.put(&quot;FromDay&quot;, vars.getObject(&quot;sheet&quot;).get(i).get(3).toString());
     vars.put(&quot;ToDay&quot;, vars.getObject(&quot;sheet&quot;).get(i).get(4).toString());
     vars.put(&quot;Month&quot;, vars.getObject(&quot;sheet&quot;).get(i).get(5).toString());
     vars.put(&quot;Year&quot;, vars.getObject(&quot;sheet&quot;).get(i).get(6).toString());
     vars.put(&quot;InvoiceTypeShorten&quot;, vars.getObject(&quot;sheet&quot;).get(i).get(7).toString());
     vars.put(&quot;InvoiceTypeId&quot;, vars.getObject(&quot;sheet&quot;).get(i).get(8).toString());
     vars.put(&quot;BaseCurrencyName&quot;, vars.getObject(&quot;sheet&quot;).get(i).get(10).toString());
     vars.put(&quot;BaseCurrency&quot;, vars.getObject(&quot;sheet&quot;).get(i).get(11).toString());
	vars.put(&quot;BillingCycle&quot;, vars.getObject(&quot;sheet&quot;).get(i).get(12).toString());
}


/*
	List&lt;ValueRange&gt; list = Arrays.asList(
      new ValueRange().setRange(&quot;Licensees!BO&quot;).setValues(Arrays.asList(Arrays.asList(&quot;TRUE&quot;)))
      );     

	vars.getObject(&quot;spreadsheets&quot;).values().batchUpdate(&quot;${glb_LABillingLicensees_GoogleSpreadSheetID}&quot;,
                    new BatchUpdateValuesRequest().setData(list).setValueInputOption(&quot;RAW&quot;))
                    .execute();
