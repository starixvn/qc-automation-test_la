                <stringProp name="script">import com.google.api.services.sheets.v4.model.ValueRange;
import com.google.api.services.sheets.v4.model.BatchUpdateValuesRequest;
import java.util.regex.Matcher;
import java.util.regex.Pattern;
import java.nio.file.Files;
import java.nio.file.Paths;

import org.apache.jmeter.services.FileServer;

def path = FileServer.getFileServer().getBaseDir();
/*Load Common Functions - Start*/
ClassLoader parent = getClass().getClassLoader();
GroovyClassLoader loader = new GroovyClassLoader(parent);
Class groovyClass = loader.parseClass(new File(path + &quot;/&quot;+&quot;Functions.groovy&quot;));
GroovyObject Functions  = (GroovyObject) groovyClass.newInstance();
/*Load Common Functions - End*/

//////Get data from Web
	String Total_Individual_Invoice_Fee = vars.get(&quot;Total_Individual_Invoice_Fee&quot;);

	String getNotEmptyDataBetween2String(String str1, String str2) { 
	   if(str1==&quot;&quot;){
	   	return str2;
	   }else{
	   	return str1;
	   }
	}
	def Licensee = vars.get(&quot;Licensee&quot;);
	log.info Licensee + &quot; Total_Individual_Invoice_Fee: &quot;+ Total_Individual_Invoice_Fee
	
//////Get Index of Google Sheet Data Row that need to compare with
	int DataRowIndex = 0;
	String strCompareDataWithReport = &quot;Individual Invoice Software Fee, ${Licensee}, ${PartyId}&quot;;
	for(int j = 0;j&lt;vars.getObject(&quot;sheet&quot;).size();j++) {
		String RowData = vars.getObject(&quot;sheet&quot;).get(j).toString();
		if(RowData.indexOf(strCompareDataWithReport)&gt;=1){
			DataRowIndex = j;
			log.info(strCompareDataWithReport+&quot;: -&gt; &quot;+j.toString());
			break;
		}
      }
//	log.info &quot;RowData: &quot; + RowData.toString();
	////Get Data from Google Sheet
      if(DataRowIndex&gt;0){
      	String GSheet_TotalFee	= vars.getObject(&quot;sheet&quot;).get(DataRowIndex).get(9).toString();

	////Compare data between Google Sheet and Web
	def FailureMessage =&quot;&quot;
		if(Math.abs(Functions.ConvertStringToFloat(GSheet_TotalFee) - Functions.ConvertStringToFloat(Total_Individual_Invoice_Fee))&gt;0.1){
			FailureMessage+=&quot;\nTotal Fee on Google Sheet: &quot;+GSheet_TotalFee +&quot;\nTotal Individual Invoice Fee on Report: &quot;+Total_Individual_Invoice_Fee;
		}
		if(FailureMessage!=&quot;&quot;){
			AssertionResult.setFailure(true);
			AssertionResult.setFailureMessage(FailureMessage);
		}
	}
</stringProp>
