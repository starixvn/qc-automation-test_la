        <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="Connect Google SpreadSheet" enabled="true">
          <stringProp name="scriptLanguage">groovy</stringProp>
          <stringProp name="parameters"></stringProp>
          <stringProp name="filename"></stringProp>
          <stringProp name="cacheKey"></stringProp>
          <stringProp name="script">import com.google.api.client.auth.oauth2.Credential;
import com.google.api.client.googleapis.auth.oauth2.GoogleCredential;
import com.google.api.services.sheets.v4.SheetsScopes;
import com.google.api.client.googleapis.javanet.GoogleNetHttpTransport;
import com.google.api.client.json.jackson2.JacksonFactory;
import com.google.api.services.sheets.v4.Sheets;
import com.google.api.services.sheets.v4.SheetsRequestInitializer;


import java.nio.file.Files;
import java.nio.file.Paths;
import java.util.Arrays;
import java.util.List;

import org.apache.jmeter.services.FileServer;

def path = FileServer.getFileServer().getBaseDir();

log.info(Paths.get(path+&quot;/client_secret.json&quot;).toString())
GoogleCredential credential = GoogleCredential.fromStream(Files.newInputStream(Paths.get(path+&quot;/client_secret.json&quot;))).createScoped(Arrays.asList(SheetsScopes.DRIVE));

Sheets.Spreadsheets spreadsheets = new Sheets.Builder(GoogleNetHttpTransport.newTrustedTransport(),JacksonFactory.getDefaultInstance(),credential).setApplicationName(&quot; &quot;).build().spreadsheets();
                    
vars.putObject(&quot;spreadsheets&quot;, spreadsheets);

List&lt;List&lt;Object&gt;&gt; sheet = spreadsheets.values().get(&quot;${glb_LABillingLicensees_GoogleSpreadSheetID}&quot;, &quot;Invoice&quot;).setMajorDimension(&quot;ROWS&quot;).setValueRenderOption(&quot;UNFORMATTED_VALUE&quot;).setDateTimeRenderOption(&quot;FORMATTED_STRING&quot;).execute().getValues();  

                                    
vars.putObject(&quot;sheet&quot;, sheet);
//log.info(&quot;william --- &quot;+vars.getObject(&quot;sheet&quot;).get(0).toString());



/*String[] str;
str = vars.getObject(&quot;sheet&quot;).get(0).toString().split(&apos;,&apos;);
for( String values : str )
      log.info(&quot;william --- &quot;+values);
*/</stringProp>
        </JSR223Sampler>
