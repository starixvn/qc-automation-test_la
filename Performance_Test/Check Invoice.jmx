def path = FileServer.getFileServer().getBaseDir();
/*Load Common Functions - Start*/
ClassLoader parent = getClass().getClassLoader();
GroovyClassLoader loader = new GroovyClassLoader(parent);
Class groovyClassUtilities = loader.parseClass(new File(path + &quot;/Library/&quot;+&quot;Utilities.groovy&quot;));
GroovyObject Utilities  = (GroovyObject) groovyClassUtilities.newInstance();
Class groovyClass = loader.parseClass(new File(path + &quot;/&quot;+&quot;Functions.groovy&quot;));
GroovyObject Functions  = (GroovyObject) groovyClass.newInstance();
/*Load Common Functions - End*/


//////Get data from Web
def data =prev.getResponseDataAsString()
def GrandTotal =[]
def ProductList = []

	def GrandTotal_Total = &apos;0&apos;
	
for (def i=3; i&lt;50; i++)
{
		ProductList.add(Utilities.processXml(data,&apos;//tr[@class=\&apos;laTable__row\&apos;]/td[&apos;+ i +&apos;]&apos;))
		GrandTotal.add(Utilities.processXml(data,&apos;//td[contains(text(),\&apos;Grand Total\&apos;)]/following::td[&apos; + (i-2) + &apos;]/span&apos;))
}

for(def i=0;i&lt;ProductList.size();i++){
	if(ProductList.get(i).toString()==&apos;Total&apos;){
		GrandTotal_Total = (GrandTotal.get(i).toString())
	}					
}
	def Licensee = vars.get(&quot;Licensee&quot;);
	log.info Licensee + &quot; Billing Data GrandTotal_Total: &quot;+ GrandTotal_Total
	
//////Get Index of Google Sheet Data Row that need to compare with
	int DataRowIndex = 0;
	String strCompareDataWithReport = &quot;Billing Data, ${Licensee}, ${PartyId}&quot;;
	for(int j = 0;j&lt;vars.getObject(&quot;sheet&quot;).size();j++) {
		String RowData = vars.getObject(&quot;sheet&quot;).get(j).toString();
		if(RowData.indexOf(strCompareDataWithReport)&gt;=1){
			DataRowIndex = j;
			log.info(strCompareDataWithReport+&quot;: -&gt; &quot;+j.toString());
			break;
		}
      }

	////Get Data from Google Sheet
      if(DataRowIndex&gt;0){
      	String GSheet_TotalFee	= vars.getObject(&quot;sheet&quot;).get(DataRowIndex).get(9).toString();	

	////Compare data between Google Sheet and Web
	def FailureMessage =&quot;&quot;
		if(Math.abs(Functions.ConvertStringToFloat(GSheet_TotalFee) - Functions.ConvertStringToFloat(GrandTotal_Total))&gt;0.1){
			FailureMessage+=&quot;\nTotal Licensing Fee of Google Sheet: &quot;+GSheet_TotalFee +&quot;\nTotal Licensing Fee of Report: &quot;+GrandTotal_Total;
		}
		if(FailureMessage!=&quot;&quot;){
			AssertionResult.setFailure(true);
			AssertionResult.setFailureMessage(FailureMessage);
		}
      }</stringProp>
